#!/usr/bin/env bash
# aios-tracked-hook: pre-push — machine-local chain + docs-drift + skill-sync guards.
#
# Enabled via core.hooksPath=.githooks, set automatically by `npm install` (the
# package.json "prepare" script). The brain repo is private on a free org plan, so
# GitHub-side branch protection isn't available; this is the local enforcement of the
# same `Docs drift guard` check that CI runs advisorily on every PR.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# ── Machine-local chain (see .githooks/README.md) ──────────────────────────
# core.hooksPath points git at this tracked dir, so `.git/hooks/` is IGNORED —
# the machine-local pre-push installed there (on NDA-configured machines: the
# NDA leak-gate `tree` scan) only runs because we chain it here. It runs FIRST
# so the confidentiality gate can never be masked by a drift failure. Missing/
# non-executable = skipped (contributors without the private NDA term list).
#
# THAT SKIP IS WHY A CLIENT NAME REACHED THIS PUBLIC REPO (#586, AIO-984). It is still the right
# behaviour here — a contributor without the private list must not be blocked — but it meant the
# confidentiality gate existed on exactly one laptop, and whether a name leaked depended on whose
# machine ran `git push`. The backstop is now CI: the `NDA confidentiality gate` job in
# .github/workflows/ci.yml runs scripts/nda-scan.mjs against the `NDA_TERMS` secret, so a push from
# an unconfigured machine is caught server-side. Do not treat this local hook as THE gate; it is the
# fast local signal, CI is the gate.
# Resolve via --git-common-dir, NOT --git-path (which honors core.hooksPath and
# would resolve back into .githooks/); skip anything carrying our own marker.
common_dir="$(git rev-parse --git-common-dir)"
if [ "${common_dir#/}" = "$common_dir" ]; then
  common_dir="$(cd "$common_dir" && pwd -P)"
fi
local_hook="$common_dir/hooks/pre-push"
if [ -x "$local_hook" ] && ! grep -q "^# aios-tracked-hook" "$local_hook" 2>/dev/null; then
  echo "pre-push: running machine-local hook…"
  if ! "$local_hook" "$@"; then
    echo "" >&2
    echo "pre-push: BLOCKED by the machine-local hook: $local_hook" >&2
    exit 1
  fi
fi
guard="$repo_root/scripts/check-docs-drift.mjs"

if [ -f "$guard" ]; then
  echo "pre-push: checking docs drift…"
  if ! node "$guard"; then
    echo "" >&2
    echo "pre-push: BLOCKED — docs drift detected." >&2
    echo "  Update the drift inventories in docs/ARCHITECTURE.md, then re-run: npm run check:docs" >&2
    echo "  (To bypass in an emergency: git push --no-verify)" >&2
    exit 1
  fi
fi

# Same idea for agent skills: .claude/skills/<name>/SKILL.md is the source of truth, and
# the .agents/.opencode/.cursor copies are generated. An edit that forgets to re-sync
# leaves the other runtimes on a stale playbook. Also guarded in CI by
# test/guards/skill-runtime-sync.test.ts; this is the fast local signal.
skill_sync="$repo_root/scripts/sync-skill-runtimes.sh"

if [ -f "$skill_sync" ]; then
  echo "pre-push: checking skill runtime sync…"
  if ! bash "$skill_sync" --check; then
    echo "" >&2
    echo "pre-push: BLOCKED — generated skill copies are out of sync with .claude/skills." >&2
    echo "  Fix with: npm run check:skills:fix   (and bash scripts/sync-skill-runtimes.sh --prune for orphans)" >&2
    echo "  (To bypass in an emergency: git push --no-verify)" >&2
    exit 1
  fi
fi
exit 0
