# Names only. Provision values in the staging-local runner; never commit them here.
#
# Every name below is READ by scripts/staging-ops/importer.mjs, its role preflight
# (assertRunnerRole, assertOutboundCredentialIsolation) or its ACTION preflight
# (scripts/staging-ops/action-preflight.mjs). The action preflight is why the origin, health token
# and tester credentials appear here as first-class prerequisites rather than as things discovered
# halfway through a restore.
#
# This role NEVER receives a production database endpoint. That is enforced, not documented:
# assertRunnerRole refuses PRODUCTION_DATABASE_URL / PRODUCTION_NEO4J_URL here.

# ── Role and pinned runner identity ────────────────────────────────────────────
STAGING_OPS_ROLE=importer
STAGING_OPS_IMAGE_DIGEST=
STAGING_IMPORTER_SERVICE_ID=
STAGING_IMPORTER_IMAGE_DIGEST=
# Set only for the local two-environment harness; unset on Railway.
# STAGING_MAINTENANCE_ADAPTER=local
# LOCAL_MAINTENANCE_URL=

# ── Pinned staging platform identity ───────────────────────────────────────────
STAGING_OPS_ENVIRONMENT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PROJECT_ID=
STAGING_APP_SERVICE_ID=
STAGING_GRAPHITI_SERVICE_ID=
STAGING_NEO4J_SERVICE_NAME=
STAGING_NEO4J_DATABASE=
RAILWAY_STAGING_MAINTENANCE_TOKEN=

# ── Staging-local targets ──────────────────────────────────────────────────────
DATABASE_URL=
NEO4J_URL=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── Source bundle prefix (read-only) ───────────────────────────────────────────
STAGING_OBJECT_STORE=s3
SOURCE_S3_ENDPOINT=
SOURCE_S3_REGION=us-east-1
SOURCE_S3_BUCKET=
SOURCE_S3_PREFIX=source
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=

# ── Importer-owned rollback store (read/write/delete, staging-private) ─────────
ROLLBACK_S3_ENDPOINT=
ROLLBACK_S3_REGION=us-east-1
ROLLBACK_S3_BUCKET=
ROLLBACK_S3_PREFIX=rollback
ROLLBACK_S3_ACCESS_KEY_ID=
ROLLBACK_S3_SECRET_ACCESS_KEY=

# ── Bundle verification / rollback sealing / credential comparison ─────────────
EXPORTER_SIGNING_PUBLIC_KEY_FILE=
IMPORTER_ENCRYPTION_PRIVATE_KEY_FILE=
ROLLBACK_SIGNING_PRIVATE_KEY_FILE=
ROLLBACK_SIGNING_PUBLIC_KEY_FILE=
ROLLBACK_ENCRYPTION_PUBLIC_KEY_FILE=
ROLLBACK_ENCRYPTION_PRIVATE_KEY_FILE=
STAGING_COMPARISON_KEY_BASE64=
STAGING_COMPARISON_KEY_ID=

# ── Action prerequisites, validated BEFORE anything drains (action-preflight) ──
# HTTPS origin, no embedded credentials; health token at least 32 characters.
STAGING_ORIGIN=
STAGING_HEALTH_TOKEN=
# A non-empty array of {email, password, teamId, memberId, role, posture} objects.
# Required by every action that can restore a pair (install / tick / daemon / rollback).
STAGING_TESTER_CREDENTIALS_JSON=
# Required only by actions that read the staging branch head (install / tick / daemon).
STAGING_GITHUB_READ_TOKEN=
GITHUB_REPOSITORY=

# ── One-time bootstrap: the mode staging is MEASURED to be running in today ────
STAGING_BOOTSTRAP_MODE=legacy-pg-only

# ── Fingerprinted (never transmitted) staging secrets ──────────────────────────
AUTH_SECRET=
SECRETS_KEY=

# ── Bounds ─────────────────────────────────────────────────────────────────────
STAGING_IMPORTER_POLL_MS=300000
STAGING_CATCHUP_MAX_ATTEMPTS=5
STAGING_DATA_LOCK_TIMEOUT_MS=60000
STAGING_BUNDLE_MAX_BYTES=536870912
STAGING_OBJECT_TIMEOUT_MS=30000
