# Names only. Provision values in the production-local runner; never commit them here.
#
# Every name below is READ by scripts/staging-ops/exporter.mjs or one of its startup checks
# (assertRunnerRole, assertOutboundCredentialIsolation, RailwayRunnerInspector, the build-metadata
# read). An incomplete example is not a smaller example — it is a runner that fails after it has
# already opened a production snapshot.
#
# This role NEVER receives a staging database endpoint or a staging graph credential. That is
# enforced, not documented: assertRunnerRole refuses STAGING_DATABASE_URL / STAGING_NEO4J_URL here.

# ── Role and pinned runner identity ────────────────────────────────────────────
STAGING_OPS_ROLE=exporter
STAGING_OPS_IMAGE_DIGEST=
# Set only for the local two-environment harness; unset on Railway.
# STAGING_MAINTENANCE_ADAPTER=local

# ── Railway identity the inspector verifies before any read ────────────────────
RAILWAY_PROJECT_ID=
PRODUCTION_EXPORT_ENVIRONMENT_ID=
RAILWAY_ENVIRONMENT_ID=
# The exporter's OWN service — checked for the pinned digest and disabled autodeploy.
PRODUCTION_EXPORTER_SERVICE_ID=
PRODUCTION_EXPORTER_DEPLOYMENT_ID=
PRODUCTION_EXPORTER_IMAGE_DIGEST=
# The production APP service — its successful deployment supplies the measured source commit.
PRODUCTION_APP_SERVICE_ID=
PRODUCTION_APP_DEPLOYMENT_ID=
PRODUCTION_POSTGRES_DEPLOYMENT_ID=
PRODUCTION_NEO4J_DEPLOYMENT_ID=
RAILWAY_PRODUCTION_RUNNER_READ_TOKEN=
# H5 activation-evidence only: production-local environment-scoped read token. Never provision this
# token to the importer. It is authenticated before fixed deployment/configuration reads.
RAILWAY_PRODUCTION_ACTIVATION_READ_TOKEN=
STAGING_TOPOLOGY_FILE=config/staging-ops/topology.json
GITHUB_REPOSITORY=

# ── Deployed build identity (declared migration set for the measured commit) ────
SOURCE_BUILD_METADATA_URL=
SOURCE_BUILD_METADATA_TOKEN=
# Local-harness only: stands in for the measured deployment commit.
# SOURCE_APPLICATION_COMMIT=

# ── Production-local data sources (read-only) ──────────────────────────────────
DATABASE_URL=
NEO4J_URL=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── Private bundle publication (write-only to its own prefix) ──────────────────
STAGING_OBJECT_STORE=s3
SOURCE_S3_ENDPOINT=
SOURCE_S3_REGION=us-east-1
SOURCE_S3_BUCKET=
SOURCE_S3_PREFIX=source
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=

# ── Bundle signing / sealing / credential comparison ───────────────────────────
EXPORTER_SIGNING_PRIVATE_KEY_FILE=
IMPORTER_ENCRYPTION_PUBLIC_KEY_FILE=
STAGING_COMPARISON_KEY_BASE64=
STAGING_COMPARISON_KEY_ID=

# ── Data-export action only: fingerprinted (never transmitted) runner inputs ───
# The activation-evidence action reads deployment snapshots and does not inherit these app values.
AUTH_SECRET=
SECRETS_KEY=

# ── Bounds ─────────────────────────────────────────────────────────────────────
STAGING_EXPORT_RETENTION_DAYS=14
STAGING_BUNDLE_MAX_BYTES=536870912
STAGING_OBJECT_TIMEOUT_MS=30000
