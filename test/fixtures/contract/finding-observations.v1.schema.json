{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:finding-observations:v1",
  "title": "Finding observations v1 \u2014 structural validation; semantic checks also required",
  "oneOf": [
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/run_summary"
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "finding-observations.v1"
          ]
        },
        "visibility_tier": {
          "enum": [
            "team"
          ]
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "producer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$(?![\\s\\S])"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "name",
            "version",
            "run_id"
          ],
          "additionalProperties": false
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "evidence_status": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "attribution": {
          "type": "object",
          "properties": {
            "program_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "issue": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "linear"
                      ]
                    },
                    "team": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]{1,9}$(?![\\s\\S])"
                    },
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "type",
                    "team",
                    "number"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "program_id",
            "run_id",
            "attempt",
            "issue"
          ],
          "additionalProperties": false
        },
        "record_type": {
          "enum": [
            "candidate"
          ]
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "identity": {
          "type": "object",
          "properties": {
            "version": {
              "enum": [
                "discovery.v1"
              ]
            },
            "producer_namespace": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
            },
            "original_run_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "source_artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "source_record_key": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "structural_sha256"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "position"
                      ]
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "version",
            "producer_namespace",
            "original_run_id",
            "source_artifact_sha256",
            "source_record_key"
          ],
          "additionalProperties": false
        },
        "codebases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "taxonomy": {
          "type": "object",
          "properties": {
            "severity": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "defect_class": {
              "enum": [
                "logic",
                "security",
                "gate-integrity",
                "test-integrity",
                "verifiability",
                "contract-drift",
                "docs",
                "perf",
                "unknown"
              ]
            },
            "determinism": {
              "enum": [
                "deterministic",
                "flaky",
                "unverified",
                "unknown"
              ]
            },
            "fences": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "migration",
                  "credential",
                  "schema",
                  "public-api",
                  "release",
                  "unknown"
                ]
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            }
          },
          "required": [
            "severity",
            "defect_class",
            "determinism",
            "fences"
          ],
          "additionalProperties": false
        },
        "state": {
          "enum": [
            "discovered",
            "verified",
            "duplicate",
            "rejected",
            "filed",
            "queue_eligible",
            "selected",
            "remediation_started",
            "merged",
            "resolved",
            "escaped",
            "reopened",
            "incomplete"
          ]
        },
        "disposition": {
          "enum": [
            "open",
            "duplicate",
            "rejected",
            "resolved",
            "unknown"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "predecessor_event_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "duplicate_target": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "object",
          "properties": {
            "linear": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "linear"
                      ]
                    },
                    "team": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]{1,9}$(?![\\s\\S])"
                    },
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "type",
                    "team",
                    "number"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "scanner": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "scanner"
                      ]
                    },
                    "producer": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
                    },
                    "finding_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "type",
                    "producer",
                    "finding_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "pull_request": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "pull_request"
                      ]
                    },
                    "codebase": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
                    },
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "type",
                    "codebase",
                    "number"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "merge": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "merge"
                      ]
                    },
                    "codebase": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
                    },
                    "sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "type",
                    "codebase",
                    "sha"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "resolution"
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "type",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "linear",
            "scanner",
            "pull_request",
            "merge",
            "resolution"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "visibility_tier",
        "event_id",
        "producer",
        "observed_at",
        "evidence_status",
        "attribution",
        "record_type",
        "candidate_id",
        "identity",
        "codebases",
        "taxonomy",
        "state",
        "disposition",
        "sequence",
        "predecessor_event_id",
        "episode",
        "duplicate_target",
        "links"
      ],
      "additionalProperties": false
    },
    "run_summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "finding-observations.v1"
          ]
        },
        "visibility_tier": {
          "enum": [
            "team"
          ]
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "producer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$(?![\\s\\S])"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "name",
            "version",
            "run_id"
          ],
          "additionalProperties": false
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "evidence_status": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "attribution": {
          "type": "object",
          "properties": {
            "program_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "issue": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "linear"
                      ]
                    },
                    "team": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]{1,9}$(?![\\s\\S])"
                    },
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "type",
                    "team",
                    "number"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "program_id",
            "run_id",
            "attempt",
            "issue"
          ],
          "additionalProperties": false
        },
        "record_type": {
          "enum": [
            "run_summary"
          ]
        },
        "stage": {
          "enum": [
            "discovery",
            "filing",
            "remediation",
            "resolution"
          ]
        },
        "capture_status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "detector_completed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "detector_evidence_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "raw_candidates": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "emitted_candidates": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "terminal_stage": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "incomplete": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            },
            "malformed": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "raw_candidates",
            "emitted_candidates",
            "terminal_stage",
            "incomplete",
            "malformed"
          ],
          "additionalProperties": false
        },
        "emission_gap_reason": {
          "enum": [
            "none",
            "malformed",
            "unknown"
          ]
        }
      },
      "required": [
        "schema_version",
        "visibility_tier",
        "event_id",
        "producer",
        "observed_at",
        "evidence_status",
        "attribution",
        "record_type",
        "stage",
        "capture_status",
        "detector_completed",
        "detector_evidence_sha256",
        "counts",
        "emission_gap_reason"
      ],
      "additionalProperties": false
    }
  }
}
