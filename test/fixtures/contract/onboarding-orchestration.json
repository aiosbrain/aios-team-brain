{
  "version": 3,
  "inspection": {
    "command": "aios onboard --inspect --json",
    "dependencyFree": true,
    "readOnly": true
  },
  "paths": [
    "Personal",
    "Join",
    "Create"
  ],
  "upgrade": {
    "previewCommand": "aios update --preview",
    "previewIncludesSafetyCheck": true,
    "applyRequiresHumanApproval": true,
    "refuseDirtyOrDivergedToolkit": true
  },
  "join": {
    "canonicalOriginRequiresHumanApproval": true,
    "teamIdentitySource": "api_key",
    "teamIdRequired": false,
    "validationRequest": "GET /api/v1/me"
  },
  "create": {
    "mode": "railway-template",
    "provider": "railway",
    "deployUrl": "https://aiosbrain.dev/deploy/team-brain/",
    "prerequisites": {
      "activeRailwayPlan": true,
      "plansUrl": "https://railway.com/workspace/plans"
    },
    "guide": "https://aiosbrain.dev/guides/team-brain/",
    "resume": {
      "required": [
        "brainUrl",
        "apiKey"
      ],
      "validationRequest": "GET /api/v1/me"
    }
  },
  "sharing": {
    "pushDuringOnboarding": false
  },
  "requiredMarkers": [
    "Inspect before installing.",
    "Explain what you found.",
    "Personal / Join / Create",
    "repair or upgrade",
    "`aios update --preview` includes the safety check",
    "canonical Brain origin",
    "human gate",
    "API key is authoritative for team identity",
    "`team_id` is optional",
    "GET /api/v1/me",
    "Create deploys through the official Railway template",
    "active Railway plan",
    "Never run `aios push`",
    "What AIOS now understands.",
    "What stays private.",
    "What can be shared.",
    "Your best next step."
  ],
  "forbiddenMarkers": [
    "aios update --check",
    "team_id is required"
  ]
}
