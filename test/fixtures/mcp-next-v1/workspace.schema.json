{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aios:mcp-next:1:workspace",
  "title": "Reserved bounded workspace contracts 1.0.0",
  "definitions": {
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "enum": [
            "PROFILE_REQUIRED",
            "PROFILE_NOT_FOUND",
            "PROFILE_CHANGED",
            "CAPABILITY_DENIED",
            "READ_ONLY",
            "DESTINATION_MISMATCH",
            "PATH_DENIED",
            "CONTENT_CONFLICT",
            "INVALID_CONTENT",
            "LIMIT_EXCEEDED",
            "PLAN_NOT_FOUND",
            "PLAN_EXPIRED",
            "PLAN_STALE",
            "AUTH_REVOKED",
            "UPGRADE_REQUIRED",
            "UNAVAILABLE",
            "OPERATION_NOT_FOUND",
            "IDEMPOTENCY_CONFLICT"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recovery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "code",
        "message",
        "recovery",
        "retryable"
      ]
    },
    "StatusInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      },
      "required": [
        "profileId"
      ]
    },
    "StatusOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "profileId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "mode": {
              "enum": [
                "brain-only",
                "workspace"
              ]
            },
            "root": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^(?:/[^\\x00]*|[A-Za-z]:\\\\[^\\x00]*|\\\\\\\\[^\\\\]+\\\\[^\\\\]+(?:\\\\[^\\x00]*)?)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "brainOrigin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "teamId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "credentialSourceClass": {
              "enum": [
                "env",
                "keychain"
              ]
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "grants": {
              "$ref": "urn:aios:mcp-next:1:profile#/definitions/Grants"
            },
            "effectiveGrants": {
              "$ref": "urn:aios:mcp-next:1:profile#/definitions/Grants"
            },
            "readOnly": {
              "type": "boolean"
            },
            "identityVerified": {
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "profileId",
            "mode",
            "root",
            "brainOrigin",
            "teamId",
            "projectId",
            "credentialSourceClass",
            "generation",
            "grants",
            "effectiveGrants",
            "readOnly",
            "identityVerified"
          ]
        },
        {
          "$ref": "urn:aios:mcp-next:1:workspace#/definitions/Error"
        }
      ]
    },
    "ListInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profileId",
        "path"
      ]
    },
    "ListOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
                  },
                  "kind": {
                    "enum": [
                      "file",
                      "directory"
                    ]
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  }
                },
                "required": [
                  "path",
                  "kind",
                  "sizeBytes"
                ]
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ok",
            "entries",
            "nextCursor"
          ]
        },
        {
          "$ref": "urn:aios:mcp-next:1:workspace#/definitions/Error"
        }
      ]
    },
    "ReadInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
        }
      },
      "required": [
        "profileId",
        "path"
      ]
    },
    "ReadOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
            },
            "content": {
              "type": "string",
              "maxLength": 262144
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "access": {
              "enum": [
                "admin",
                "team",
                "external"
              ]
            }
          },
          "required": [
            "ok",
            "path",
            "content",
            "hash",
            "sizeBytes",
            "access"
          ]
        },
        {
          "$ref": "urn:aios:mcp-next:1:workspace#/definitions/Error"
        }
      ]
    },
    "WriteInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
        },
        "expectedHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        },
        "access": {
          "enum": [
            "admin",
            "team",
            "external"
          ]
        }
      },
      "required": [
        "profileId",
        "path",
        "expectedHash",
        "content",
        "access"
      ]
    },
    "WriteOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\x00])(?!.*//)(?!.*\\/$).+$"
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "path",
            "hash",
            "sizeBytes",
            "created"
          ]
        },
        {
          "$ref": "urn:aios:mcp-next:1:workspace#/definitions/Error"
        }
      ]
    },
    "CollectInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
