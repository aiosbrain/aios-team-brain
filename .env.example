# ── Postgres database (required) ─────────────────────────────────────────────
# A standard Postgres connection string (the brain's only backend; Railway in prod).
# Load the schema with `npm run pg:schema`. Auth is a signed session cookie.
DATABASE_URL=
# PGSSL=require        # set for managed providers that require TLS (e.g. Railway)
AUTH_SECRET=           # secret (>=16 chars) for signing the auth session cookie
APP_URL=               # absolute base URL (e.g. https://...railway.app) — required for
                       # invite/magic links built in server actions (no request origin there)
# AES-256-GCM key encrypting connector tokens at rest. REQUIRED the moment you save any
# connector in Admin -> Integrations (it THROWS, so the save 500s without it). Must decode to
# exactly 32 bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# ── Transactional email (magic links + invites). Preference: Resend → SMTP → dev-log.
RESEND_API_KEY=        # Resend API key (preferred sender)
RESEND_FROM=           # verified-domain from-address, e.g. "AIOS Team Brain <noreply@yourdomain>"
                       # (Resend's onboarding@resend.dev only delivers to the account owner)
SMTP_URL=              # fallback transport if no Resend key, e.g. smtp://user:pass@host:587
SMTP_FROM=             # fallback from-address

# ── LLM provider: CLOUD (default) ────────────────────────────────────────────
# Leave LLM_BASE_URL unset to answer queries with the Anthropic cloud API.
ANTHROPIC_API_KEY=

# ── LLM provider: LOCAL (optional) ───────────────────────────────────────────
# Set LLM_BASE_URL to stream answers from a local OpenAI-compatible endpoint
# (Ollama, Hermes, llama.cpp, LM Studio) instead of Anthropic. Cost is $0.
# When set, ANTHROPIC_API_KEY is ignored. See docs/PROVIDERS.md.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1-8b-64k:latest          # any model your endpoint serves
# OPENAI_API_KEY=local                       # placeholder; most local servers ignore it

# ── Retrieval reranker (optional, local or cloud) ────────────────────────────
# Reorders retrieved sources by cross-encoder relevance before the LLM sees
# them. Local default = a llama-server --reranking instance (Qwen3-Reranker).
# Point at a hosted endpoint (Cohere/Voyage/ZeroEntropy wire shape) for cloud.
# Unset = keep Postgres ranking order.
# RERANK_URL=http://localhost:8081/v1/rerank
# RERANK_MODEL=qwen3-reranker-0.6b
# RERANK_TOKEN=                              # bearer token for hosted rerankers
# RERANK_TIMEOUT_MS=4000

# ── External retrieval augmentation (optional, advanced) ─────────────────────
# Merge extra sources from an external retrieval service (e.g. a GBrain adapter
# or a cloud retrieval API). Contract: POST {query,limit,tier} -> {sources:[...]}.
# Unset = Postgres-only retrieval. See docs/PROVIDERS.md.
# RETRIEVAL_AUGMENT_URL=http://localhost:8791/retrieve
# RETRIEVAL_AUGMENT_TOKEN=
# RETRIEVAL_AUGMENT_LIMIT=6
# RETRIEVAL_AUGMENT_TIMEOUT_MS=3000

# ── Semantic search / embeddings (optional) ──────────────────────────────────
# Dense retrieval is OFF unless BOTH the pgvector schema is loaded
# (`npm run pg:schema:vector`) AND a backend resolves here or per-team in
# Admin -> Integrations -> Embeddings model. Without it, retrieval degrades
# silently to keyword FTS + structured context — no error, just lower recall.
# The vector column is hardcoded vector(1536): to use another dimension you must
# edit postgres/optional/pgvector.sql BEFORE first loading it and set EMBEDDINGS_DIM.
# EMBEDDINGS_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_DIM=1536
# EMBEDDINGS_TIMEOUT_MS=20000

# ── Graph memory: Graphiti + Neo4j (optional) ────────────────────────────────
# Powers narrative arcs and the "what the brain is learning" panel. GRAPHITI_URL is
# the master switch — unset, the projector never starts and every graph read is inert.
# The graph service needs its OWN OpenAI key for extraction; set that on the graphiti
# service, not here (see graphiti/.env.example).
# GRAPHITI_URL=http://localhost:8000
# GRAPHSAT-1: a Graphiti group past GRAPH_LANDED_SCAN_DEPTH is judged through a direct per-item Neo4j
# lookup (needs NEO4J_URL below). Never-landed verdicts on that path are HELD (counted in ingest_runs
# meta as deepRequeueHeld) unless this is exactly "true" — measurement first; see
# docs/design/graphsat1-saturated-group-healing.md D4 for what must hold before enabling.
# GRAPH_DEEP_REQUEUE=false
# RECONULL-1: reconcile's per-group episode listing deadline (ms) — an operator ESCAPE HATCH; unset →
# the client default (30s). A listing that fails is now counted (ingest_runs meta unreachableGroups),
# never silent. With NEO4J_URL set, the cheaper lever is GRAPH_LANDED_SCAN_DEPTH=1000 (the per-item
# lookup judges anything past the window; the REST-window oracle stays a valid subset).
# GRAPH_LANDED_LIST_TIMEOUT_MS=30000
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# GRAPH_PROJECT_ENABLED=true        # "false" disables the projector even with a URL
# GRAPH_PROJECT_MINUTES=60          # projector interval
# GRAPH_CHUNK_CHARS=2500            # chars per episode (chunked, not truncated)
# GRAPH_MAX_EPISODE_CHUNKS=16       # max episodes per item -> 40k chars, then dropped

# ── Graph LLM proxy (optional; set it if you run the graph) ──────────────────
# Lets the Graphiti service use the model + key configured in Admin -> Integrations
# instead of a second provider key of its own. On the graphiti service set:
#   OPENAI_BASE_URL=http://<this-app>.railway.internal:3000/api/internal/llm/v1
#   OPENAI_API_KEY=<the same shared secret below, NOT a provider key>
# Its MODEL_NAME is deliberately ignored — the console decides the model.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FAILS CLOSED: unset or shorter than 32 chars and the proxy rejects everything.
# GRAPH_LLM_PROXY_SECRET=
# Only needed if this instance hosts MORE than one team — the slug whose configured
# model the graph should spend. With one team it resolves automatically.
# GRAPH_LLM_TEAM=

# ── Connector credentials (optional; prefer Admin -> Integrations) ───────────
# Connector tokens normally live encrypted in the DB via the Admin UI (needs
# SECRETS_KEY above). These env vars are fallbacks for the in-app connectors.
# SLACK_BOT_TOKEN=      # xoxb-… ; scopes: channels:history, channels:read, users:read
                        # (+ users:read.email to auto-map Slack users to members)
# GITHUB_TOKEN=         # member provisioning, profile sync, codebase scans —
                        # NOT the ingest runner, which reads the Admin-stored token
# Per-member Slack OAuth ("act as me" — DMs/reactions), NOT ingestion:
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT=

# ── Background pollers (optional) ────────────────────────────────────────────
# All background work runs on in-process intervals started at boot — there is no
# cron and no worker service, so these assume ONE running instance.
# INGEST_POLL_ENABLED=true          # "false" disables connector polling
# INGEST_POLL_MINUTES=30            # connector poll interval
# DOC_TASK_INFER_INTERVAL_HOURS=12  # cooldown on the paid doc->task inference pass

# ── Postgres pool / TLS (optional) ───────────────────────────────────────────
# PGSSLMODE=require
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_IDLE_TX_TIMEOUT_MS=60000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_MIGRATION_LOCK_TIMEOUT_MS=15000   # fail a stuck deploy fast rather than queueing all traffic

# ── Error monitoring: Sentry (optional) ──────────────────────────────────────
# All Sentry config is env-driven and fully inert when unset: with no DSN the
# SDK init is a no-op and sends nothing; with no auth token the build skips
# source-map upload. NEVER commit a real DSN or auth token.
#
# DSNs (identify the project; safe-ish but still treat as config, not source):
#   SENTRY_DSN              — server + edge runtimes (read in sentry.{server,edge}.config.ts)
#   NEXT_PUBLIC_SENTRY_DSN  — browser bundle (read in instrumentation-client.ts).
#                             Inlined into client JS by Next, so it IS public.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
#
# Trace sampling (0 = no performance tracing; 1 = sample everything). Optional.
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
#
# Build-time source-map upload (so stack traces are un-minified in Sentry).
# Only used by `next build` via withSentryConfig. Generate the auth token at
# https://sentry.io/settings/account/api/auth-tokens/ (scope: project:releases).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=      # SECRET — never commit. CI/build env only.
