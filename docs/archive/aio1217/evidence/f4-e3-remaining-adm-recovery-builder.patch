+/** A cast's own two identifiers, by the labels `identifiersOf` gives the seeded admins'. */
+const namesOf = (cast: Cast): Record<string, string> => ({
+  [`${cast.label}'s member row`]: cast.memberId,
+  [`${cast.label}'s auth user`]: cast.user.id,
