+const memberlessChain = (user: SessionUser, team: Seed): Step[] => [
+  SESSION_READ,
+  SERVER_CLIENT,
+  statement("server", "teams", { slug: team.teamSlug }, 1),
+  statement("server", "members", { team_id: team.teamId, auth_user_id: user.id, status: "active" }, 0),
+];
