+"""A checkpoint the brain committed but whose acknowledgment was lost (AIO-1167 R47 F3).
+
+Spec (AC-03 durable acknowledgment/replay, AC-04/07 truthful failure accounting; adjudication F3).
+After a document's content is ACCEPTED, its checkpoint is control-plane work. When the brain commits
+that checkpoint but every bounded acknowledgment is lost (a transport exception, or 5xx answers),
+the sidecar's progress revision is unknown. Through the real coordinator and the REAL ``BrainClient``
+revision owner, against a brain double with the brain's actual revision semantics (commit on the
+expected revision; acknowledge an exact replay of what it holds; ``stale_progress`` otherwise):
+
+  * no document failure is charged and nothing is exhausted, however many runs lose it;
+  * the document is not acknowledged and its page not retired before the brain's acknowledgment;
+  * no further checkpoint is SENT this run once the revision is uncertain — no different checkpoint
+    under a guessed revision, so no sibling stream, root or watch state can regress;
+  * the run ends partial; the next acquisition restores the brain's progress and the owed work
+    replays idempotently to completion;
+  * a lost transport response that a retry of the IDENTICAL payload acknowledges is no uncertainty;
+  * a superseded execution is still run-terminal.
+
+One 504 followed by a normal identical retry is not this defect (the brain already acknowledges an
+identical replay); every case here loses ALL bounded acknowledgments.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from aios_ingest.brain_client import BrainClient, IngestResult
+from aios_ingest.config import BrainSettings, Connection
+from aios_ingest.gdrive_sync import run_gdrive_stream
+from aios_ingest.normalize import RawDoc
+from aios_ingest.state import StateStore
+
+INTEGRATION = "00000000-0000-0000-0000-0000000000f3"
+GENERATION = 5
+DOC_MIME = "application/vnd.google-apps.document"
+SETTINGS = BrainSettings("http://brain", "aios_key_secret", "team")
+CONNECTION = Connection("docs", "gdrive", options={"integration_id": INTEGRATION}, project="docs")
+DOCS = {"drive-a": ["a1", "a2"], "drive-b": ["b1"]}
+MAX_ATTEMPTS = 6  # brain_client._GDRIVE_CHECKPOINT_MAX_ATTEMPTS
+
+
+def world(monkeypatch):
+    """``w.losing`` = None | "exception" | "503": while set, the brain COMMITS a valid checkpoint and
+    then loses every response. ``w.lose_after_pushes`` arms it once that many documents were pushed."""
+    w = SimpleNamespace(
+        progress={}, revision=0, fence=0, losing=None, lose_after_pushes=None, armed_mode=None,
+        commits=[], checkpoint_requests=[], pushes=[], clock=1000.0, terminal=None,
+        unreadable=set(), reconciles=[],
+        # R50: a document's read answered with a ProviderDeferred (from the real provider owner), and
+        # a loss mode armed by the first checkpoint that carries document restrictions.
+        deferrals={}, lose_on_restriction=None,
+        # R51: a loss mode armed by the first checkpoint that carries an account hold, and every
+        # Google-facing call this harness answered.
+        lose_on_hold=None, reads=[],
+    )
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        body = json.loads(request.content)
+        action = body.get("action")
+        if action == "acquire":
+            w.fence += 1
+            w.losing = None  # a fresh run: what was lost is restored by this acquisition
+            if w.armed_mode and w.lose_after_pushes is None:
+                w.losing = w.armed_mode
+            return httpx.Response(200, json={
+                "integration_id": INTEGRATION, "generation": GENERATION, "fence": w.fence,
+                "owner": body["owner"], "lease_expires_at": "later", "scope_hash": "scope",
+                "config": {
+                    "authMode": "oauth", "authenticatedAccountId": "account", "fileIds": [],
+                    "folderIds": [], "sharedDriveIds": list(DOCS), "selectionState": "selected",
+                },
+                "progress": copy.deepcopy(w.progress), "progress_revision": w.revision,
+            })
+        if action == "release":
+            return httpx.Response(200, json={})
+        assert action == "checkpoint", action
+        w.checkpoint_requests.append(body)
+        if w.terminal is not None:
+            return httpx.Response(409, json={"error": {"code": w.terminal, "message": "superseded"}})
+        expected, payload = int(body["progress_revision"]), body["progress"]
+        if expected == w.revision:
+            w.revision += 1
+            w.progress = copy.deepcopy(payload)
+            w.commits.append(copy.deepcopy(payload))
+        elif not (expected < w.revision and payload == w.progress):
+            return httpx.Response(409, json={"error": {"code": "stale_progress", "message": "stale"}})
+        if w.lose_on_restriction and payload.get("document_restrictions"):
+            w.losing = w.lose_on_restriction
+        if w.lose_on_hold and payload.get("account_hold"):
+            w.losing = w.lose_on_hold
+        if w.losing == "exception":
+            raise httpx.ReadTimeout("acknowledgment lost", request=request)
+        if w.losing == "503":
+            return httpx.Response(503, json={"error": {"code": "unavailable", "message": "lost"}})
+        return httpx.Response(200, json={"progress_revision": w.revision, "progress": copy.deepcopy(w.progress)})
+
+    async def sleep(delay):
+        w.clock += delay
+
+    class Client(BrainClient):
+        """The real revision/uncertainty owner on the wire; Google-facing calls are doubles."""
+
+        def __init__(self, *args, **kwargs):
+            super().__init__(SETTINGS.base_url, SETTINGS.api_key, SETTINGS.team,
+                             sleep=sleep, random_fn=lambda: 0, monotonic_fn=lambda: w.clock)
+            self._client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+
+        async def broker_gdrive_access_token(self, execution):
+            return {"access_token": "memory", "account": {"subject": "account"}}
+
+        def gdrive_token_provider(self, execution, grant):
+            return SimpleNamespace(close=lambda: None)
+
+        def gdrive_provider_gate(self, execution):
+            return SimpleNamespace(close=lambda: None, __call__=lambda: None)
+
+        async def push(self, item, *, execution=None):
+            w.pushes.append(item.path)
+            if w.lose_after_pushes is not None and len(w.pushes) >= w.lose_after_pushes:
+                w.losing = w.armed_mode
+            return IngestResult("created", f"item-{len(w.pushes)}", item.path)
+
+        async def reconcile_gdrive(self, execution, **kwargs):
+            w.reconciles.append(kwargs)
+            return {"items": 0}
+
+    class Request:
+        def __init__(self, kind, value):
+            self.kind, self.value = kind, value
+
+        def execute(self):
+            return self.value
+
+    class Changes:
+        def getStartPageToken(self, **kwargs):
+            return Request("start", {"startPageToken": f"start:{kwargs.get('driveId')}"})
+
+        def list(self, **kwargs):
+            return Request("changes", {"changes": [], "newStartPageToken": f"terminal:{kwargs.get('driveId')}"})
+
+    class Files:
+        def list(self, **kwargs):
+            drive = kwargs.get("driveId")
+            return Request("list", {"files": [{
+                "id": doc, "name": f"Doc {doc}", "mimeType": DOC_MIME, "driveId": drive,
+                "modifiedTime": "2026-10-30T00:00:00Z",
+            } for doc in DOCS[drive]]})
+
+    class Drive:
+        def changes(self): return Changes()
+        def files(self): return Files()
+
+    class Source:
+        def __init__(self, **kwargs): pass
+        def set_run_deadline(self, deadline): pass
+        def _services(self): return Drive(), object()
+
+        def _execute(self, request):
+            w.reads.append(request.kind)
+            return request.execute()
+
+        def _metadata(self, file_id):
+            w.reads.append("metadata")
+            drive = next(d for d, docs in DOCS.items() if file_id in docs)
+            return {"id": file_id, "name": f"Doc {file_id}", "mimeType": DOC_MIME, "driveId": drive,
+                    "modifiedTime": "2026-10-30T00:00:00Z"}
+
+        def _raw_doc(self, meta):
+            w.reads.append("body")
+            if meta["id"] in w.deferrals:
+                raise w.deferrals[meta["id"]]
+            if meta["id"] in w.unreadable:
+                raise RuntimeError("permanently malformed document")
+            return RawDoc(source="gdrive", external_id=meta["id"], title=meta["name"], body="body text")
+
+    monkeypatch.setattr("aios_ingest.gdrive_sync.BrainClient", Client)
+    monkeypatch.setattr("aios_ingest.gdrive_sync.GoogleDriveSource", Source)
+    return w
+
+
+def _doc(path: str) -> str:
+    return path.rsplit("/", 1)[-1].removesuffix(".md")
+
+
+def _owed(state: StateStore):
+    return [tuple(row) for row in state._db.execute(
+        "SELECT item_key, failures, exhausted_at FROM pending_work "
+        "WHERE acknowledged_at IS NULL AND superseded_at IS NULL ORDER BY item_key").fetchall()]
+
+
+@pytest.mark.parametrize("mode", ["exception", "503"])
+@pytest.mark.parametrize("lost_runs", [1, 6])
+@pytest.mark.asyncio
+async def test_a_committed_checkpoint_whose_acknowledgments_are_all_lost_charges_nothing_and_recovers(
+    tmp_path, monkeypatch, mode, lost_runs,
+):
+    w = world(monkeypatch)
+    w.armed_mode, w.lose_after_pushes = mode, 1
+    state = StateStore(str(tmp_path / "sidecar.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    # The brain committed the first document's checkpoint; the sidecar never saw it acknowledged.
+    lost = [r for r in w.checkpoint_requests if r["progress"] == w.commits[-1]]
+    assert len(lost) == MAX_ATTEMPTS  # the IDENTICAL payload, retried within the bound — then nothing
+    assert w.checkpoint_requests[-MAX_ATTEMPTS:] == lost  # no different checkpoint was sent after it
+    assert len({r["progress_revision"] for r in lost}) == 1
+    first = _doc(w.pushes[0])
+    assert summary.failed == 0
+    assert summary.failure_categories.get("checkpoint_unacknowledged") == 1
+    assert summary.authoritative_complete is False
+    assert len(w.pushes) == 1  # no further document was started under the unknown revision
+    owed = dict((item, (failures, exhausted)) for item, failures, exhausted in _owed(state))
+    assert owed, "the accepted document is still owed: not acknowledged before the brain's ack"
+    assert all(value == (0, None) for value in owed.values())
+
+    # Further runs that lose every acknowledgment again: still nothing charged, nothing exhausted.
+    w.lose_after_pushes = None
+    for _ in range(lost_runs - 1):
+        again = await run_gdrive_stream(SETTINGS, CONNECTION, StateStore(str(tmp_path / "sidecar.sqlite")))
+        assert again.failed == 0
+        assert all(failures == 0 and exhausted is None for _item, failures, exhausted in _owed(state))
+
+    # Acknowledgments reach the sidecar again: the next acquisition restores the brain's progress and
+    # the owed work replays to completion — no sibling stream regressed on the way.
+    w.armed_mode = None
+    recovered_state = StateStore(str(tmp_path / "sidecar.sqlite"))
+    recovered = await run_gdrive_stream(SETTINGS, CONNECTION, recovered_state)
+    assert recovered.failed == 0
+    assert "checkpoint_unacknowledged" not in recovered.failure_categories
+    assert _owed(recovered_state) == []
+    assert {_doc(path) for path in w.pushes} >= {doc for docs in DOCS.values() for doc in docs}
+    assert first in {_doc(path) for path in w.pushes[1:]}  # replayed, idempotently
+    streams = w.progress.get("streams") or {}
+    assert set(streams) == set(DOCS)
+    state.close()
+    recovered_state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_lost_response_that_an_identical_retry_acknowledges_is_no_uncertainty(tmp_path, monkeypatch):
+    """Control: the brain acknowledges an exact replay — the run simply continues."""
+    w = world(monkeypatch)
+    state = StateStore(str(tmp_path / "control.sqlite"))
+    original = httpx.MockTransport.handle_async_request
+    dropped = {"n": 0}
+
+    async def drop_one(self, request):
+        body = json.loads(request.content)
+        response = await original(self, request)
+        if body.get("action") == "checkpoint" and w.pushes and dropped["n"] == 0:
+            dropped["n"] = 1
+            raise httpx.ReadTimeout("one lost response", request=request)
+        return response
+
+    monkeypatch.setattr(httpx.MockTransport, "handle_async_request", drop_one)
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert dropped["n"] == 1
+    assert "checkpoint_unacknowledged" not in summary.failure_categories
+    assert summary.failed == 0 and _owed(state) == []
+    assert len(w.pushes) == sum(len(docs) for docs in DOCS.values())
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_superseded_execution_stays_run_terminal(tmp_path, monkeypatch):
+    w = world(monkeypatch)
+    state = StateStore(str(tmp_path / "terminal.sqlite"))
+    import aios_ingest.gdrive_sync as sync
+    original_push = sync.BrainClient.push
+
+    async def push_then_supersede(self, item, *, execution=None):
+        # The execution is superseded right after the first accepted document.
+        result = await original_push(self, item, execution=execution)
+        w.terminal = "stale_execution"
+        return result
+
+    monkeypatch.setattr(sync.BrainClient, "push", push_then_supersede)
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories.get("stale_execution") == 1
+    assert "checkpoint_unacknowledged" not in summary.failure_categories
+    assert len(w.pushes) == 1
+    assert all(failures == 0 and exhausted is None for _item, failures, exhausted in _owed(state))
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_new_restriction_under_a_lost_acknowledgment_is_kept_reported_and_never_republished_early(
+    tmp_path, monkeypatch,
+):
+    """R50 F7 with the REAL client latch: a newly learned document restriction rides a checkpoint the
+    brain commits but whose acknowledgment is lost. The local journal keeps it, the run says so
+    (`document_restriction_unpublished` beside `checkpoint_unacknowledged`), no changed checkpoint
+    is sent before reacquisition, and the next acquisition restores it from the brain's progress —
+    the restricted document is never read early."""
+    from test_account_hold_before_streams import provider_deferral
+
+    w = world(monkeypatch)
+    w.deferrals["a1"] = provider_deferral(503, "99999999")
+    w.lose_on_restriction = "exception"
+    state = StateStore(str(tmp_path / "latched.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    carrying = [r for r in w.checkpoint_requests if (r["progress"] or {}).get("document_restrictions")]
+    assert carrying and carrying[0]["progress"] == w.commits[-1]  # committed, acknowledgment lost
+    assert len(carrying) == MAX_ATTEMPTS  # the identical payload within the bound…
+    assert w.checkpoint_requests[-MAX_ATTEMPTS:] == carrying  # …then nothing changed is sent (latch)
+    assert summary.failure_categories.get("checkpoint_unacknowledged") == 1
+    assert summary.failure_categories.get("document_restriction_unpublished") == 1
+    assert summary.authoritative_complete is False
+    assert state.document_restrictions(INTEGRATION, GENERATION, "account").get("a1") is not None
+    assert all(_doc(path) != "a1" for path in w.pushes)
+    state.close()
+
+    # Reacquisition: the brain's committed progress carries the restriction; a1 is still not read.
+    w.lose_on_restriction = None
+    w.deferrals.clear()
+    recovered_state = StateStore(str(tmp_path / "latched.sqlite"))
+    recovered = await run_gdrive_stream(SETTINGS, CONNECTION, recovered_state)
+    assert "document_restriction_unpublished" not in recovered.failure_categories
+    assert "checkpoint_unacknowledged" not in recovered.failure_categories
+    assert [item["id"] for item in w.progress["document_restrictions"]["items"]] == ["a1"]
+    assert all(_doc(path) != "a1" for path in w.pushes)
+    assert recovered.authoritative_complete is False
+    recovered_state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_drain_hold_committed_under_a_lost_acknowledgment_is_reported_and_adopted_with_no_early_call(
+    tmp_path, monkeypatch,
+):
+    """R51 F3 with the REAL client latch: a drain-phase quota answer's hold rides a checkpoint the
+    brain commits but whose acknowledgment is lost. Nothing changed is sent after it — not even the
+    end-of-run restriction publication — and the run says so truthfully (`account_hold_unpublished`
+    beside `checkpoint_unacknowledged`). Reacquired on FRESH local state, the brain's committed hold
+    is adopted and no provider call is made before it passes."""
+    from test_account_hold_before_streams import provider_deferral
+
+    w = world(monkeypatch)
+    w.deferrals["a1"] = provider_deferral(429, "3600")
+    w.lose_on_hold = "exception"
+    state = StateStore(str(tmp_path / "hold-latched.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    carrying = [r for r in w.checkpoint_requests if (r["progress"] or {}).get("account_hold")]
+    assert carrying and carrying[0]["progress"] == w.commits[-1]  # committed, acknowledgment lost
+    assert len(carrying) == MAX_ATTEMPTS
+    assert w.checkpoint_requests[-MAX_ATTEMPTS:] == carrying  # the latch: nothing else is sent
+    assert summary.failure_categories.get("rate_limited") == 1
+    assert summary.failure_categories.get("checkpoint_unacknowledged") == 1
+    assert summary.failure_categories.get("account_hold_unpublished") == 1
+    assert summary.failed == 0
+    assert state.connection_hold(INTEGRATION, GENERATION, "account") is not None
+    assert w.reads[-1] == "body"  # no provider call after the quota answer
+    state.close()
+
+    # Fresh local state: the committed hold is restored by acquisition; no provider call at all.
+    w.lose_on_hold = None
+    w.deferrals.clear()
+    w.reads.clear()
+    fresh = StateStore(str(tmp_path / "hold-fresh.sqlite"))
+    restored = await run_gdrive_stream(SETTINGS, CONNECTION, fresh)
+    assert w.reads == []
+    assert restored.failure_categories.get("rate_limited") == 1
+    assert "account_hold_unpublished" not in restored.failure_categories
+    fresh.close()
diff --git a/ingestion/tests/test_checkpoint_uncertainty_latch.py b/ingestion/tests/test_checkpoint_uncertainty_latch.py
new file mode 100644
index 00000000..6e853bfb
--- /dev/null
+++ b/ingestion/tests/test_checkpoint_uncertainty_latch.py
@@ -0,0 +1,134 @@
+"""The ``BrainClient`` checkpoint-revision owner latches an unknown revision (AIO-1167 R47 F3).
+
+The client owns each execution's progress revision. When a checkpoint was SENT but no 200 came back
+(all bounded responses lost, terminal 5xx, a deferral after a send, or ``stale_progress``), the brain
+may hold a revision this client does not know. From then on the client refuses to send any further
+checkpoint under that execution — never a changed document under a guessed revision — until a fresh
+acquisition restores the brain's authority. A checkpoint that was never sent latches nothing.
+
+This pins the client layer on its own: the coordinator also stops on the first uncertainty, which
+would mask a client that kept sending.
+"""
+
+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+
+from aios_ingest.brain_client import BrainClient, BrainDeferred, BrainError, GdriveExecution
+
+INTEGRATION = "11111111-1111-1111-1111-111111111111"
+OWNER = "22222222-2222-2222-2222-222222222222"
+
+
+def _client(handler, clock):
+    async def sleep(delay):
+        clock[0] += delay
+
+    client = BrainClient("http://brain", "aios_abc_def", "demo", sleep=sleep,
+                         random_fn=lambda: 0, monotonic_fn=lambda: clock[0])
+    client._client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+    return client
+
+
+def _execution(**kwargs) -> GdriveExecution:
+    return GdriveExecution(INTEGRATION, 2, 4, OWNER, "later", "scope", {}, progress_revision=9, **kwargs)
+
+
+def _checkpoints(calls):
+    return [c for c in calls if c.get("action") == "checkpoint"]
+
+
+def _acquired(request_body):
+    return httpx.Response(200, json={
+        "integration_id": INTEGRATION, "generation": 2, "fence": 4, "owner": request_body["owner"],
+        "lease_expires_at": "later", "scope_hash": "scope", "config": {}, "progress": {},
+        "progress_revision": 10,
+    })
+
+
+@pytest.mark.parametrize("answer", ["transport", "503", "stale_progress"])
+@pytest.mark.asyncio
+async def test_a_sent_unacknowledged_checkpoint_latches_until_reacquired(answer):
+    calls: list[dict] = []
+    clock = [100.0]
+    healthy = {"on": False}
+
+    def handler(request: httpx.Request):
+        body = json.loads(request.content)
+        calls.append(body)
+        if body["action"] == "acquire":
+            return _acquired(body)
+        if healthy["on"]:
+            return httpx.Response(200, json={"progress_revision": body["progress_revision"] + 1, "progress": {}})
+        if answer == "transport":
+            raise httpx.ConnectError("lost", request=request)
+        if answer == "503":
+            return httpx.Response(503, json={"error": {"code": "unavailable", "message": "down"}})
+        return httpx.Response(409, json={"error": {"code": "stale_progress", "message": "stale"}})
+
+    client = _client(handler, clock)
+    execution = _execution()
+    async with client:
+        with pytest.raises(BrainError) as first:
+            await client.checkpoint_gdrive_execution(execution, {"page_token": "a"})
+        assert client.gdrive_progress_uncertain(execution)
+        if answer == "transport":
+            assert first.value.code == "checkpoint_unacknowledged"
+        sent = len(_checkpoints(calls))
+        assert sent >= 1
+
+        # A DIFFERENT checkpoint under the same execution is refused without being sent.
+        healthy["on"] = True
+        with pytest.raises(BrainDeferred) as refused:
+            await client.checkpoint_gdrive_execution(execution, {"page_token": "b"})
+        assert refused.value.code == "checkpoint_unacknowledged" and refused.value.not_before is None
+        assert len(_checkpoints(calls)) == sent
+
+        # A fresh acquisition restores the authority, and checkpoints are sent again.
+        reacquired = await client.acquire_gdrive_execution(INTEGRATION, OWNER)
+        assert not client.gdrive_progress_uncertain(reacquired)
+        ack = await client.checkpoint_gdrive_execution(reacquired, {"page_token": "c"})
+        assert ack["progress_revision"] == 11
+        assert _checkpoints(calls)[-1]["progress_revision"] == 10
+
+
+@pytest.mark.asyncio
+async def test_a_lost_response_retried_identically_and_acknowledged_latches_nothing():
+    calls: list[dict] = []
+    clock = [100.0]
+
+    def handler(request: httpx.Request):
+        body = json.loads(request.content)
+        calls.append(body)
+        if len(calls) == 1:
+            raise httpx.ReadTimeout("lost", request=request)
+        return httpx.Response(200, json={"progress_revision": body["progress_revision"] + 1, "progress": {}})
+
+    client = _client(handler, clock)
+    execution = _execution()
+    async with client:
+        ack = await client.checkpoint_gdrive_execution(execution, {"page_token": "a"})
+    assert ack["progress_revision"] == 10
+    assert not client.gdrive_progress_uncertain(execution)
+    assert calls[0] == calls[1]  # the identical payload, under the same revision
+
+
+@pytest.mark.asyncio
+async def test_a_checkpoint_never_sent_latches_nothing():
+    calls: list[dict] = []
+    clock = [100.0]
+
+    def handler(request: httpx.Request):
+        calls.append(json.loads(request.content))
+        return httpx.Response(200, json={"progress_revision": 10, "progress": {}})
+
+    client = _client(handler, clock)
+    execution = _execution(run_deadline=99.0)
+    async with client:
+        with pytest.raises(BrainDeferred) as deferred:
+            await client.checkpoint_gdrive_execution(execution, {"page_token": "a"})
+    assert deferred.value.code == "checkpoint_deadline" and calls == []
+    assert not client.gdrive_progress_uncertain(execution)
diff --git a/ingestion/tests/test_deferred_folder_enumeration.py b/ingestion/tests/test_deferred_folder_enumeration.py
new file mode 100644
index 00000000..9dab26a4
--- /dev/null
+++ b/ingestion/tests/test_deferred_folder_enumeration.py
@@ -0,0 +1,422 @@
+"""A deferred folder is settled only by listing its subtree, never by its metadata (AIO-1167 R51 final 1).
+
+Spec (accepted-spec AC-03/05/07; Astra 20:01 UTC adjudication, finding 1). A folder root whose read
+was deferred while a snapshot was being built has only a placeholder in that build — retained
+membership, none on fresh local state. Reading the folder's metadata later proves where it is, not
+what is under it. Through the real coordinator over ``_DriveWorld``:
+
+  * with existing brain claims and FRESH local state, folder A deferred and the build kept open by a
+    sibling larger than one run's discovery budget, a restart in which A's metadata recovers and the
+    change feed is empty lists A AND its nested folder before any complete reconciliation; every
+    complete snapshot holds A's documents, their claims survive, and the brain's last success does
+    not move until the connection is genuinely complete;
+  * with RETAINED local membership, a document under A that is gone at the provider (no change the
+    stream can see) is NOT kept by the placeholder: the subtree is listed again and the complete
+    snapshot retires its claim — never reported complete with stale membership;
+  * a recovered listing interrupted part-way leaves A deferred and the connection incomplete; after a
+    restart it resumes, lists the rest, settles A and completes.
+
+Post-blind corrections (Astra adjudication of Fable's R51 findings):
+
+  * F1 — ordinary uncertainty (a non-deferral metadata error, here on the change-page path) never
+    erases A's deferred marker: it survives a reopened SQLite file, metadata recovery alone does not
+    settle A, A and its nested folder are listed before any complete reconciliation, existing claims
+    survive and last success waits for completion. Ordinary uncertainty on a root that was never
+    deferred is still settled by metadata recovery (control);
+  * F3 — a deferred folder whose placeholder already closed its traversal, then answering 404, is not
+    read in that build: a controlled replacement snapshot decides it, so no complete reconciliation
+    carries its stale placeholder membership, it is never listed, and only its unsupported membership
+    disappears — the direct selection, the sibling root and another connection's claim stay.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.gdrive_sync import _MAX_DISCOVERY_PAGES_PER_STREAM
+from aios_ingest.state import ROOT_DEFERRED_PREFIX, StateStore
+from test_document_restrictions import clock  # noqa: F401 (fixture)
+from test_gdrive_upgrade import _SECOND_INTEGRATION, _ClaimLedger, _DriveWorld, _ProviderHttpError
+from test_root_evidence_r49 import real_deferral
+
+GEN = 9
+DRIVE = "shared-a"
+# More listings than one run may make, so a folder of this size keeps a snapshot building.
+BIG = _MAX_DISCOVERY_PAGES_PER_STREAM + 5
+A_DOCS = {"doc-a1", "doc-a2"}
+
+
+def _world(monkeypatch, *, big_a: bool = False, big_b: bool = True):
+    world = _DriveWorld(folder_ids=["folder-a", "folder-b"]).install(monkeypatch)
+    world.ledger = _ClaimLedger()
+    world.put("folder-a", drive=DRIVE, folder=True)
+    world.put("folder-a-sub", drive=DRIVE, parent="folder-a", folder=True)
+    world.put("doc-a1", drive=DRIVE, parent="folder-a")
+    world.put("doc-a2", drive=DRIVE, parent="folder-a-sub")
+    if big_a:
+        for i in range(BIG):
+            world.put(f"folder-a{i}", drive=DRIVE, parent="folder-a", folder=True)
+            world.put(f"doc-ax{i}", drive=DRIVE, parent=f"folder-a{i}")
+    world.put("folder-b", drive=DRIVE, folder=True)
+    world.put("doc-b", drive=DRIVE, parent="folder-b")
+    if big_b:
+        for i in range(BIG):
+            world.put(f"folder-b{i}", drive=DRIVE, parent="folder-b", folder=True)
+            world.put(f"doc-b{i}", drive=DRIVE, parent=f"folder-b{i}")
+    return world
+
+
+async def _until_complete(world, state, limit: int = 40):
+    summary = None
+    for _ in range(limit):
+        summary = await world.run(state)
+        if summary.authoritative_complete:
+            return summary
+    raise AssertionError(f"not complete after {limit} runs: {summary}")
+
+
+def _deferred(state, world) -> bool:
+    return ("folder", "folder-a") in state.deferred_roots(world.integration_id, GEN, DRIVE)
+
+
+def _listed(world, folder: str) -> bool:
+    return ("list", DRIVE, folder) in world.calls
+
+
+@pytest.mark.asyncio
+async def test_fresh_state_with_brain_claims_lists_the_recovered_folder_before_any_complete_snapshot(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    first_state = StateStore(str(tmp_path / "first.sqlite"))
+    await _until_complete(world, first_state)
+    first_state.close()
+    assert A_DOCS <= set(world.reconciled[-1])
+    last_success = world.stream(DRIVE).get("last_success_at")
+
+    # Fresh local state; folder A's read is deferred (a 503 naming no minimum).
+    world.unreadable["folder-a"] = real_deferral(503)
+    path = str(tmp_path / "fresh.sqlite")
+    state = StateStore(path)
+    world.calls.clear()
+    await world.run(state)
+    progress = state.get_progress(world.namespace(DRIVE))
+    assert progress.building_snapshot is not None  # the sibling keeps this build open
+    assert _deferred(state, world)
+    assert not _listed(world, "folder-a")
+    state.close()
+
+    # Restart: A's metadata recovers; the change feed is empty.
+    world.unreadable.pop("folder-a")
+    state = StateStore(path)
+    summary = None
+    for _ in range(40):
+        mark = len(world.reconciled)
+        summary = await world.run(state)
+        for snapshot in world.reconciled[mark:]:
+            assert A_DOCS <= set(snapshot), "a complete snapshot without folder A's subtree"
+            assert _listed(world, "folder-a") and _listed(world, "folder-a-sub")
+        if summary.authoritative_complete:
+            break
+        assert world.stream(DRIVE).get("last_success_at") == last_success  # not before completion
+    assert summary is not None and summary.authoritative_complete
+    assert _listed(world, "folder-a") and _listed(world, "folder-a-sub")
+    for doc in A_DOCS:
+        assert world.ledger.claims[doc] == {world.integration_id}  # the existing claims survive
+        assert doc not in world.ledger.deleted
+    assert not _deferred(state, world)
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_retained_membership_never_keeps_a_document_the_recovered_listing_does_not_find(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    path = str(tmp_path / "retained.sqlite")
+    state = StateStore(path)
+    await _until_complete(world, state)
+    assert A_DOCS <= set(world.reconciled[-1])
+
+    # A rescan is seeded by a change to a folder under B; folder A's read is deferred during it.
+    world.logs.setdefault(DRIVE, []).append({"fileId": "folder-b0", "file": dict(world.files["folder-b0"])})
+    world.unreadable["folder-a"] = real_deferral(503)
+    for _ in range(4):
+        await world.run(state)
+        progress = state.get_progress(world.namespace(DRIVE))
+        if progress.building_snapshot is not None and _deferred(state, world):
+            break
+    assert progress.building_snapshot is not None and _deferred(state, world)
+
+    # doc-a2 is gone at the provider, with no change this stream can see; A becomes readable again.
+    world.files.pop("doc-a2")
+    world.unreadable.pop("folder-a")
+    mark = len(world.reconciled)
+    summary = None
+    for _ in range(40):
+        before = len(world.reconciled)
+        summary = await world.run(state)
+        for snapshot in world.reconciled[before:]:
+            assert "doc-a2" not in snapshot, "complete with stale retained membership"
+        if summary.authoritative_complete:
+            break
+    assert summary is not None and summary.authoritative_complete
+    assert len(world.reconciled) > mark
+    assert "doc-a1" in world.reconciled[-1] and "doc-a2" not in world.reconciled[-1]
+    assert (world.integration_id, "doc-a2") in world.ledger.retired
+    assert _listed(world, "folder-a-sub")
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_an_interrupted_recovered_listing_keeps_the_folder_deferred_and_resumes_after_restart(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch, big_a=True, big_b=False)
+    path = str(tmp_path / "interrupted.sqlite")
+    state = StateStore(path)
+    await _until_complete(world, state)
+    a_docs = {doc for doc in world.files if doc.startswith("doc-a")}
+    assert a_docs <= set(world.reconciled[-1])
+
+    # Folder A is deferred during a controlled rescan, which publishes without it.
+    world.logs.setdefault(DRIVE, []).append({"fileId": "folder-b", "file": dict(world.files["folder-b"])})
+    world.unreadable["folder-a"] = real_deferral(503)
+    for _ in range(6):
+        await world.run(state)
+        progress = state.get_progress(world.namespace(DRIVE))
+        if progress.building_snapshot is None and _deferred(state, world):
+            break
+    assert _deferred(state, world)
+    reconciled = len(world.reconciled)
+
+    # A recovers; its listing needs more than one run's discovery budget.
+    world.unreadable.pop("folder-a")
+    world.calls.clear()
+    interrupted = await world.run(state)
+    # Part-way (A alone needs more listings than one run may make): still deferred, and nothing
+    # was reconciled on a partial listing.
+    assert not interrupted.authoritative_complete
+    assert _deferred(state, world)
+    assert len(world.reconciled) == reconciled
+    state.close()
+
+    state = StateStore(path)  # restart
+    summary = await _until_complete(world, state)
+    assert summary.authoritative_complete
+    assert a_docs <= set(world.reconciled[-1])
+    assert not _deferred(state, world)
+    assert _listed(world, "folder-a")
+    state.close()
+
+
+# ------------------------------------------------------------------------------------------------ #
+# R51 post-blind F1 — ordinary uncertainty keeps the deferred listing debt
+# ------------------------------------------------------------------------------------------------ #
+
+def _obligation(state, connection, root_id):
+    return state.root_obligations(connection, GEN)[("folder", root_id)]
+
+
+def test_ordinary_uncertainty_keeps_the_deferred_marker_and_only_a_listing_or_verified_transition_discharges_it(
+    tmp_path,
+):
+    connection = "00000000-0000-0000-0000-0000000000f1"
+    path = str(tmp_path / "markers.sqlite")
+    state = StateStore(path)
+    for root_id in ("folder-a", "folder-c", "folder-r", "folder-u"):
+        state.bind_root(connection, GEN, "folder", root_id, DRIVE)
+    state.mark_root_deferred(connection, GEN, "folder", "folder-a", DRIVE, detail="its read is withheld")
+    # A non-deferral metadata error on the deferred root, and on one that was never deferred (control).
+    state.mark_root_uncertain(connection, GEN, "folder", "folder-a", DRIVE, detail="root metadata unreadable (403)")
+    state.mark_root_uncertain(connection, GEN, "folder", "folder-c", DRIVE, detail="root metadata unreadable (403)")
+    state.close()
+
+    state = StateStore(path)  # reopened
+    deferred = _obligation(state, connection, "folder-a")
+    assert deferred.status == "uncertain" and deferred.detail.startswith(ROOT_DEFERRED_PREFIX)
+    assert state.deferred_roots(connection, GEN, DRIVE) == [("folder", "folder-a")]
+    assert _obligation(state, connection, "folder-c").detail == "root metadata unreadable (403)"
+
+    # Metadata recovery settles the ordinary uncertainty only; the deferred root still owes its listing.
+    state.settle_root(connection, GEN, "folder", "folder-a")
+    state.settle_root(connection, GEN, "folder", "folder-c")
+    assert _obligation(state, connection, "folder-a").status == "uncertain"
+    assert state.deferred_roots(connection, GEN, DRIVE) == [("folder", "folder-a")]
+    control = _obligation(state, connection, "folder-c")
+    assert control.status == "bound" and control.detail is None
+
+    # A newer deferral still records its own detail; the listing settles it.
+    state.mark_root_deferred(connection, GEN, "folder", "folder-a", DRIVE, detail="again")
+    assert _obligation(state, connection, "folder-a").detail == f"{ROOT_DEFERRED_PREFIX}: again"
+    state.settle_root(connection, GEN, "folder", "folder-a", enumerated=True)
+    listed = _obligation(state, connection, "folder-a")
+    assert listed.status == "bound" and listed.detail is None
+
+    # A relocation and a verified not-found are the other transitions that discharge the debt.
+    state.mark_root_deferred(connection, GEN, "folder", "folder-r", DRIVE, detail="withheld")
+    state.mark_root_relocating(connection, GEN, "folder", "folder-r", DRIVE, destination="shared-b")
+    state.mark_root_deferred(connection, GEN, "folder", "folder-u", DRIVE, detail="withheld")
+    assert state.record_root_unavailable(
+        connection, GEN, "folder", "folder-u", detail="selected root unavailable: gone",
+    )
+    assert state.deferred_roots(connection, GEN, DRIVE) == []
+    assert _obligation(state, connection, "folder-r").status == "relocating"
+    assert _obligation(state, connection, "folder-u").detail == "selected root unavailable: gone"
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_change_page_uncertainty_never_lets_metadata_recovery_settle_a_deferred_folder(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    world.put("doc-a3", drive=DRIVE, parent="folder-a")
+    path = str(tmp_path / "change-page.sqlite")
+    state = StateStore(path)
+    await _until_complete(world, state)
+    assert A_DOCS | {"doc-a3"} <= set(world.reconciled[-1])
+    last_success = world.stream(DRIVE).get("last_success_at")
+    reconciled = len(world.reconciled)
+
+    # Folder A is deferred (a 503 naming no minimum) during a controlled rescan its sibling keeps open;
+    # the rescan then publishes with A's retained membership only. Nothing is reconciled meanwhile.
+    world.logs.setdefault(DRIVE, []).append({"fileId": "folder-b0", "file": dict(world.files["folder-b0"])})
+    world.unreadable["folder-a"] = real_deferral(503)
+    progress = None
+    for _ in range(12):
+        await world.run(state)
+        progress = state.get_progress(world.namespace(DRIVE))
+        if progress.building_snapshot is None and _deferred(state, world):
+            break
+    assert progress.building_snapshot is None and _deferred(state, world)
+    assert len(world.reconciled) == reconciled
+    assert world.stream(DRIVE).get("last_success_at") == last_success
+
+    # One read of A fails with an ORDINARY error — a permission 403 naming no quota reason — on the
+    # change-page path: a document claimed through A is reported removed.
+    world.files.pop("doc-a3")
+    world.logs[DRIVE].append({"fileId": "doc-a3", "removed": True})
+    world.unreadable["folder-a"] = _ProviderHttpError(403)
+    summary = await world.run(state)
+    assert summary.failure_categories.get("selection_root_unverified") == 1  # the change-page caller
+    assert _deferred(state, world)
+    assert _obligation(state, world.integration_id, "folder-a").detail.startswith(ROOT_DEFERRED_PREFIX)
+    assert world.removed == [] and len(world.reconciled) == reconciled
+    state.close()
+
+    state = StateStore(path)  # restart: the marker is durable
+    assert _deferred(state, world)
+
+    # A's metadata recovers. That locates the folder; only listing its subtree settles it.
+    world.unreadable.pop("folder-a")
+    world.calls.clear()
+    summary = None
+    for _ in range(40):
+        before = len(world.reconciled)
+        summary = await world.run(state)
+        if not _deferred(state, world):
+            assert _listed(world, "folder-a") and _listed(world, "folder-a-sub"), "settled without a listing"
+        for snapshot in world.reconciled[before:]:
+            assert _listed(world, "folder-a") and _listed(world, "folder-a-sub"), "complete before A was listed"
+            assert A_DOCS <= set(snapshot)
+        if summary.authoritative_complete:
+            break
+        assert world.stream(DRIVE).get("last_success_at") == last_success  # not before completion
+    assert summary is not None and summary.authoritative_complete
+    assert not _deferred(state, world)
+    for doc in A_DOCS:
+        assert world.ledger.claims[doc] == {world.integration_id}  # the existing claims survive
+        assert doc not in world.ledger.deleted
+    # The document that really is gone leaves through the verified listing, not the placeholder.
+    assert "doc-a3" not in world.reconciled[-1]
+    assert (world.integration_id, "doc-a3") in world.ledger.retired
+    state.close()
+
+
+# ------------------------------------------------------------------------------------------------ #
+# R51 post-blind F3 — a closed deferred folder answering 404 is decided by a replacement snapshot
+# ------------------------------------------------------------------------------------------------ #
+
+@pytest.mark.parametrize("child_removed", [
+    pytest.param(False, id="no-per-document-change"),
+    # R51 F3-A: an ambiguous `removed` for one child claimed through A — no folder tombstone — reaches
+    # the change page's root read (`absence_withheld`) while A is deferred in the active snapshot.
+    pytest.param(True, id="ambiguous-child-removal"),
+])
+@pytest.mark.asyncio
+async def test_a_deferred_folder_gone_after_its_placeholder_is_decided_by_a_replacement_snapshot(
+    tmp_path, monkeypatch, clock, child_removed,
+):
+    world = _world(monkeypatch)
+    world.config["fileIds"] = ["doc-direct"]  # a direct selection beside the two folder roots
+    world.put("doc-direct", drive=DRIVE)
+    path = str(tmp_path / "gone.sqlite")
+    state = StateStore(path)
+    await _until_complete(world, state)
+    assert A_DOCS | {"doc-direct", "doc-b"} <= set(world.reconciled[-1])
+    world.ledger.push(_SECOND_INTEGRATION, "doc-a1")  # another connection claims one of A's documents
+    last_success = world.stream(DRIVE).get("last_success_at")
+
+    # Folder A is deferred during a controlled rescan that its sibling keeps open: its placeholder
+    # closes A's traversal carrying A's retained membership.
+    world.logs.setdefault(DRIVE, []).append({"fileId": "folder-b0", "file": dict(world.files["folder-b0"])})
+    world.unreadable["folder-a"] = real_deferral(503)
+    progress = None
+    for _ in range(4):
+        await world.run(state)
+        progress = state.get_progress(world.namespace(DRIVE))
+        if progress.building_snapshot is not None and _deferred(state, world):
+            break
+    assert progress.building_snapshot is not None and _deferred(state, world)
+    placeholder_build = progress.building_snapshot
+
+    # Folder A and everything under it are then gone: A's metadata answers 404. The change feed carries
+    # no folder tombstone — at most an ambiguous removal of one child.
+    for gone in ("folder-a", "folder-a-sub", "doc-a1", "doc-a2"):
+        world.files.pop(gone)
+    world.unreadable.pop("folder-a")
+    if child_removed:
+        world.logs[DRIVE].append({"fileId": "doc-a1", "removed": True})
+    state.close()
+    state = StateStore(path)  # restart
+    world.calls.clear()
+    summary = None
+    change_page_read_root = False
+    for _ in range(40):
+        before = len(world.reconciled)
+        mark = len(world.calls)
+        summary = await world.run(state)
+        calls = world.calls[mark:]
+        changes_at = next((i for i, call in enumerate(calls) if call[0] == "changes"), None)
+        if changes_at is not None and ("metadata", "folder-a") in calls[changes_at:]:
+            # The change page read A's verified 404 while A was deferred in the active snapshot: the
+            # removal is withheld and A stays deferred — that 404 does not discharge the placeholder.
+            change_page_read_root = True
+            assert _deferred(state, world), "a change-page 404 discharged the deferred placeholder"
+        for snapshot in world.reconciled[before:]:
+            assert "doc-a2" not in snapshot, "complete with folder A's stale placeholder membership"
+            assert not A_DOCS & set(snapshot), "complete with folder A's stale placeholder membership"
+        if summary.authoritative_complete:
+            break
+        assert world.stream(DRIVE).get("last_success_at") == last_success  # not before completion
+    assert summary is not None and summary.authoritative_complete
+    if child_removed:
+        assert change_page_read_root  # the F3-A path was really exercised
+        # The child leaves through the verified replacement snapshot, not a removal on the page.
+        assert "doc-a1" not in world.removed
+
+    # A controlled replacement snapshot decided A — not the build its placeholder belongs to — from
+    # A's own verified not-found, and A was never listed.
+    assert state.get_progress(world.namespace(DRIVE)).active_snapshot != placeholder_build
+    assert ("metadata", "folder-a") in world.calls
+    assert not _listed(world, "folder-a") and not _listed(world, "folder-a-sub")
+    assert not _deferred(state, world)
+    # Only A's unsupported membership disappeared: the direct selection and the sibling root stay.
+    assert set(world.reconciled[-1]) == {doc for doc in world.files if doc.startswith("doc-")}
+    assert (world.integration_id, "doc-a1") in world.ledger.retired
+    assert world.ledger.claims["doc-a1"] == {_SECOND_INTEGRATION}  # another connection's claim stands
+    assert "doc-a1" not in world.ledger.deleted
+    assert world.ledger.claims["doc-direct"] == {world.integration_id}
+    assert world.ledger.claims["doc-b"] == {world.integration_id}
+    state.close()
