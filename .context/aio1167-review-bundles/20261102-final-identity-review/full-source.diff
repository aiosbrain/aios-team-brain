+    world.unreadable["file-a"] = real_deferral(503, LONG)
+    world.unreadable["file-b"] = _ProviderHttpError(404)
+    refusals: list[int] = []
+    later: list[int] = []
+    world.checkpoint_faults.extend([_refuse_then_watch(code, refusals, later)] * 5)
