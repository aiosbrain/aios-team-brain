diff --git a/ingestion/tests/test_exhaustion_is_not_completion.py b/ingestion/tests/test_exhaustion_is_not_completion.py
new file mode 100644
index 00000000..d08ed63a
--- /dev/null
+++ b/ingestion/tests/test_exhaustion_is_not_completion.py
@@ -0,0 +1,62 @@
+"""Exhaustion is not completion evidence (AIO-1167 R47 — F4 preserved).
+
+Spec (accepted-spec 166/232/314; adjudication F4). A document whose automatic retries ran out is
+still OWED: its content outcome was never delivered. Through the real coordinator:
+
+  * the run stays partial, with an accurate ``retry_exhausted`` backlog diagnostic;
+  * no complete-snapshot reconciliation is submitted — absence is never inferred around it, so
+    nothing the brain holds is purged — however many runs pass;
+  * once the document is readable again and an Admin re-arms it (Run now / Retry), the connection
+    converges: the document is delivered and the complete snapshot is reconciled.
+
+This pins the conservative gate F4 requires to stay; it is not a change of behaviour.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.gdrive_sync import _MAX_AUTOMATIC_ATTEMPTS, run_gdrive_stream
+from aios_ingest.state import StateStore
+from test_checkpoint_acknowledgment import CONNECTION, DOCS, SETTINGS, world
+
+
+def _complete_snapshots(w) -> list[dict]:
+    return [call for call in w.reconciles if "complete_snapshot_ids" in call]
+
+
+@pytest.mark.asyncio
+async def test_an_exhausted_document_keeps_the_run_partial_and_never_reconciles_absence(tmp_path, monkeypatch):
+    w = world(monkeypatch)
+    w.unreadable = {"b1"}
+    monkeypatch.setattr("aios_ingest.gdrive_sync._backoff_seconds", lambda *_args, **_kwargs: 0)
+    path = str(tmp_path / "exhaust.sqlite")
+
+    last = None
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS + 2):
+        state = StateStore(path)
+        last = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+        state.close()
+
+    assert last.failure_categories.get("retry_exhausted") == 1
+    assert last.authoritative_complete is False
+    assert last.backlog is not None and last.backlog >= 1
+    assert _complete_snapshots(w) == []  # no absence was ever submitted around the owed document
+    state = StateStore(path)
+    owed = state._db.execute(
+        "SELECT item_key, exhausted_at FROM pending_work WHERE acknowledged_at IS NULL AND superseded_at IS NULL",
+    ).fetchall()
+    assert [(row[0], row[1] is not None) for row in owed] == [("b1", True)]
+    state.close()
+
+    # Repaired, and re-armed by an explicit Admin run: the connection converges.
+    w.unreadable = set()
+    state = StateStore(path)
+    monkeypatch.setitem(CONNECTION.options, "rearm_exhausted", True)
+    repaired = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    monkeypatch.delitem(CONNECTION.options, "rearm_exhausted")
+    assert "retry_exhausted" not in repaired.failure_categories
+    assert repaired.authoritative_complete is True
+    [snapshot] = _complete_snapshots(w)
+    assert sorted(snapshot["complete_snapshot_ids"]) == sorted(doc for docs in DOCS.values() for doc in docs)
+    state.close()
diff --git a/ingestion/tests/test_explicit_trash_evidence.py b/ingestion/tests/test_explicit_trash_evidence.py
new file mode 100644
index 00000000..ccc995b7
--- /dev/null
+++ b/ingestion/tests/test_explicit_trash_evidence.py
@@ -0,0 +1,171 @@
+"""Explicit document trash is verified removal evidence, apart from ambiguous absence (AIO-1167 R51 final 2).
+
+Spec (accepted-spec AC-05/06; Astra 20:01 UTC adjudication, finding 2). Through the real coordinator
+over ``_DriveWorld`` (the brain's claims modelled by ``_ClaimLedger``; the real PostgreSQL owner is
+pinned in ``test/datamechanics/gdrive-audience-claims.datamechanics.test.ts``):
+
+  * a nested document whose selected PARENT root is under a provider restriction, then explicitly
+    trashed, gets a durable removal obligation carrying the trash evidence and is reconciled promptly
+    through the claim-aware owner — with ZERO reads of the restricted root or the document. The
+    reporting connection's claim is retired; the last claim suppresses the content; another
+    connection's valid claim survives; the restriction itself is untouched;
+  * the evidence survives a failed sink acknowledgment and a restart, and the replay reads nothing;
+  * an unresolved selected root (an unknown roster) and a restriction on the document itself do not
+    send verified trash back to a probe;
+  * an ambiguous ``removed`` hint under the restricted parent is NOT trash evidence: it stays on the
+    absence gates, nothing is removed and nothing is read.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from aios_ingest.brain_client import BrainError
+from aios_ingest.state import StateStore
+from test_document_restrictions import GEN, clock, run  # noqa: F401 (clock is a fixture)
+from test_gdrive_upgrade import _ClaimLedger, _DriveWorld, _ProviderHttpError
+
+FAR = "2999-01-01T00:00:00+00:00"
+DRIVE = "shared-a"
+RESTRICTED_READS = {("metadata", "folder-r"), ("list", DRIVE, "folder-r"), ("list", DRIVE, "folder-n")}
+
+
+def _nested_world(monkeypatch, *, file_ids=()):
+    world = _DriveWorld(file_ids=list(file_ids), folder_ids=["folder-r"]).install(monkeypatch)
+    world.ledger = _ClaimLedger()
+    world.put("folder-r", drive=DRIVE, folder=True)
+    world.put("folder-n", drive=DRIVE, parent="folder-r", folder=True)
+    world.put("doc-n", drive=DRIVE, parent="folder-n")
+    world.put("doc-d", drive=DRIVE, parent="folder-r")
+    return world
+
+
+def _restrict(state, world, resource):
+    state.restrict_document(world.integration_id, GEN, "account", resource, FAR, "provider_unavailable")
+
+
+def _trash(world, doc):
+    world.files[doc]["trashed"] = True
+    world.logs.setdefault(DRIVE, []).append({"fileId": doc, "file": dict(world.files[doc])})
+
+
+def _reads_of(world, doc):
+    return [call for call in world.calls if call in (("metadata", doc), ("doc", doc))]
+
+
+def _owed_removal_payload(state, world, doc):
+    row = state._db.execute(
+        "SELECT payload FROM pending_work WHERE namespace=? AND generation=? AND item_key=? "
+        "AND action='remove' AND acknowledged_at IS NULL AND superseded_at IS NULL",
+        (world.namespace(DRIVE), GEN, doc),
+    ).fetchone()
+    return None if row is None else json.loads(row[0])
+
+
+@pytest.mark.parametrize("other_claim", [False, True], ids=["last-claim", "overlap"])
+@pytest.mark.asyncio
+async def test_explicit_trash_under_a_restricted_parent_is_reconciled_without_a_read(
+    tmp_path, monkeypatch, clock, other_claim,
+):
+    world = _nested_world(monkeypatch)
+    if other_claim:
+        world.ledger.push("another-connection", "doc-n")
+    state = StateStore(str(tmp_path / f"parent-{other_claim}.sqlite"))
+    assert (await run(world, state)).authoritative_complete is True
+    _restrict(state, world, "folder-r")
+
+    _trash(world, "doc-n")
+    world.calls.clear()
+    world.pushed.clear()
+    await run(world, state)
+
+    assert not RESTRICTED_READS & set(world.calls)  # the restricted root is never read
+    assert _reads_of(world, "doc-n") == []  # nor the document
+    assert "doc-n" in world.removed  # reconciled promptly through the claim-aware owner
+    assert (world.integration_id, "doc-n") in world.ledger.retired
+    if other_claim:
+        assert world.ledger.claims["doc-n"] == {"another-connection"}  # a valid claim survives
+        assert "doc-n" not in world.ledger.deleted
+    else:
+        assert "doc-n" in world.ledger.deleted  # the last claim: the content is suppressed
+    assert "doc-n" not in world.pushed  # nothing restored
+    assert "folder-r" in state.document_restrictions(world.integration_id, GEN, "account")
+    assert "doc-d" not in world.removed  # the parent's other content is untouched
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_trash_evidence_survives_a_failed_sink_acknowledgment_and_a_restart(tmp_path, monkeypatch, clock):
+    from datetime import timedelta
+
+    world = _nested_world(monkeypatch)
+    path = str(tmp_path / "sink-failure.sqlite")
+    state = StateStore(path)
+    assert (await run(world, state)).authoritative_complete is True
+    _restrict(state, world, "folder-r")
+    _trash(world, "doc-n")
+    world.removal_faults = [BrainError(503, "server_error", "sink unavailable")]
+
+    await run(world, state)
+
+    assert "doc-n" not in world.removed
+    payload = _owed_removal_payload(state, world, "doc-n")
+    assert payload is not None and payload.get("trashed") is True  # the evidence is durable
+    state.close()
+
+    state = StateStore(path)  # restart
+    clock.at += timedelta(minutes=1)
+    world.calls.clear()
+    await run(world, state)
+    assert "doc-n" in world.removed
+    assert not RESTRICTED_READS & set(world.calls) and _reads_of(world, "doc-n") == []
+    assert _owed_removal_payload(state, world, "doc-n") is None
+    state.close()
+
+
+@pytest.mark.parametrize("restrict_document", [False, True], ids=["unknown-roster", "document-restricted"])
+@pytest.mark.asyncio
+async def test_an_unknown_roster_or_a_document_restriction_never_sends_trash_back_to_a_probe(
+    tmp_path, monkeypatch, clock, restrict_document,
+):
+    # A selected root that never resolved leaves the roster unknown: an ambiguous removal would need
+    # a probe of the document itself — verified trash does not.
+    world = _nested_world(monkeypatch, file_ids=["file-u"])
+    world.unreadable["file-u"] = _ProviderHttpError(404)
+    state = StateStore(str(tmp_path / f"peer-{restrict_document}.sqlite"))
+    await run(world, state)
+    assert "doc-d" in world.pushed
+    if restrict_document:
+        _restrict(state, world, "doc-d")
+
+    _trash(world, "doc-d")
+    world.calls.clear()
+    await run(world, state)
+
+    assert _reads_of(world, "doc-d") == []
+    assert "doc-d" in world.removed
+    assert (world.integration_id, "doc-d") in world.ledger.retired
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_an_ambiguous_removed_hint_under_a_restricted_parent_is_not_trash_evidence(
+    tmp_path, monkeypatch, clock,
+):
+    world = _nested_world(monkeypatch)
+    state = StateStore(str(tmp_path / "ambiguous.sqlite"))
+    assert (await run(world, state)).authoritative_complete is True
+    _restrict(state, world, "folder-r")
+
+    # No file body: a removal, a move, or lost access — not the document's own trash.
+    world.logs.setdefault(DRIVE, []).append({"fileId": "doc-n", "removed": True})
+    world.calls.clear()
+    await run(world, state)
+
+    assert "doc-n" not in world.removed
+    assert (world.integration_id, "doc-n") not in world.ledger.retired
+    assert not RESTRICTED_READS & set(world.calls) and _reads_of(world, "doc-n") == []
+    assert _owed_removal_payload(state, world, "doc-n") is None  # no trash-bearing obligation
+    state.close()
diff --git a/ingestion/tests/test_flush_authority_outcome.py b/ingestion/tests/test_flush_authority_outcome.py
new file mode 100644
index 00000000..e6966a87
--- /dev/null
+++ b/ingestion/tests/test_flush_authority_outcome.py
@@ -0,0 +1,405 @@
+"""A terminal authority refusal at an orderly-return checkpoint keeps the run's outcome (AIO-1167
+R51 L1).
+
+Spec (Astra R51 Low adjudication, L1). When publishing unpublished hold or restriction evidence at
+an orderly return is refused with ``stale_execution`` or ``connection_unavailable``, the run's
+accumulated summary is NOT replaced by a generic ``coordinator_error``: the hold category, any
+progress made, the authority code (once) and the applicable unpublished categories are reported;
+an existing cause is kept beside it. The local journal keeps the evidence; nothing further is read
+or sent under the lost authority; the lease is still released. Scheduled and manual reports carry
+that summary, status follows the ordinary classification, and a connection paused or disconnected
+meanwhile is still not reported.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.brain_client import BrainError, GdriveExecution
+from aios_ingest.config import Connection
+from aios_ingest.engine import IngestSummary
+from aios_ingest.gdrive_sync import _flush_restriction_evidence
+from aios_ingest.scheduler import _gdrive_outcome_status, _manual_gdrive_job, _poll_job
+from aios_ingest.state import StateStore
+from test_document_restrictions import _world as _folder_world
+from test_document_restrictions import clock, run  # noqa: F401 (clock is a fixture)
+from test_gdrive_poll_reporting import MANUAL_CLAIM, SETTINGS, Brain, brain, row  # noqa: F401 (brain is a fixture)
+from test_gdrive_upgrade import _DriveWorld, _ProviderHttpError
+from test_restriction_publication_recovery import _two_root_world
+from test_root_evidence_r49 import real_deferral
+
+GEN = 9
+LONG = "99999999"
+CODES = ["stale_execution", "connection_unavailable"]
+
+
+def _refuse(code, refusals):
+    def fault(_payload):
+        refusals.append(1)
+        return BrainError(409, code, "refused")
+    return fault
+
+
+async def _refused_standing_hold(world, state, monkeypatch, code):
+    """A hold and a resource minimum kept only locally, then a reacquisition whose repair is refused."""
+    import aios_ingest.gdrive_sync as sync
+
+    world.unreadable["file-a"] = real_deferral(503, LONG)
+    world.unreadable["file-b"] = real_deferral(429, "3600")
+    world.checkpoint_faults.append(lambda _payload: BrainError(503, "server_error", "brain unavailable"))
+    await world.run(state)
+    assert "account_hold" not in world.progress
+
+    released: list[int] = []
+
+    async def release(self, execution):
+        released.append(execution.fence)
+
+    monkeypatch.setattr(sync.BrainClient, "release_gdrive_execution", release)
+    refusals: list[int] = []
+    later: list[int] = []
+    world.checkpoint_faults.extend([_refuse(code, refusals), lambda _payload: later.append(1)])
+    revision = world.revision
+    world.calls.clear()
+    summary = await world.run(state)
+    return summary, released, refusals, later, revision
+
+
+@pytest.mark.parametrize("code", CODES)
+@pytest.mark.asyncio
+async def test_a_terminal_refusal_at_standing_hold_repair_keeps_the_hold_outcome(tmp_path, monkeypatch, clock, code):
+    world = _two_root_world(monkeypatch)
+    state = StateStore(str(tmp_path / f"standing-{code}.sqlite"))
+
+    summary, released, refusals, later, revision = await _refused_standing_hold(world, state, monkeypatch, code)
+
+    assert summary.failure_categories == {
+        "rate_limited": 1, code: 1, "account_hold_unpublished": 1, "document_restriction_unpublished": 1,
+    }
+    assert "coordinator_error" not in summary.failure_categories
+    assert summary.skipped == 1 and summary.failed == 1
+    assert world.calls == []  # no provider read under the hold or after the refusal
+    assert refusals == [1] and later == [] and world.revision == revision  # no later checkpoint
+    assert released  # the lease is still released
+    assert state.connection_hold(world.integration_id, GEN, "account") is not None  # kept locally
+    assert "file-a" in state.document_restrictions(world.integration_id, GEN, "account")
+    assert "account_hold" not in world.progress  # never claimed published
+    state.close()
+
+
+@pytest.mark.parametrize("code", CODES)
+@pytest.mark.asyncio
+async def test_scheduled_and_manual_reports_carry_the_hold_outcome_not_a_coordinator_error(
+    tmp_path, monkeypatch, clock, brain, code,
+):
+    world = _two_root_world(monkeypatch)
+    state = StateStore(str(tmp_path / f"report-{code}.sqlite"))
+    summary, *_ = await _refused_standing_hold(world, state, monkeypatch, code)
+
+    async def the_run(_settings, _connection, _state):
+        return summary
+
+    monkeypatch.setattr("aios_ingest.scheduler.run_gdrive_stream", the_run)
+    expected_error = ", ".join(sorted(summary.failure_categories))
+    integration = summary.integration_id
+    connection = Connection("local-docs", "gdrive", options={"integration_id": integration})
+
+    # Scheduled: the connection is still enabled when re-read, so the outcome is reported as is.
+    scheduled = brain(Brain(rows=[row(integration_id=integration)]))
+    await _poll_job(SETTINGS, connection, state)
+    [report] = scheduled.reports()
+    assert report["error"] == expected_error and "coordinator_error" not in report["error"]
+    assert report["status"] == _gdrive_outcome_status(summary)
+    assert (report["failed"], report["skipped"]) == (1, 1)
+
+    # Manual (Run now / Retry): the claimed request completes with the same outcome.
+    manual = brain(Brain(rows=[row(integration_id=integration)], claim=MANUAL_CLAIM))
+    await _manual_gdrive_job(SETTINGS, [], state)
+    [completion] = manual.reports()
+    assert completion["error"] == expected_error and completion["status"] == _gdrive_outcome_status(summary)
+
+    # Paused or disconnected meanwhile: the scheduled re-read still reports nothing.
+    paused = brain(Brain(rows=[
+        [row("enabled", integration_id=integration)], [row("disabled", integration_id=integration)],
+    ]))
+    await _poll_job(SETTINGS, connection, state)
+    assert paused.reports() == []
+    state.close()
+
+
+@pytest.mark.parametrize("code", CODES)
+@pytest.mark.asyncio
+async def test_a_terminal_refusal_of_the_drain_hold_checkpoint_keeps_progress_and_the_hold(
+    tmp_path, monkeypatch, clock, code,
+):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / f"drain-{code}.sqlite"))
+    assert (await run(world, state)).authoritative_complete is True
+
+    for doc in ("doc-a", "doc-b"):  # doc-a drains first, then doc-b's read is the quota answer
+        world.files[doc]["modifiedTime"] = "2026-10-01T00:00:00Z"
+        world.logs["shared-a"].append({"fileId": doc, "file": dict(world.files[doc])})
+    world.unreadable["doc-b"] = real_deferral(429, "3600")
+    refusals: list[int] = []
+    later: list[int] = []
+
+    def refuse_hold(payload):
+        if refusals:
+            later.append(1)
+            return None
+        if payload.get("account_hold"):
+            refusals.append(1)
+            return BrainError(409, code, "refused")
+        return None
+
+    world.checkpoint_faults.extend([refuse_hold] * 5)
+    world.pushed.clear()
+    world.calls.clear()
+    summary = await run(world, state)
+
+    assert "doc-a" in world.pushed and summary.created + summary.updated >= 1  # progress kept
+    assert summary.failed == 1  # no earlier run charge: the refusal is this run's one failure
+    assert summary.failure_categories.get("rate_limited") == 1
+    assert summary.failure_categories.get(code) == 1
+    assert summary.failure_categories.get("account_hold_unpublished") == 1
+    assert "coordinator_error" not in summary.failure_categories
+    assert _gdrive_outcome_status(summary) == "partial"  # progress beside the refusal
+    assert world.calls[-1] == ("metadata", "doc-b")  # nothing read after the quota answer
+    assert refusals == [1] and later == []  # and nothing sent after the refusal
+    assert state.connection_hold(world.integration_id, GEN, "account") is not None
+    state.close()
+
+
+class _RefusingClient:
+    def __init__(self, code):
+        self.code, self.sent = code, 0
+
+    def gdrive_progress_uncertain(self, _execution):
+        return False
+
+    async def checkpoint_gdrive_execution(self, _execution, _payload):
+        self.sent += 1
+        raise BrainError(409, self.code, "refused")
+
+
+@pytest.mark.parametrize("code", CODES)
+@pytest.mark.asyncio
+async def test_the_end_of_run_flush_keeps_accumulated_progress_and_an_existing_cause(tmp_path, code):
+    state = StateStore(str(tmp_path / f"flush-{code}.sqlite"))
+    state.hold_connection("conn", 2, "account", "2099-01-01T00:00:00+00:00", "rate_limited")
+    execution = GdriveExecution("conn", 2, 1, "owner", "later", "scope", {}, progress={})
+
+    # No earlier cause: the accumulated progress stays, the refusal is added once, nothing raises.
+    client = _RefusingClient(code)
+    total = IngestSummary("docs", created=3, updated=1, failure_categories={"provider_unavailable": 1})
+    await _flush_restriction_evidence(client, execution, state, "account", total)
+    assert (total.created, total.updated) == (3, 1)
+    assert total.failure_categories == {"provider_unavailable": 1, code: 1, "account_hold_unpublished": 1}
+    assert total.failed == 1 and client.sent == 1
+
+    # An existing nonterminal cause stays reported beside the flush's authority code — and the one
+    # terminating run it already charged is not charged again (R51 Note A).
+    cause = BrainError(503, "server_error", "brain unavailable")
+    caused = IngestSummary("docs", failed=1, failure_categories={"server_error": 1})
+    await _flush_restriction_evidence(
+        _RefusingClient(code), execution, state, "account", caused, cause=cause,
+        run_failure_counted=True,  # the caller already charged this run (it set `failed=1` above)
+    )
+    assert caused.failure_categories == {"server_error": 1, code: 1, "account_hold_unpublished": 1}
+    assert caused.failed == 1
+    state.close()
+
+
+@pytest.mark.parametrize("code", CODES)
+@pytest.mark.asyncio
+async def test_a_document_failure_already_in_the_total_never_suppresses_the_flush_authority_charge(
+    tmp_path, code,
+):
+    """R51 Fable F1 / control #3, at the helper's own charge decision: the total ALREADY holds an
+    independent document failure (no run charge, no authority category) when the flush is refused,
+    and the caller passes no ``cause`` and no ``run_failure_counted`` (default false). The refusal
+    is still this run's one charge, so ``failed`` goes from 1 to 2. A charge inferred from
+    ``total.failed > 0`` would leave it at 1. This is helper-level coverage of that decision; the
+    stream-level fixture below remains separate preservation coverage."""
+    state = StateStore(str(tmp_path / f"flush-document-failure-{code}.sqlite"))
+    held = state.hold_connection("conn", 2, "account", "2099-01-01T00:00:00+00:00", "rate_limited")
+    execution = GdriveExecution("conn", 2, 1, "owner", "later", "scope", {}, progress={})
+    client = _RefusingClient(code)
+    total = IngestSummary("docs", failed=1, failure_categories={"incomplete_extraction": 1})
+
+    await _flush_restriction_evidence(client, execution, state, "account", total)
+
+    assert total.failed == 2
+    assert total.failure_categories == {"incomplete_extraction": 1, code: 1, "account_hold_unpublished": 1}
+    assert client.sent == 1
+    assert state.connection_hold("conn", 2, "account") == held  # the local hold is retained
+    state.close()
+
