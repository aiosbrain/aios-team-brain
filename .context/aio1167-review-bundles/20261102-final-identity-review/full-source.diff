+++ b/ingestion/tests/test_bound_root_loss.py
@@ -0,0 +1,279 @@
+"""A previously bound selected root's verified loss has a durable outcome (AIO-1167 R48 D1).
+
+Spec (accepted-spec AC-03/05/07; Astra R47 adjudication D1). Through the real coordinator over the
+``_DriveWorld`` double (Google and the brain as the coordinator's own calls see them):
+
+  * a bound folder root that is hard-deleted — its OWN metadata answers 404 — is recorded as
+    unavailable (bound, with an actionable detail that travels in the fenced root evidence). Its
+    traversal is finished without listing it, the rescan publishes, the cursor advances, and no
+    generic ``provider_read`` is reported — even when Google answers the folder's listing 404;
+  * a bound file root that disappears before a 410 rescan finishes its page empty the same way;
+  * only that root's support is retired: a directly selected document under it, another root's
+    documents and another connection's claim all survive;
+  * completion is restart-safe, and a fresh state file restoring the brain re-derives it;
+  * another root that cannot be verified keeps the run partial and withholds scope-wide absence;
+    an auth / permission / server error on the root, a listing 404 of a folder that exists, and a
+    never-bound root are never treated as loss;
+  * a restored root is enumerated again, under the same provider identity, once it can be read.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.sources.gdrive import ProviderCursorInvalid
+from aios_ingest.state import StateStore
+from test_gdrive_upgrade import _ClaimLedger, _DriveWorld, _ProviderHttpError
+
+GEN = 9
+DETAIL = "selected root unavailable"
+
+
+def _binding(state, world, kind, root_id):
+    return state.root_obligations(world.integration_id, GEN).get((kind, root_id))
+
+
+def _remote_root(world, kind, root_id):
+    return next(
+        item for item in world.progress["roots"]["items"]
+        if item["kind"] == kind and item["id"] == root_id
+    )
+
+
+def _folder_world(monkeypatch, *, file_ids=("doc-1",)):
+    """``folder-r`` (doc-1, and folder-n holding doc-2) and ``folder-k`` (doc-k) in one Shared Drive;
+    doc-1 is also selected directly."""
+    world = _DriveWorld(file_ids=list(file_ids), folder_ids=["folder-r", "folder-k"]).install(monkeypatch)
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("folder-n", drive="shared-a", parent="folder-r", folder=True)
+    world.put("folder-k", drive="shared-a", folder=True)
+    world.put("doc-1", drive="shared-a", parent="folder-r")
+    world.put("doc-2", drive="shared-a", parent="folder-n")
+    world.put("doc-k", drive="shared-a", parent="folder-k")
+    world.missing_folder_listing_404 = True
+    return world
+
+
+def _delete_folder_r(world):
+    """folder-r is hard-deleted for this account; doc-1 stays shared directly with it."""
+    for gone in ("folder-r", "folder-n", "doc-2"):
+        world.files.pop(gone)
+    world.logs.setdefault("shared-a", []).append({"fileId": "folder-r", "removed": True})
+
+
+@pytest.mark.asyncio
+async def test_a_hard_deleted_bound_folder_root_completes_its_rescan_and_retires_only_its_support(
+    tmp_path, monkeypatch,
+):
+    world = _folder_world(monkeypatch)
+    world.ledger = _ClaimLedger()
+    world.ledger.push("another-connection", "doc-2")  # another connection also claims doc-2
+    path = str(tmp_path / "folder-loss.sqlite")
+    state = StateStore(path)
+    namespace = world.namespace("shared-a")
+    assert (await world.run(state)).authoritative_complete is True
+    assert world.reconciled == [["doc-1", "doc-2", "doc-k"]]
+
+    _delete_folder_r(world)
+    world.calls.clear()
+    world.pushed.clear()
+    # The tombstone page: doc-2 (under folder-r only) is a positive removal, and a rescan is seeded.
+    seeded = await world.run(state)
+    assert seeded.authoritative_complete is False
+    assert state.next_uncommitted_page(namespace, GEN).rescan_snapshot_id is not None
+    # The rescan, on the next run.
+    summary = await world.run(state)
+
+    # The deleted root was read once, positively not found, and never listed.
+    assert ("metadata", "folder-r") in world.calls
+    assert not any(call[0] == "list" and call[2] in ("folder-r", "folder-n") for call in world.calls)
+    assert "provider_read" not in summary.failure_categories
+    assert summary.failure_categories.get("selection_root_unavailable") == 1
+    # The rescan published and the cursor passed the tombstone page.
+    progress = state.get_progress(namespace)
+    assert progress.building_snapshot is None and progress.listing_complete is True
+    assert state.next_uncommitted_page(namespace, GEN) is None
+    # Only folder-r's support is retired: the direct selection and the other root stand.
+    assert state.membership_ids(namespace, GEN) == ["doc-1", "doc-k"]
+    assert summary.authoritative_complete is True
+    assert world.reconciled[-1] == ["doc-1", "doc-k"]
+    assert "doc-1" not in world.removed and "doc-k" not in world.removed
+    # Another connection's claim on doc-2 survives this connection's reconciliation.
+    assert ("another-connection" in world.ledger.claims["doc-2"]) and "doc-2" not in world.ledger.deleted
+    # The outcome is durable root evidence, locally and on the brain, with an actionable detail.
+    binding = _binding(state, world, "folder", "folder-r")
+    assert binding.status == "bound" and DETAIL in (binding.detail or "")
+    assert DETAIL in (_remote_root(world, "folder", "folder-r")["detail"] or "")
+    state.close()
+
+    assert "doc-2" not in world.pushed  # the lost root's document is never re-ingested
+
+    # Restart: nothing is re-listed, nothing is re-pushed, and it stays complete.
+    state = StateStore(path)
+    world.calls.clear()
+    world.pushed.clear()
+    again = await world.run(state)
+    assert not any(call[0] == "list" and call[2] == "folder-r" for call in world.calls)
+    assert "provider_read" not in again.failure_categories
+    assert world.pushed == []
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_fresh_state_file_re_derives_the_lost_roots_outcome_from_the_brain(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "first.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    _delete_folder_r(world)
+    await world.run(state)  # tombstone page; rescan seeded
+    assert (await world.run(state)).authoritative_complete is True
+    state.close()
+
+    fresh = StateStore(str(tmp_path / "fresh.sqlite"))
+    world.calls.clear()
+    restored = await world.run(fresh)
+    assert not any(call[0] == "list" and call[2] in ("folder-r", "folder-n") for call in world.calls)
+    assert "provider_read" not in restored.failure_categories
+    assert restored.failed == 0
+    assert "doc-2" not in world.reconciled[-1]
+    fresh.close()
+
+
+@pytest.mark.asyncio
+async def test_a_bound_file_root_lost_before_a_410_rescan_finishes_its_page_empty(tmp_path, monkeypatch):
+    world = _DriveWorld(file_ids=["file-x", "file-y"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    path = str(tmp_path / "file-loss.sqlite")
+    state = StateStore(path)
+    namespace = world.namespace("shared-a")
+    assert (await world.run(state)).authoritative_complete is True
+    assert world.reconciled == [["file-x", "file-y"]]
+
+    world.files.pop("file-x")
+    world.cursor_errors["shared-a"] = ProviderCursorInvalid("expired")
+    assert (await world.run(state)).failure_categories.get("invalid_cursor") == 1
+    world.cursor_errors.clear()
+    world.pushed.clear()
+    summary = await world.run(state)
+
+    assert "provider_read" not in summary.failure_categories
+    assert summary.failure_categories.get("selection_root_unavailable") == 1
+    assert state.next_uncommitted_page(namespace, GEN) is None
+    assert state.membership_ids(namespace, GEN) == ["file-y"]
+    assert summary.authoritative_complete is True and world.reconciled[-1] == ["file-y"]
+    assert "file-x" not in world.pushed
+    assert DETAIL in (_binding(state, world, "file", "file-x").detail or "")
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_another_unverifiable_root_keeps_the_run_partial_and_withholds_absence(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "partial.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    _delete_folder_r(world)
+    world.unreadable["folder-k"] = _ProviderHttpError(500)  # the other root cannot be read now
+    await world.run(state)  # tombstone page; rescan seeded
+    for _ in range(2):  # the rescan meets the unverifiable root, run after run
+        summary = await world.run(state)
+        assert summary.authoritative_complete is False
+        assert world.reconciled == reconciled  # no scope-wide absence
+    # The other root's documents keep their claims; only the positive tombstone removal flowed.
+    assert "doc-k" not in world.removed and "doc-1" not in world.removed
+    state.close()
+
+
+@pytest.mark.parametrize("status", [401, 403, 500])
+@pytest.mark.asyncio
+async def test_an_auth_permission_or_server_error_on_the_root_is_never_loss(tmp_path, monkeypatch, status):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / f"err-{status}.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    # The change log reports the folder, but its metadata answers an error that proves nothing.
+    world.logs.setdefault("shared-a", []).append({"fileId": "folder-r", "file": dict(world.files["folder-r"])})
+    world.unreadable["folder-r"] = _ProviderHttpError(status)
+    world.calls.clear()
+    for _ in range(3):  # the change page, then the rescan that reads the root, run after run
+        summary = await world.run(state)
+        assert "selection_root_unavailable" not in summary.failure_categories
+        assert summary.authoritative_complete is False
+    assert ("metadata", "folder-r") in world.calls  # the root really was read
+    binding = _binding(state, world, "folder", "folder-r")
+    assert DETAIL not in (binding.detail or "")
+    assert world.reconciled == reconciled and world.removed == []
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_listing_404_of_a_folder_that_exists_is_not_absence(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "listing-404.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    def listing_404():
+        raise _ProviderHttpError(404)
+
+    world.logs.setdefault("shared-a", []).append({"fileId": "folder-n", "file": dict(world.files["folder-n"])})
+    world.hooks[("list", "shared-a", "folder-r")] = listing_404
+    world.calls.clear()
+    outcomes = [await world.run(state), await world.run(state)]
+
+    assert ("list", "shared-a", "folder-r") in world.calls  # the rescan listed it, and was refused
+    assert all("selection_root_unavailable" not in o.failure_categories for o in outcomes)
+    assert outcomes[1].authoritative_complete is False
+    assert world.reconciled == reconciled and world.removed == []
+    assert DETAIL not in (_binding(state, world, "folder", "folder-r").detail or "")
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_never_bound_root_404_stays_unresolved_not_lost(tmp_path, monkeypatch):
+    world = _DriveWorld(folder_ids=["folder-ghost", "folder-k"]).install(monkeypatch)
+    world.put("folder-k", drive="shared-a", folder=True)
+    world.put("doc-k", drive="shared-a", parent="folder-k")
+    state = StateStore(str(tmp_path / "ghost.sqlite"))
+
+    summary = await world.run(state)
+
+    assert summary.failure_categories.get("selection_root_unresolved") == 1
+    assert "selection_root_unavailable" not in summary.failure_categories
+    assert _binding(state, world, "folder", "folder-ghost").status == "unresolved"
+    assert summary.authoritative_complete is False and world.reconciled == []
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_restored_root_is_enumerated_again_under_the_same_identity(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "restore.sqlite"))
+    namespace = world.namespace("shared-a")
+    assert (await world.run(state)).authoritative_complete is True
+    _delete_folder_r(world)
+    await world.run(state)  # tombstone page; rescan seeded
+    assert (await world.run(state)).authoritative_complete is True
+    assert "doc-2" not in state.membership_ids(namespace, GEN)
+
+    # Access returns: the folder and its documents are readable again and the log reports it.
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("folder-n", drive="shared-a", parent="folder-r", folder=True)
+    world.put("doc-2", drive="shared-a", parent="folder-n")
+    world.logs["shared-a"].append({"fileId": "folder-r", "file": dict(world.files["folder-r"])})
+    world.pushed.clear()
+    world.calls.clear()
+    restored = await world.run(state)
+    if not restored.authoritative_complete:
+        restored = await world.run(state)  # a page that seeds a rescan publishes on the next run
+
+    assert ("list", "shared-a", "folder-r") in world.calls
+    assert "doc-2" in state.membership_ids(namespace, GEN)
+    assert "doc-2" in world.pushed  # the same provider id: no new content identity
+    binding = _binding(state, world, "folder", "folder-r")
+    assert binding.status == "bound" and not binding.detail
+    assert restored.authoritative_complete is True and "doc-2" in world.reconciled[-1]
+    state.close()
diff --git a/ingestion/tests/test_brain_minimum_provenance.py b/ingestion/tests/test_brain_minimum_provenance.py
new file mode 100644
index 00000000..90b270fc
--- /dev/null
+++ b/ingestion/tests/test_brain_minimum_provenance.py
@@ -0,0 +1,256 @@
+"""Only a minimum the BRAIN named is an external minimum (AIO-1167 R51 L2).
+
+Spec (Astra R51 Low adjudication, L2). ``BrainDeferred.not_before`` is the combined local eligibility
+— the brain's Retry-After when it named one, else the client's own exponential fallback, plus
+jitter. ``BrainDeferred.provider_not_before`` is ONLY the brain-named minimum: absent without a
+header or with a malformed one or for an unanswered request, present for a valid positive or ZERO
+Retry-After. Consumers persist only the brain-named part as ``pending_work.minimum_not_before``:
+
+  * an exhausting sink failure deferred on local fallback leaves no external minimum, and an
+    explicit rearm makes the work eligible at once;
+  * a valid positive Retry-After stays a minimum through rearm; a valid zero is recorded (not
+    confused with no header) and is already elapsed; an earlier minimum is never erased;
+  * non-exhausted work keeps its ordinary backoff;
+  * an accepted document whose checkpoint is deferred keeps its obligation, spends no failure
+    budget, records only a brain-named minimum, and still honours the uncertainty latch.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import datetime, timedelta, timezone
+
+import httpx
+import pytest
+
+from aios_ingest.brain_client import BrainClient, BrainDeferred, BrainError, GdriveExecution, IngestResult
+from aios_ingest.config import Connection
+from aios_ingest.engine import IngestSummary
+from aios_ingest.gdrive_sync import (
+    _MAX_AUTOMATIC_ATTEMPTS, _AcknowledgmentUncertain, _drain_pending, _fail_work, _record_sink_failure,
+)
+from aios_ingest.state import StateStore, StreamKey
+from test_drain_recovery import _PushedSource, _row_work
+
+ERROR = {"error": {"code": "unavailable", "message": "brain unavailable"}}
+
+
+def _at(iso: str) -> datetime:
+    parsed = datetime.fromisoformat(iso.replace("Z", "+00:00"))
+    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
+
+
+def _client(clock: dict) -> BrainClient:
+    async def sleep(delay):
+        clock["t"] += delay
+
+    return BrainClient(
+        "http://brain", "aios_a_b", "team", sleep=sleep, random_fn=lambda: 0.0, monotonic_fn=lambda: clock["t"],
+    )
+
+
+async def _push_deferral(header: str | None) -> BrainDeferred:
+    """The REAL client's deferral for one retryable answer whose wait does not fit the deadline."""
+    async with _client({"t": 0.0}) as client:
+        headers = {} if header is None else {"Retry-After": header}
+        with pytest.raises(BrainDeferred) as raised:
+            await client._backoff(httpx.Response(503, headers=headers, json=ERROR), 7, 0.5)
+    return raised.value
+
+
+async def _timeout_deferral() -> BrainDeferred:
+    async with _client({"t": 0.0}) as client:
+        with pytest.raises(BrainDeferred) as raised:
+            await client._timeout_backoff(BrainError(504, "brain_timeout", "unanswered"), 7, 0.5)
+    return raised.value
+
+
+@pytest.mark.parametrize("header, named", [
+    (None, False), ("soon", False), ("30", True), ("0", True),
+], ids=["no-header", "malformed", "positive", "zero"])
+@pytest.mark.asyncio
+async def test_a_brain_deferral_carries_only_the_brain_named_minimum(header, named):
+    deferral = await _push_deferral(header)
+    now = datetime.now(timezone.utc)
+    assert deferral.not_before is not None  # the combined local eligibility is always there
+    if not named:
+        assert deferral.provider_not_before is None
+        return
+    assert deferral.provider_not_before is not None  # a valid zero is NOT "no header"
+    minimum = _at(deferral.provider_not_before)
+    if header == "0":
+        assert minimum <= now + timedelta(seconds=1)
+    else:
+        assert now + timedelta(seconds=25) < minimum < now + timedelta(seconds=35)
+    assert _at(deferral.not_before) >= minimum
+
+
+@pytest.mark.asyncio
+async def test_an_unanswered_request_fallback_names_no_minimum():
+    deferral = await _timeout_deferral()
+    assert deferral.not_before is not None and deferral.provider_not_before is None
+
+
+@pytest.mark.parametrize("header, named", [(None, False), ("30", True)], ids=["no-header", "positive"])
+@pytest.mark.asyncio
+async def test_a_deferred_checkpoint_carries_only_the_brain_named_minimum_and_latches(header, named):
+    clock = {"t": 0.0}
+    execution = dataclasses.replace(GdriveExecution("conn", 2, 1, "owner", "later", "scope", {}), run_deadline=0.5)
+
+    def handler(_request):
+        return httpx.Response(503, headers={} if header is None else {"Retry-After": header}, json=ERROR)
+
+    async with _client(clock) as client:
+        await client._client.aclose()
+        client._client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+        with pytest.raises(BrainDeferred) as raised:
+            await client.checkpoint_gdrive_execution(execution, {"streams": {}})
+        assert client.gdrive_progress_uncertain(execution) is True  # the latch is unchanged
+    assert raised.value.not_before is not None
+    assert (raised.value.provider_not_before is not None) is named
+
+
+@pytest.fixture()
+def world(tmp_path):
+    state = StateStore(str(tmp_path / "provenance.sqlite"))
+    progress = state.begin_generation(StreamKey("team", "conn", "acct", "my-drive"), 2, start_token="start")
+    yield state, progress.namespace
+    state.close()
+
+
+def _row(state, namespace):
+    return state._db.execute(
+        "SELECT failures, exhausted_at, not_before, minimum_not_before FROM pending_work "
+        "WHERE namespace=? AND item_key='doc' AND acknowledged_at IS NULL AND superseded_at IS NULL",
+        (namespace,),
+    ).fetchone()
+
+
+def _eligible(state, namespace) -> bool:
+    return [work.item_key for work in state.list_pending(namespace, 2)] == ["doc"]
+
+
+async def _exhaust_on(state, namespace, deferral: BrainDeferred) -> None:
+    """Seven ordinary failures, then an eighth that is the sink's deferral."""
+    state.enqueue_work(namespace, 2, "doc", "upsert", {})
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS - 1):
+        _fail_work(state, _row_work(state, namespace), "provider_read")
+    _record_sink_failure(state, _row_work(state, namespace), deferral, IngestSummary("docs", failure_categories={}))
+
+
+@pytest.mark.parametrize("source", ["no-header", "malformed", "timeout"])
+@pytest.mark.asyncio
+async def test_an_exhausting_sink_failure_on_local_fallback_leaves_no_minimum_and_rearm_reads_at_once(
+    world, source,
+):
+    state, namespace = world
+    deferral = await (_timeout_deferral() if source == "timeout" else _push_deferral(None if source == "no-header" else "soon"))
+    await _exhaust_on(state, namespace, deferral)
+
+    row = _row(state, namespace)
+    assert row["exhausted_at"] is not None and row["failures"] == _MAX_AUTOMATIC_ATTEMPTS
+    assert row["minimum_not_before"] is None  # the client's fallback is not an external minimum
+    assert state.rearm_exhausted(namespace, 2) == 1
+    assert _eligible(state, namespace)
+
+
+@pytest.mark.asyncio
+async def test_a_valid_positive_brain_minimum_survives_rearm(world):
+    state, namespace = world
+    deferral = await _push_deferral("30")
+    await _exhaust_on(state, namespace, deferral)
+
+    assert _at(_row(state, namespace)["minimum_not_before"]) == _at(deferral.provider_not_before)
+    state.rearm_exhausted(namespace, 2)
+    assert not _eligible(state, namespace)
+
+
+@pytest.mark.asyncio
+async def test_a_valid_zero_brain_minimum_is_recorded_and_already_elapsed(world):
+    state, namespace = world
+    await _exhaust_on(state, namespace, await _push_deferral("0"))
+
+    assert _row(state, namespace)["minimum_not_before"] is not None  # distinguishable from no header
+    state.rearm_exhausted(namespace, 2)
+    assert _eligible(state, namespace)
+
+
+@pytest.mark.asyncio
+async def test_an_earlier_brain_minimum_is_never_erased_by_a_later_local_fallback(world):
+    state, namespace = world
+    named = await _push_deferral("30")
+    state.enqueue_work(namespace, 2, "doc", "upsert", {})
+    _record_sink_failure(state, _row_work(state, namespace), named, IngestSummary("docs", failure_categories={}))
+    fallback = await _push_deferral(None)
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS - 1):
+        _record_sink_failure(state, _row_work(state, namespace), fallback, IngestSummary("docs", failure_categories={}))
+
+    row = _row(state, namespace)
+    assert row["exhausted_at"] is not None
+    assert _at(row["minimum_not_before"]) == _at(named.provider_not_before)
+    state.rearm_exhausted(namespace, 2)
+    assert not _eligible(state, namespace)
+
+
+@pytest.mark.asyncio
+async def test_non_exhausted_work_keeps_its_ordinary_backoff(world):
+    state, namespace = world
+    state.enqueue_work(namespace, 2, "doc", "upsert", {})
+    _record_sink_failure(
+        state, _row_work(state, namespace), await _push_deferral(None), IngestSummary("docs", failure_categories={}),
+    )
+    assert state.rearm_exhausted(namespace, 2) == 0
+    assert _row(state, namespace)["minimum_not_before"] is None
+    assert not _eligible(state, namespace)  # still inside its backoff
+
+
+class _CheckpointDeferringBrain:
+    """Accepts the document; its checkpoint is deferred with ``deferral``."""
+
+    def __init__(self, deferral: BrainDeferred, *, uncertain: bool = False):
+        self.deferral, self.uncertain, self.pushes = deferral, uncertain, []
+
+    async def push(self, item, *, execution=None):
+        self.pushes.append(item.path)
+        return IngestResult(status="created", id="item-1", path=item.path)
+
+    async def checkpoint_gdrive_execution(self, execution, payload):
+        raise self.deferral
+
+    def gdrive_progress_uncertain(self, execution):
+        return self.uncertain
+
+
+@pytest.mark.parametrize("named", [False, True], ids=["local-only", "brain-named"])
+@pytest.mark.parametrize("uncertain", [False, True], ids=["acknowledged-refusal", "latched"])
+@pytest.mark.asyncio
+async def test_an_accepted_documents_deferred_checkpoint_records_only_a_brain_named_minimum(
+    world, named, uncertain,
+):
+    state, namespace = world
+    state.enqueue_work(namespace, 2, "doc", "upsert", {})
+    later = (datetime.now(timezone.utc) + timedelta(minutes=10)).isoformat()
+    minimum = (datetime.now(timezone.utc) + timedelta(minutes=5)).isoformat() if named else None
+    brain = _CheckpointDeferringBrain(
+        BrainDeferred(503, "server_error", "deferred", not_before=later, provider_not_before=minimum),
+        uncertain=uncertain,
+    )
+    summary = IngestSummary("docs", failure_categories={})
+    execution = GdriveExecution("conn", 2, 1, "owner", "later", "scope", {})
+    conn = Connection("docs", "gdrive", options={}, project="docs")
+
+    if uncertain:
+        with pytest.raises(_AcknowledgmentUncertain):  # the latch still stops the run
+            await _drain_pending(brain, execution, _PushedSource(), conn, state, namespace, 2, summary, 10)
+    else:
+        await _drain_pending(brain, execution, _PushedSource(), conn, state, namespace, 2, summary, 10)
+
+    row = _row(state, namespace)
+    assert brain.pushes and row is not None  # accepted, and its acknowledgment is still owed
+    assert row["failures"] == 0 and row["exhausted_at"] is None  # no failure budget spent
+    assert _at(row["not_before"]) >= _at(later)
+    if named:
+        assert _at(row["minimum_not_before"]) == _at(minimum)
+    else:
+        assert row["minimum_not_before"] is None
+    assert state.pending_count(namespace, 2) == 1
