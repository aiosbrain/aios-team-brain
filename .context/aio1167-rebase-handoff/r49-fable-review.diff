+
+    summary = await world.run(state)
+
+    assert summary.failure_categories.get("selection_root_unresolved") == 1
+    assert "selection_root_unavailable" not in summary.failure_categories
+    assert _binding(state, world, "folder", "folder-ghost").status == "unresolved"
+    assert summary.authoritative_complete is False and world.reconciled == []
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_restored_root_is_enumerated_again_under_the_same_identity(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "restore.sqlite"))
+    namespace = world.namespace("shared-a")
+    assert (await world.run(state)).authoritative_complete is True
+    _delete_folder_r(world)
+    await world.run(state)  # tombstone page; rescan seeded
+    assert (await world.run(state)).authoritative_complete is True
+    assert "doc-2" not in state.membership_ids(namespace, GEN)
+
+    # Access returns: the folder and its documents are readable again and the log reports it.
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("folder-n", drive="shared-a", parent="folder-r", folder=True)
+    world.put("doc-2", drive="shared-a", parent="folder-n")
+    world.logs["shared-a"].append({"fileId": "folder-r", "file": dict(world.files["folder-r"])})
+    world.pushed.clear()
+    world.calls.clear()
+    restored = await world.run(state)
+    if not restored.authoritative_complete:
+        restored = await world.run(state)  # a page that seeds a rescan publishes on the next run
+
+    assert ("list", "shared-a", "folder-r") in world.calls
+    assert "doc-2" in state.membership_ids(namespace, GEN)
+    assert "doc-2" in world.pushed  # the same provider id: no new content identity
+    binding = _binding(state, world, "folder", "folder-r")
+    assert binding.status == "bound" and not binding.detail
+    assert restored.authoritative_complete is True and "doc-2" in world.reconciled[-1]
+    state.close()

diff --git a/ingestion/tests/test_checkpoint_acknowledgment.py b/ingestion/tests/test_checkpoint_acknowledgment.py
new file mode 100644
index 00000000..741828dc
--- /dev/null
+++ b/ingestion/tests/test_checkpoint_acknowledgment.py
@@ -0,0 +1,275 @@
+"""A checkpoint the brain committed but whose acknowledgment was lost (AIO-1167 R47 F3).
+
+Spec (AC-03 durable acknowledgment/replay, AC-04/07 truthful failure accounting; adjudication F3).
+After a document's content is ACCEPTED, its checkpoint is control-plane work. When the brain commits
+that checkpoint but every bounded acknowledgment is lost (a transport exception, or 5xx answers),
+the sidecar's progress revision is unknown. Through the real coordinator and the REAL ``BrainClient``
+revision owner, against a brain double with the brain's actual revision semantics (commit on the
+expected revision; acknowledge an exact replay of what it holds; ``stale_progress`` otherwise):
+
+  * no document failure is charged and nothing is exhausted, however many runs lose it;
+  * the document is not acknowledged and its page not retired before the brain's acknowledgment;
+  * no further checkpoint is SENT this run once the revision is uncertain — no different checkpoint
+    under a guessed revision, so no sibling stream, root or watch state can regress;
+  * the run ends partial; the next acquisition restores the brain's progress and the owed work
+    replays idempotently to completion;
+  * a lost transport response that a retry of the IDENTICAL payload acknowledges is no uncertainty;
+  * a superseded execution is still run-terminal.
+
+One 504 followed by a normal identical retry is not this defect (the brain already acknowledges an
+identical replay); every case here loses ALL bounded acknowledgments.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from aios_ingest.brain_client import BrainClient, IngestResult
+from aios_ingest.config import BrainSettings, Connection
+from aios_ingest.gdrive_sync import run_gdrive_stream
+from aios_ingest.normalize import RawDoc
+from aios_ingest.state import StateStore
+
+INTEGRATION = "00000000-0000-0000-0000-0000000000f3"
+GENERATION = 5
+DOC_MIME = "application/vnd.google-apps.document"
+SETTINGS = BrainSettings("http://brain", "aios_key_secret", "team")
+CONNECTION = Connection("docs", "gdrive", options={"integration_id": INTEGRATION}, project="docs")
+DOCS = {"drive-a": ["a1", "a2"], "drive-b": ["b1"]}
+MAX_ATTEMPTS = 6  # brain_client._GDRIVE_CHECKPOINT_MAX_ATTEMPTS
+
+
+def world(monkeypatch):
+    """``w.losing`` = None | "exception" | "503": while set, the brain COMMITS a valid checkpoint and
+    then loses every response. ``w.lose_after_pushes`` arms it once that many documents were pushed."""
+    w = SimpleNamespace(
+        progress={}, revision=0, fence=0, losing=None, lose_after_pushes=None, armed_mode=None,
+        commits=[], checkpoint_requests=[], pushes=[], clock=1000.0, terminal=None,
+        unreadable=set(), reconciles=[],
+    )
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        body = json.loads(request.content)
+        action = body.get("action")
+        if action == "acquire":
+            w.fence += 1
+            w.losing = None  # a fresh run: what was lost is restored by this acquisition
+            if w.armed_mode and w.lose_after_pushes is None:
+                w.losing = w.armed_mode
+            return httpx.Response(200, json={
+                "integration_id": INTEGRATION, "generation": GENERATION, "fence": w.fence,
+                "owner": body["owner"], "lease_expires_at": "later", "scope_hash": "scope",
+                "config": {
+                    "authMode": "oauth", "authenticatedAccountId": "account", "fileIds": [],
+                    "folderIds": [], "sharedDriveIds": list(DOCS), "selectionState": "selected",
+                },
+                "progress": copy.deepcopy(w.progress), "progress_revision": w.revision,
+            })
+        if action == "release":
+            return httpx.Response(200, json={})
+        assert action == "checkpoint", action
+        w.checkpoint_requests.append(body)
+        if w.terminal is not None:
+            return httpx.Response(409, json={"error": {"code": w.terminal, "message": "superseded"}})
+        expected, payload = int(body["progress_revision"]), body["progress"]
+        if expected == w.revision:
+            w.revision += 1
+            w.progress = copy.deepcopy(payload)
+            w.commits.append(copy.deepcopy(payload))
+        elif not (expected < w.revision and payload == w.progress):
+            return httpx.Response(409, json={"error": {"code": "stale_progress", "message": "stale"}})
+        if w.losing == "exception":
+            raise httpx.ReadTimeout("acknowledgment lost", request=request)
+        if w.losing == "503":
+            return httpx.Response(503, json={"error": {"code": "unavailable", "message": "lost"}})
+        return httpx.Response(200, json={"progress_revision": w.revision, "progress": copy.deepcopy(w.progress)})
+
+    async def sleep(delay):
+        w.clock += delay
+
+    class Client(BrainClient):
+        """The real revision/uncertainty owner on the wire; Google-facing calls are doubles."""
+
+        def __init__(self, *args, **kwargs):
+            super().__init__(SETTINGS.base_url, SETTINGS.api_key, SETTINGS.team,
+                             sleep=sleep, random_fn=lambda: 0, monotonic_fn=lambda: w.clock)
+            self._client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+
+        async def broker_gdrive_access_token(self, execution):
+            return {"access_token": "memory", "account": {"subject": "account"}}
+
+        def gdrive_token_provider(self, execution, grant):
+            return SimpleNamespace(close=lambda: None)
+
+        def gdrive_provider_gate(self, execution):
+            return SimpleNamespace(close=lambda: None, __call__=lambda: None)
+
+        async def push(self, item, *, execution=None):
+            w.pushes.append(item.path)
+            if w.lose_after_pushes is not None and len(w.pushes) >= w.lose_after_pushes:
+                w.losing = w.armed_mode
+            return IngestResult("created", f"item-{len(w.pushes)}", item.path)
+
+        async def reconcile_gdrive(self, execution, **kwargs):
+            w.reconciles.append(kwargs)
+            return {"items": 0}
+
+    class Request:
+        def __init__(self, kind, value):
+            self.kind, self.value = kind, value
+
+        def execute(self):
+            return self.value
+
+    class Changes:
+        def getStartPageToken(self, **kwargs):
+            return Request("start", {"startPageToken": f"start:{kwargs.get('driveId')}"})
+
+        def list(self, **kwargs):
+            return Request("changes", {"changes": [], "newStartPageToken": f"terminal:{kwargs.get('driveId')}"})
+
+    class Files:
+        def list(self, **kwargs):
+            drive = kwargs.get("driveId")
+            return Request("list", {"files": [{
+                "id": doc, "name": f"Doc {doc}", "mimeType": DOC_MIME, "driveId": drive,
+                "modifiedTime": "2026-10-30T00:00:00Z",
+            } for doc in DOCS[drive]]})
+
+    class Drive:
+        def changes(self): return Changes()
+        def files(self): return Files()
+
+    class Source:
+        def __init__(self, **kwargs): pass
+        def set_run_deadline(self, deadline): pass
+        def _services(self): return Drive(), object()
+        def _execute(self, request): return request.execute()
+
+        def _metadata(self, file_id):
+            drive = next(d for d, docs in DOCS.items() if file_id in docs)
+            return {"id": file_id, "name": f"Doc {file_id}", "mimeType": DOC_MIME, "driveId": drive,
+                    "modifiedTime": "2026-10-30T00:00:00Z"}
+
+        def _raw_doc(self, meta):
+            if meta["id"] in w.unreadable:
+                raise RuntimeError("permanently malformed document")
+            return RawDoc(source="gdrive", external_id=meta["id"], title=meta["name"], body="body text")
+
+    monkeypatch.setattr("aios_ingest.gdrive_sync.BrainClient", Client)
+    monkeypatch.setattr("aios_ingest.gdrive_sync.GoogleDriveSource", Source)
+    return w
+
+
+def _doc(path: str) -> str:
+    return path.rsplit("/", 1)[-1].removesuffix(".md")
+
+
+def _owed(state: StateStore):
+    return [tuple(row) for row in state._db.execute(
+        "SELECT item_key, failures, exhausted_at FROM pending_work "
+        "WHERE acknowledged_at IS NULL AND superseded_at IS NULL ORDER BY item_key").fetchall()]
+
+
+@pytest.mark.parametrize("mode", ["exception", "503"])
+@pytest.mark.parametrize("lost_runs", [1, 6])
+@pytest.mark.asyncio
+async def test_a_committed_checkpoint_whose_acknowledgments_are_all_lost_charges_nothing_and_recovers(
+    tmp_path, monkeypatch, mode, lost_runs,
+):
+    w = world(monkeypatch)
+    w.armed_mode, w.lose_after_pushes = mode, 1
+    state = StateStore(str(tmp_path / "sidecar.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    # The brain committed the first document's checkpoint; the sidecar never saw it acknowledged.
+    lost = [r for r in w.checkpoint_requests if r["progress"] == w.commits[-1]]
+    assert len(lost) == MAX_ATTEMPTS  # the IDENTICAL payload, retried within the bound — then nothing
+    assert w.checkpoint_requests[-MAX_ATTEMPTS:] == lost  # no different checkpoint was sent after it
+    assert len({r["progress_revision"] for r in lost}) == 1
+    first = _doc(w.pushes[0])
+    assert summary.failed == 0
+    assert summary.failure_categories.get("checkpoint_unacknowledged") == 1
+    assert summary.authoritative_complete is False
+    assert len(w.pushes) == 1  # no further document was started under the unknown revision
+    owed = dict((item, (failures, exhausted)) for item, failures, exhausted in _owed(state))
+    assert owed, "the accepted document is still owed: not acknowledged before the brain's ack"
+    assert all(value == (0, None) for value in owed.values())
+
+    # Further runs that lose every acknowledgment again: still nothing charged, nothing exhausted.
+    w.lose_after_pushes = None
+    for _ in range(lost_runs - 1):
+        again = await run_gdrive_stream(SETTINGS, CONNECTION, StateStore(str(tmp_path / "sidecar.sqlite")))
+        assert again.failed == 0
+        assert all(failures == 0 and exhausted is None for _item, failures, exhausted in _owed(state))
+
+    # Acknowledgments reach the sidecar again: the next acquisition restores the brain's progress and
+    # the owed work replays to completion — no sibling stream regressed on the way.
+    w.armed_mode = None
+    recovered_state = StateStore(str(tmp_path / "sidecar.sqlite"))
+    recovered = await run_gdrive_stream(SETTINGS, CONNECTION, recovered_state)
+    assert recovered.failed == 0
+    assert "checkpoint_unacknowledged" not in recovered.failure_categories
+    assert _owed(recovered_state) == []
+    assert {_doc(path) for path in w.pushes} >= {doc for docs in DOCS.values() for doc in docs}
+    assert first in {_doc(path) for path in w.pushes[1:]}  # replayed, idempotently
+    streams = w.progress.get("streams") or {}
+    assert set(streams) == set(DOCS)
+    state.close()
+    recovered_state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_lost_response_that_an_identical_retry_acknowledges_is_no_uncertainty(tmp_path, monkeypatch):
+    """Control: the brain acknowledges an exact replay — the run simply continues."""
+    w = world(monkeypatch)
+    state = StateStore(str(tmp_path / "control.sqlite"))
+    original = httpx.MockTransport.handle_async_request
+    dropped = {"n": 0}
+
+    async def drop_one(self, request):
+        body = json.loads(request.content)
+        response = await original(self, request)
+        if body.get("action") == "checkpoint" and w.pushes and dropped["n"] == 0:
+            dropped["n"] = 1
+            raise httpx.ReadTimeout("one lost response", request=request)
+        return response
+
+    monkeypatch.setattr(httpx.MockTransport, "handle_async_request", drop_one)
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert dropped["n"] == 1
+    assert "checkpoint_unacknowledged" not in summary.failure_categories
+    assert summary.failed == 0 and _owed(state) == []
+    assert len(w.pushes) == sum(len(docs) for docs in DOCS.values())
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_superseded_execution_stays_run_terminal(tmp_path, monkeypatch):
+    w = world(monkeypatch)
+    state = StateStore(str(tmp_path / "terminal.sqlite"))
+    import aios_ingest.gdrive_sync as sync
+    original_push = sync.BrainClient.push
+
+    async def push_then_supersede(self, item, *, execution=None):
+        # The execution is superseded right after the first accepted document.
+        result = await original_push(self, item, execution=execution)
+        w.terminal = "stale_execution"
+        return result
+
+    monkeypatch.setattr(sync.BrainClient, "push", push_then_supersede)
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories.get("stale_execution") == 1
+    assert "checkpoint_unacknowledged" not in summary.failure_categories
+    assert len(w.pushes) == 1
+    assert all(failures == 0 and exhausted is None for _item, failures, exhausted in _owed(state))
+    state.close()

diff --git a/ingestion/tests/test_checkpoint_uncertainty_latch.py b/ingestion/tests/test_checkpoint_uncertainty_latch.py
new file mode 100644
index 00000000..6e853bfb
--- /dev/null
+++ b/ingestion/tests/test_checkpoint_uncertainty_latch.py
@@ -0,0 +1,134 @@
+"""The ``BrainClient`` checkpoint-revision owner latches an unknown revision (AIO-1167 R47 F3).
+
+The client owns each execution's progress revision. When a checkpoint was SENT but no 200 came back
+(all bounded responses lost, terminal 5xx, a deferral after a send, or ``stale_progress``), the brain
+may hold a revision this client does not know. From then on the client refuses to send any further
+checkpoint under that execution — never a changed document under a guessed revision — until a fresh
+acquisition restores the brain's authority. A checkpoint that was never sent latches nothing.
+
+This pins the client layer on its own: the coordinator also stops on the first uncertainty, which
+would mask a client that kept sending.
+"""
+
+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+
+from aios_ingest.brain_client import BrainClient, BrainDeferred, BrainError, GdriveExecution
+
+INTEGRATION = "11111111-1111-1111-1111-111111111111"
+OWNER = "22222222-2222-2222-2222-222222222222"
+
+
+def _client(handler, clock):
+    async def sleep(delay):
+        clock[0] += delay
+
+    client = BrainClient("http://brain", "aios_abc_def", "demo", sleep=sleep,
+                         random_fn=lambda: 0, monotonic_fn=lambda: clock[0])
+    client._client = httpx.AsyncClient(transport=httpx.MockTransport(handler))
+    return client
+
+
+def _execution(**kwargs) -> GdriveExecution:
+    return GdriveExecution(INTEGRATION, 2, 4, OWNER, "later", "scope", {}, progress_revision=9, **kwargs)
+
+
+def _checkpoints(calls):
+    return [c for c in calls if c.get("action") == "checkpoint"]
+
+
+def _acquired(request_body):
+    return httpx.Response(200, json={
+        "integration_id": INTEGRATION, "generation": 2, "fence": 4, "owner": request_body["owner"],
+        "lease_expires_at": "later", "scope_hash": "scope", "config": {}, "progress": {},
+        "progress_revision": 10,
+    })
+
+
+@pytest.mark.parametrize("answer", ["transport", "503", "stale_progress"])
+@pytest.mark.asyncio
+async def test_a_sent_unacknowledged_checkpoint_latches_until_reacquired(answer):
+    calls: list[dict] = []
+    clock = [100.0]
+    healthy = {"on": False}
+
+    def handler(request: httpx.Request):
+        body = json.loads(request.content)
+        calls.append(body)
+        if body["action"] == "acquire":
+            return _acquired(body)
+        if healthy["on"]:
+            return httpx.Response(200, json={"progress_revision": body["progress_revision"] + 1, "progress": {}})
+        if answer == "transport":
+            raise httpx.ConnectError("lost", request=request)
+        if answer == "503":
+            return httpx.Response(503, json={"error": {"code": "unavailable", "message": "down"}})
+        return httpx.Response(409, json={"error": {"code": "stale_progress", "message": "stale"}})
+
+    client = _client(handler, clock)
+    execution = _execution()
+    async with client:
+        with pytest.raises(BrainError) as first:
+            await client.checkpoint_gdrive_execution(execution, {"page_token": "a"})
+        assert client.gdrive_progress_uncertain(execution)
+        if answer == "transport":
+            assert first.value.code == "checkpoint_unacknowledged"
+        sent = len(_checkpoints(calls))
+        assert sent >= 1
+
+        # A DIFFERENT checkpoint under the same execution is refused without being sent.
+        healthy["on"] = True
+        with pytest.raises(BrainDeferred) as refused:
+            await client.checkpoint_gdrive_execution(execution, {"page_token": "b"})
+        assert refused.value.code == "checkpoint_unacknowledged" and refused.value.not_before is None
+        assert len(_checkpoints(calls)) == sent
+
+        # A fresh acquisition restores the authority, and checkpoints are sent again.
+        reacquired = await client.acquire_gdrive_execution(INTEGRATION, OWNER)
+        assert not client.gdrive_progress_uncertain(reacquired)
+        ack = await client.checkpoint_gdrive_execution(reacquired, {"page_token": "c"})
+        assert ack["progress_revision"] == 11
+        assert _checkpoints(calls)[-1]["progress_revision"] == 10
+
+
+@pytest.mark.asyncio
+async def test_a_lost_response_retried_identically_and_acknowledged_latches_nothing():
+    calls: list[dict] = []
+    clock = [100.0]
+
+    def handler(request: httpx.Request):
+        body = json.loads(request.content)
+        calls.append(body)
+        if len(calls) == 1:
+            raise httpx.ReadTimeout("lost", request=request)
+        return httpx.Response(200, json={"progress_revision": body["progress_revision"] + 1, "progress": {}})
+
+    client = _client(handler, clock)
+    execution = _execution()
+    async with client:
+        ack = await client.checkpoint_gdrive_execution(execution, {"page_token": "a"})
+    assert ack["progress_revision"] == 10
+    assert not client.gdrive_progress_uncertain(execution)
+    assert calls[0] == calls[1]  # the identical payload, under the same revision
+
+
+@pytest.mark.asyncio
+async def test_a_checkpoint_never_sent_latches_nothing():
+    calls: list[dict] = []
+    clock = [100.0]
+
+    def handler(request: httpx.Request):
+        calls.append(json.loads(request.content))
+        return httpx.Response(200, json={"progress_revision": 10, "progress": {}})
+
+    client = _client(handler, clock)
+    execution = _execution(run_deadline=99.0)
+    async with client:
+        with pytest.raises(BrainDeferred) as deferred:
+            await client.checkpoint_gdrive_execution(execution, {"page_token": "a"})
+    assert deferred.value.code == "checkpoint_deadline" and calls == []
+    assert not client.gdrive_progress_uncertain(execution)

diff --git a/ingestion/tests/test_document_restrictions.py b/ingestion/tests/test_document_restrictions.py
new file mode 100644
index 00000000..88fb7620
--- /dev/null
+++ b/ingestion/tests/test_document_restrictions.py
@@ -0,0 +1,354 @@
+"""A document's provider-named minimum is owned apart from its retry bookkeeping (AIO-1167 R49 F1).
+
+Spec (Astra R48 adjudication F1; accepted-spec AC-04:230). When Google names a minimum for ONE
+document (a 503 with a valid or unrepresentable Retry-After from the REAL provider-call owner):
+
+  * the minimum is the DOCUMENT's restriction, keyed by connection, account, generation and stable
+    provider id, independent of the observation's attempts and exhaustion;
+  * no ordinary run, Run now / Retry (exhaustion rearm), newer observation, controlled rescan,
+    reopened SQLite file or fresh state file reconstructed from acknowledged progress reads, pushes
+    or completes that document before the minimum lapses — and the unrepresentable sentinel never
+    lapses;
+  * unrelated documents keep progressing, and a per-document 503 is never an account hold;
+  * once a representable minimum has passed, the rearmed obligation completes normally, while a
+    newer removal still supersedes stale upsert work;
+  * a lost acknowledgment, or stale (older-generation / shorter) remote evidence, cannot erase the
+    restriction or manufacture completion.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+import pytest
+
+from aios_ingest.brain_client import BrainError
+from aios_ingest.config import BrainSettings, Connection
+from aios_ingest.gdrive_sync import _MAX_AUTOMATIC_ATTEMPTS, run_gdrive_stream
+from aios_ingest.sources.gdrive import LATEST_INSTANT, ProviderCursorInvalid
+from aios_ingest.state import StateStore
+from test_account_hold_before_streams import provider_deferral
+from test_gdrive_upgrade import _DriveWorld, _ProviderHttpError
+
+GEN = 9
+LONG = "99999999"           # ~3.2 years: valid, honoured exactly
+SENTINEL = "9" * 30         # valid digits no timestamp can hold: fail closed
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    """One clock for the coordinator and the state store, starting at the real present."""
+    now = SimpleNamespace(at=datetime.now(timezone.utc))
+    monkeypatch.setattr("aios_ingest.gdrive_sync._now", lambda: now.at.isoformat())
+    monkeypatch.setattr("aios_ingest.state._now_iso", lambda: now.at.isoformat())
+    monkeypatch.setattr("aios_ingest.gdrive_sync._backoff_seconds", lambda *_a, **_k: 0)
+    return now
+
+
+async def run(world, state, *, rearm=False):
+    """One run; ``rearm`` is what Run now / Retry request (``rearm_exhausted``)."""
+    options = {"integration_id": world.integration_id, **({"rearm_exhausted": True} if rearm else {})}
+    return await run_gdrive_stream(
+        BrainSettings("http://brain", "key", "team"), Connection("docs", "gdrive", options=options), state,
+    )
+
+
+def _world(monkeypatch):
+    world = _DriveWorld(folder_ids=["folder-r"]).install(monkeypatch)
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("doc-a", drive="shared-a", parent="folder-r")
+    world.put("doc-b", drive="shared-a", parent="folder-r")
+    return world
+
+
+def _reads(world, doc):
+    return [call for call in world.calls if call in (("metadata", doc), ("doc", doc))]
+
+
+def _restriction(state, world, doc="doc-a"):
+    return state.document_restrictions(world.integration_id, GEN, "account").get(doc)
+
+
+async def _restrict_after_seven_failures(world, state, clock, header):
+    """Seven ordinary failures, then an eighth that is a provider-call 503 naming ``header``."""
+    world.unreadable["doc-a"] = _ProviderHttpError(500)
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS - 1):
+        await run(world, state)
+        clock.at += timedelta(seconds=1)
+    world.unreadable["doc-a"] = provider_deferral(503, header)
+    eighth = await run(world, state)
+    world.unreadable.pop("doc-a")  # the document is readable again: only the minimum stands
+    return eighth
+
+
+@pytest.mark.parametrize("header, unrepresentable", [(LONG, False), (SENTINEL, True)])
+@pytest.mark.asyncio
+async def test_run_now_and_retry_never_read_a_restricted_document_early(
+    tmp_path, monkeypatch, clock, header, unrepresentable,
+):
+    world = _world(monkeypatch)
+    path = str(tmp_path / "restricted.sqlite")
+    state = StateStore(path)
+
+    eighth = await _restrict_after_seven_failures(world, state, clock, header)
+
+    assert eighth.failure_categories.get("provider_unavailable", 0) >= 1
+    assert "rate_limited" not in eighth.failure_categories  # never an account hold
+    assert state.connection_hold(world.integration_id, GEN, "account") is None
+    held = _restriction(state, world)
+    assert held is not None and held[2] is unrepresentable
+    if unrepresentable:
+        assert held[0] == LATEST_INSTANT.isoformat()
+    else:
+        deadline = datetime.fromisoformat(held[0])
+        assert abs((deadline - (datetime.now(timezone.utc) + timedelta(seconds=int(LONG)))).total_seconds()) < 30
+    # Published in the fenced progress.
+    published = world.progress["document_restrictions"]
+    assert published["generation"] == GEN and published["credential"] == "account"
+    assert [item["id"] for item in published["items"]] == ["doc-a"]
+    assert "doc-b" in world.pushed  # the unrelated document progressed
+
+    # Repeated Run now / Retry: the exhaustion is rearmed, the minimum is not.
+    world.calls.clear()
+    world.pushed.clear()
+    for _ in range(3):
+        clock.at += timedelta(days=30)
+        held_run = await run(world, state, rearm=True)
+        assert held_run.authoritative_complete is False
+        assert held_run.failure_categories.get("provider_restricted_document") == 1
+    assert _reads(world, "doc-a") == [] and "doc-a" not in world.pushed
+    state.close()
+
+    # The same SQLite file reopened, and a fresh one rebuilt from acknowledged progress.
+    for rebuilt in (path, str(tmp_path / "fresh.sqlite")):
+        state = StateStore(rebuilt)
+        world.calls.clear()
+        outcome = await run(world, state, rearm=True)
+        if rebuilt != path:
+            # The fresh file really rebuilt the stream: the folder was enumerated again and doc-a
+            # is owed in it — and still was not read.
+            outcome = await run(world, state, rearm=True)
+            assert ("list", "shared-a", "folder-r") in world.calls
+            assert state.has_owed_work(world.namespace("shared-a"), GEN, "doc-a")
+        assert _reads(world, "doc-a") == [] and "doc-a" not in world.pushed
+        assert outcome.authoritative_complete is False
+        assert _restriction(state, world) is not None
+        state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_new_observation_and_a_controlled_rescan_keep_the_minimum_while_others_progress(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "observe.sqlite"))
+    await _restrict_after_seven_failures(world, state, clock, LONG)
+
+    # A newer observation of doc-a (it changed), and an unrelated new document.
+    world.logs["shared-a"].append({"fileId": "doc-a", "file": dict(world.files["doc-a"])})
+    world.put("doc-c", drive="shared-a", parent="folder-r")
+    world.logs["shared-a"].append({"fileId": "doc-c", "file": dict(world.files["doc-c"])})
+    world.calls.clear()
+    world.pushed.clear()
+    await run(world, state, rearm=True)
+    assert _reads(world, "doc-a") == [] and "doc-c" in world.pushed
+
+    # A controlled rescan (the provider rejects the cursor) re-enumerates doc-a: still not read.
+    world.cursor_errors["shared-a"] = ProviderCursorInvalid("expired")
+    await run(world, state)
+    world.cursor_errors.clear()
+    world.calls.clear()
+    for _ in range(2):
+        rescanned = await run(world, state, rearm=True)
+    assert ("list", "shared-a", "folder-r") in world.calls  # the rescan re-enumerated the folder
+    assert _reads(world, "doc-a") == [] and "doc-a" not in world.pushed
+    assert rescanned.authoritative_complete is False
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_after_a_representable_minimum_passes_the_rearmed_obligation_completes(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "lapse.sqlite"))
+    await _restrict_after_seven_failures(world, state, clock, "120")
+
+    clock.at += timedelta(seconds=60)
+    world.calls.clear()
+    await run(world, state, rearm=True)
+    assert _reads(world, "doc-a") == []  # not yet
+
+    clock.at += timedelta(seconds=120)
+    world.pushed.clear()
+    done = await run(world, state, rearm=True)
+    assert "doc-a" in world.pushed
+    if not done.authoritative_complete:
+        done = await run(world, state)
+    assert done.authoritative_complete is True
+    assert "document_restrictions" not in world.progress  # a lapsed minimum is no longer published
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_newer_removal_supersedes_stale_upsert_work_once_the_minimum_passes(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "supersede.sqlite"))
+    await _restrict_after_seven_failures(world, state, clock, "120")
+
+    # doc-a is deleted while restricted.
+    world.files.pop("doc-a")
+    world.logs["shared-a"].append({"fileId": "doc-a", "removed": True})
+    clock.at += timedelta(seconds=300)
+    world.pushed.clear()
+    for _ in range(2):
+        await run(world, state, rearm=True)
+    assert "doc-a" not in world.pushed  # the stale upsert never restored content
+    assert "doc-a" in world.removed
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_lost_acknowledgment_keeps_the_local_restriction_and_claims_nothing(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "lost-ack.sqlite"))
+    world.unreadable["doc-a"] = _ProviderHttpError(500)
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS - 1):
+        await run(world, state)
+        clock.at += timedelta(seconds=1)
+    world.unreadable["doc-a"] = provider_deferral(503, LONG)
+    # Every checkpoint of the run that records the minimum fails.
+    world.checkpoint_faults.extend(
+        [lambda _payload: BrainError(503, "unavailable", "lost")] * 10
+    )
+    lost = await run(world, state)
+    world.checkpoint_faults.clear()
+    world.unreadable.pop("doc-a")
+
+    assert lost.authoritative_complete is False
+    assert _restriction(state, world) is not None  # local evidence kept
+    assert "doc-a" not in [item["id"] for item in (world.progress.get("document_restrictions") or {}).get("items", [])]
+
+    # The next run publishes it; nothing was read early meanwhile.
+    world.calls.clear()
+    await run(world, state, rearm=True)
+    assert _reads(world, "doc-a") == []
+    assert [item["id"] for item in world.progress["document_restrictions"]["items"]] == ["doc-a"]
+    state.close()
+
+
+@pytest.mark.parametrize("remote", ["older-generation-shorter", "shorter-same-generation"])
+@pytest.mark.asyncio
+async def test_stale_remote_evidence_cannot_shorten_or_erase_a_restriction(
+    tmp_path, monkeypatch, clock, remote,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "stale.sqlite"))
+    await _restrict_after_seven_failures(world, state, clock, LONG)
+    held = _restriction(state, world)
+
+    short = (clock.at + timedelta(seconds=5)).isoformat()
+    world.progress["document_restrictions"] = {
+        "generation": GEN - 1 if remote.startswith("older") else GEN,
+        "credential": "account",
+        "items": [{"id": "doc-a", "not_before": short, "category": "provider_unavailable", "unrepresentable": False}],
+    }
+    clock.at += timedelta(seconds=60)
+    world.calls.clear()
+    outcome = await run(world, state, rearm=True)
+
+    assert _restriction(state, world) == held
+    assert _reads(world, "doc-a") == [] and outcome.authoritative_complete is False
+    assert world.progress["document_restrictions"]["items"][0]["not_before"] == held[0]
+    state.close()
+
+
+def test_restrictions_merge_monotonically_and_the_sentinel_never_lapses(tmp_path):
+    state = StateStore(str(tmp_path / "merge.sqlite"))
+    key = ("conn", GEN, "account", "doc")
+    long = "2029-12-01T00:00:00+00:00"
+    assert state.restrict_document(*key, long, "provider_unavailable") == (long, "provider_unavailable", False)
+    assert state.restrict_document(*key, "2026-11-01T00:00:00+00:00", "provider_unavailable")[0] == long
+    sentinel = LATEST_INSTANT.isoformat()
+    assert state.restrict_document(*key, sentinel, "provider_unavailable", unrepresentable=True)[2] is True
+    # A later valid restriction — even a "later" instant — never relabels the unrepresentable one.
+    assert state.restrict_document(*key, sentinel, "provider_unavailable", unrepresentable=False)[2] is True
+    assert state.restrict_document(*key, long, "provider_unavailable")[2] is True
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_restricted_selected_file_root_is_not_read_by_a_controlled_rescan(tmp_path, monkeypatch, clock):
+    world = _DriveWorld(file_ids=["file-x", "file-y"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    state = StateStore(str(tmp_path / "file-root.sqlite"))
+    # file-x is owed again (it changed), then its reads fail into a provider-named minimum.
+    assert (await run(world, state)).authoritative_complete is True
+    world.logs["shared-a"].append({"fileId": "file-x", "file": dict(world.files["file-x"])})
+    world.unreadable["file-x"] = _ProviderHttpError(500)
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS - 1):
+        await run(world, state)
+        clock.at += timedelta(seconds=1)
+    world.unreadable["file-x"] = provider_deferral(503, LONG)
+    await run(world, state)
+    world.unreadable.pop("file-x")
+    assert _restriction(state, world, "file-x") is not None
+
+    # A controlled rescan rebuilds the file pages: file-x's page is not read, file-y's is.
+    world.cursor_errors["shared-a"] = ProviderCursorInvalid("expired")
+    await run(world, state)
+    world.cursor_errors.clear()
+    world.calls.clear()
+    outcome = await run(world, state, rearm=True)
+    assert ("metadata", "file-x") not in world.calls and ("metadata", "file-y") in world.calls
+    assert outcome.authoritative_complete is False
+    assert outcome.failure_categories.get("provider_restricted_document") == 1
+    state.close()
+
+
+def test_rearm_resets_the_attempt_budget_but_keeps_the_obligations_not_before(tmp_path):
+    state = StateStore(str(tmp_path / "rearm.sqlite"))
+    namespace = "ns"
+    state.enqueue_work(namespace, GEN, "doc", "upsert", {"file_id": "doc"})
+    [work] = state.list_pending(namespace, GEN)
+    later = "2099-01-01T00:00:00+00:00"
+    state.fail_work(work, "provider named a minimum", not_before=later, exhaust=True)
+    assert state.rearm_exhausted(namespace, GEN) == 1
+    row = state._db.execute(
+        "SELECT attempts, failures, exhausted_at, not_before FROM pending_work WHERE item_key='doc'",
+    ).fetchone()
+    assert (row["attempts"], row["failures"], row["exhausted_at"], row["not_before"]) == (0, 0, None, later)
+    assert state.list_pending(namespace, GEN) == []  # still not eligible before the minimum
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_recovery_never_reinterprets_an_unrepresentable_restriction_as_an_expiring_instant(
+    tmp_path, monkeypatch, clock,
+):
+    """The classification, not the stored instant, governs: acknowledged evidence that a minimum
+    was unrepresentable keeps the document closed even if its instant reads as past."""
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "first.sqlite"))
+    assert (await run(world, state)).authoritative_complete is True
+    state.close()
+    world.logs["shared-a"].append({"fileId": "doc-a", "file": dict(world.files["doc-a"])})
+    world.progress["document_restrictions"] = {
+        "generation": GEN, "credential": "account",
+        "items": [{"id": "doc-a", "not_before": "2000-01-01T00:00:00+00:00",
+                   "category": "provider_unavailable", "unrepresentable": True}],
+    }
+    fresh = StateStore(str(tmp_path / "fresh.sqlite"))
+    world.calls.clear()
+    world.pushed.clear()
+    for _ in range(2):
+        await run(world, fresh, rearm=True)
+    assert _reads(world, "doc-a") == [] and "doc-a" not in world.pushed
+    assert _restriction(fresh, world)[2] is True
+    fresh.close()

diff --git a/ingestion/tests/test_exhaustion_is_not_completion.py b/ingestion/tests/test_exhaustion_is_not_completion.py
new file mode 100644
index 00000000..d08ed63a
--- /dev/null
+++ b/ingestion/tests/test_exhaustion_is_not_completion.py
@@ -0,0 +1,62 @@
+"""Exhaustion is not completion evidence (AIO-1167 R47 — F4 preserved).
+
+Spec (accepted-spec 166/232/314; adjudication F4). A document whose automatic retries ran out is
+still OWED: its content outcome was never delivered. Through the real coordinator:
+
+  * the run stays partial, with an accurate ``retry_exhausted`` backlog diagnostic;
+  * no complete-snapshot reconciliation is submitted — absence is never inferred around it, so
+    nothing the brain holds is purged — however many runs pass;
+  * once the document is readable again and an Admin re-arms it (Run now / Retry), the connection
+    converges: the document is delivered and the complete snapshot is reconciled.
+
+This pins the conservative gate F4 requires to stay; it is not a change of behaviour.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.gdrive_sync import _MAX_AUTOMATIC_ATTEMPTS, run_gdrive_stream
+from aios_ingest.state import StateStore
+from test_checkpoint_acknowledgment import CONNECTION, DOCS, SETTINGS, world
+
+
+def _complete_snapshots(w) -> list[dict]:
+    return [call for call in w.reconciles if "complete_snapshot_ids" in call]
+
+
+@pytest.mark.asyncio
+async def test_an_exhausted_document_keeps_the_run_partial_and_never_reconciles_absence(tmp_path, monkeypatch):
+    w = world(monkeypatch)
+    w.unreadable = {"b1"}
+    monkeypatch.setattr("aios_ingest.gdrive_sync._backoff_seconds", lambda *_args, **_kwargs: 0)
+    path = str(tmp_path / "exhaust.sqlite")
+
+    last = None
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS + 2):
+        state = StateStore(path)
+        last = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+        state.close()
+
+    assert last.failure_categories.get("retry_exhausted") == 1
+    assert last.authoritative_complete is False
+    assert last.backlog is not None and last.backlog >= 1
+    assert _complete_snapshots(w) == []  # no absence was ever submitted around the owed document
+    state = StateStore(path)
+    owed = state._db.execute(
+        "SELECT item_key, exhausted_at FROM pending_work WHERE acknowledged_at IS NULL AND superseded_at IS NULL",
+    ).fetchall()
+    assert [(row[0], row[1] is not None) for row in owed] == [("b1", True)]
+    state.close()
+
+    # Repaired, and re-armed by an explicit Admin run: the connection converges.
+    w.unreadable = set()
+    state = StateStore(path)
+    monkeypatch.setitem(CONNECTION.options, "rearm_exhausted", True)
+    repaired = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    monkeypatch.delitem(CONNECTION.options, "rearm_exhausted")
+    assert "retry_exhausted" not in repaired.failure_categories
+    assert repaired.authoritative_complete is True
+    [snapshot] = _complete_snapshots(w)
+    assert sorted(snapshot["complete_snapshot_ids"]) == sorted(doc for docs in DOCS.values() for doc in docs)
+    state.close()

diff --git a/ingestion/tests/test_retry_after_holds.py b/ingestion/tests/test_retry_after_holds.py
new file mode 100644
index 00000000..79f161ad
--- /dev/null
+++ b/ingestion/tests/test_retry_after_holds.py
@@ -0,0 +1,251 @@
+"""Provider Retry-After through the real coordinator: holds, restarts and admission (AIO-1167 R48 D2).
+
+Spec (AC-04:230; Astra R47 D2). Each deferral below is the REAL provider owner's answer to an HTTP
+response carrying the stated Retry-After (``provider_deferral``), driven through the real coordinator
+in the root-metadata, start-token and document phases:
+
+  * a valid delay — ordinary, an HTTP-date, or the long ``99999999`` — is held to the provider's
+    deadline exactly: no provider call before it on retry, restart or a fresh state file restoring
+    the brain's progress, and admission resumes once the represented deadline has passed;
+  * malformed input is the bounded fallback with ``retry_after_malformed``; unrepresentable input is
+    held at the last representable instant with ``retry_after_unrepresentable`` — the persisted
+    progress stays valid JSON with ISO instants, and nothing completes falsely;
+  * a document's own (non-quota) deferral keeps the provider's deadline as its earliest retry;
+  * account holds merge monotonically: a shorter later hold, local or adopted, never shortens one.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timedelta, timezone
+from email.utils import format_datetime
+from types import SimpleNamespace
+
+import pytest
+
+from aios_ingest.gdrive_sync import run_gdrive_stream
+from aios_ingest.sources.gdrive import LATEST_INSTANT
+from aios_ingest.state import StateStore
+from test_account_hold_before_streams import (
+    ACCOUNT, CONNECTION, DRIVE_ROOTS, FILE_ROOT, GENERATION, INTEGRATION, SETTINGS, world,
+)
+
+LATEST = LATEST_INSTANT.isoformat()
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    """The coordinator's clock, starting at the real present the provider owner computes from."""
+    now = SimpleNamespace(at=datetime.now(timezone.utc))
+    monkeypatch.setattr("aios_ingest.gdrive_sync._now", lambda: now.at.isoformat())
+    return now
+
+
+def _hold(state: StateStore) -> tuple[str, str] | None:
+    return state.connection_hold(INTEGRATION, GENERATION, ACCOUNT)
+
+
+def _assert_valid_progress(w) -> None:
+    """The published document is JSON with ISO instants wherever a retry time is recorded."""
+    json.dumps(w.progress)
+    hold = w.progress.get("account_hold")
+    if hold:
+        datetime.fromisoformat(hold["not_before"])
+    for stream in (w.progress.get("streams") or {}).values():
+        if stream.get("retry_not_before"):
+            datetime.fromisoformat(stream["retry_not_before"])
+
+
+async def _held_without_a_call(w, path, clock_at, clock):
+    before = list(w.calls)
+    clock.at = clock_at
+    state = StateStore(path)
+    await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    state.close()
+    assert w.calls == before, f"a provider call was made at {clock_at.isoformat()}"
+
+
+@pytest.mark.parametrize("selection, phase", [(DRIVE_ROOTS, "start"), (FILE_ROOT, "metadata")])
+@pytest.mark.parametrize("header", ["120", "http-date", "99999999"])
+@pytest.mark.asyncio
+async def test_a_valid_delay_is_held_to_exactly_its_deadline_then_admitted(
+    tmp_path, monkeypatch, clock, selection, phase, header,
+):
+    target = (clock.at + timedelta(minutes=5)).replace(microsecond=0)
+    value = format_datetime(target, usegmt=True) if header == "http-date" else header
+    w = world(monkeypatch, selection=selection, fail=phase, retry_after=value)
+    state = StateStore(str(tmp_path / "s.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    held = _hold(state)
+    assert held is not None
+    deadline = datetime.fromisoformat(held[0])
+    if header == "http-date":
+        assert deadline == target
+    else:
+        expected = clock.at + timedelta(seconds=int(header))
+        assert abs((deadline - expected).total_seconds()) < 5  # the named delay, not shortened
+    assert w.progress["account_hold"]["not_before"] == held[0]
+    assert summary.failed == 0 and "retry_after_malformed" not in summary.failure_categories
+    _assert_valid_progress(w)
+    state.close()
+
+    path = str(tmp_path / "s.sqlite")
+    # Just before the represented deadline: restart, and a fresh state file restoring the brain.
+    await _held_without_a_call(w, path, deadline - timedelta(seconds=1), clock)
+    await _held_without_a_call(w, str(tmp_path / "fresh.sqlite"), deadline - timedelta(seconds=1), clock)
+    # Just after it: admitted, and the work proceeds.
+    w.fail = None
+    clock.at = deadline + timedelta(seconds=1)
+    state = StateStore(path)
+    resumed = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    assert "rate_limited" not in resumed.failure_categories
+    assert w.calls.count(phase) >= 2 and w.pushes
+    state.close()
+
+
+@pytest.mark.parametrize("value", ["soon", "nan", "inf", "-5", "1e999", "Wed, 31 Feb 2026 10:00:00 GMT"])
+@pytest.mark.asyncio
+async def test_malformed_input_is_a_bounded_fallback_hold_with_a_diagnostic(tmp_path, monkeypatch, clock, value):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail="start", retry_after=value)
+    state = StateStore(str(tmp_path / "m.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories.get("retry_after_malformed") == 1
+    assert summary.failure_categories.get("rate_limited") == 1 and summary.failed == 0
+    held = _hold(state)
+    assert held is not None
+    deadline = datetime.fromisoformat(held[0])
+    assert deadline <= datetime.now(timezone.utc) + timedelta(seconds=4.2)  # the bounded fallback
+    _assert_valid_progress(w)
+    state.close()
+
+    w.fail = None
+    clock.at = deadline + timedelta(seconds=1)
+    state = StateStore(str(tmp_path / "m.sqlite"))
+    resumed = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    assert "rate_limited" not in resumed.failure_categories and w.pushes
+    state.close()
+
+
+@pytest.mark.parametrize("selection, phase", [(DRIVE_ROOTS, "start"), (FILE_ROOT, "metadata")])
+@pytest.mark.parametrize("value", ["9" * 30, "300000000000", "Fri, 31 Dec 99999 23:59:59 GMT"])
+@pytest.mark.asyncio
+async def test_unrepresentable_input_fails_closed_across_restart_and_restore(
+    tmp_path, monkeypatch, clock, selection, phase, value,
+):
+    w = world(monkeypatch, selection=selection, fail=phase, retry_after=value)
+    path = str(tmp_path / "u.sqlite")
+    state = StateStore(path)
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories.get("retry_after_unrepresentable") == 1
+    assert summary.authoritative_complete is False and w.pushes == []
+    assert _hold(state) == (LATEST, "rate_limited")
+    assert w.progress["account_hold"]["not_before"] == LATEST
+    _assert_valid_progress(w)
+    state.close()
+
+    # Never retried early: not on restart, not from a fresh state file, not centuries from now.
+    w.fail = None
+    await _held_without_a_call(w, path, clock.at + timedelta(days=1), clock)
+    await _held_without_a_call(w, str(tmp_path / "fresh.sqlite"), clock.at + timedelta(days=1), clock)
+    await _held_without_a_call(w, path, datetime(9000, 1, 1, tzinfo=timezone.utc), clock)
+
+
+@pytest.mark.asyncio
+async def test_a_document_phase_rate_limit_holds_every_stream_to_the_long_deadline(tmp_path, monkeypatch, clock):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail="body", retry_after="99999999")
+    path = str(tmp_path / "doc-rate.sqlite")
+    state = StateStore(path)
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    held = _hold(state)
+    assert held is not None
+    deadline = datetime.fromisoformat(held[0])
+    assert abs((deadline - (clock.at + timedelta(seconds=99999999))).total_seconds()) < 5
+    assert summary.failed == 0 and summary.authoritative_complete is False
+    for progress in state.list_progress(INTEGRATION, GENERATION):
+        assert progress.retry_not_before == held[0]
+    _assert_valid_progress(w)
+    state.close()
+    w.fail = None
+    await _held_without_a_call(w, str(tmp_path / "doc-fresh.sqlite"), deadline - timedelta(days=1), clock)
+
+
+def _owed_body(state: StateStore):
+    return state._db.execute(
+        "SELECT item_key, failures, not_before FROM pending_work "
+        "WHERE acknowledged_at IS NULL AND superseded_at IS NULL ORDER BY item_key").fetchall()
+
+
+@pytest.mark.parametrize("value, expect", [
+    ("120", "deadline"), ("inf", "fallback"), ("9" * 30, "latest"),
+])
+@pytest.mark.asyncio
+async def test_a_document_deferral_keeps_the_providers_deadline_as_its_earliest_retry(
+    tmp_path, monkeypatch, clock, value, expect,
+):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail="body", retry_after=value, status=503)
+    state = StateStore(str(tmp_path / "doc.sqlite"))
+    started = datetime.now(timezone.utc)
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    owed = _owed_body(state)
+    assert owed, "the deferred document is still owed"
+    assert summary.authoritative_complete is False and w.pushes == []
+    for _item, failures, not_before in owed:
+        if not_before is None:
+            continue  # a document this run never reached
+        retry_at = datetime.fromisoformat(not_before)
+        if expect == "deadline":
+            assert retry_at >= started + timedelta(seconds=119)  # never before the provider's deadline
+        elif expect == "latest":
+            assert not_before == LATEST
+        else:
+            assert retry_at.year == started.year  # a real, bounded instant
+    if expect == "fallback":
+        assert summary.failure_categories.get("retry_after_malformed", 0) >= 1
+    if expect == "latest":
+        assert summary.failure_categories.get("retry_after_unrepresentable", 0) >= 1
+    state.close()
+
+
+def test_account_holds_merge_monotonically(tmp_path):
+    state = StateStore(str(tmp_path / "merge.sqlite"))
+    long_deadline = "2029-12-01T00:00:00+00:00"
+    assert state.hold_connection(INTEGRATION, GENERATION, ACCOUNT, long_deadline, "rate_limited") == (long_deadline, "rate_limited")
+    # A shorter later hold never shortens a standing one.
+    assert state.hold_connection(INTEGRATION, GENERATION, ACCOUNT, "2026-11-01T00:00:00+00:00", "rate_limited") == (long_deadline, "rate_limited")
+    # A longer one extends it; the last representable instant is the ceiling and stays.
+    assert state.hold_connection(INTEGRATION, GENERATION, ACCOUNT, LATEST, "rate_limited") == (LATEST, "rate_limited")
+    assert state.hold_connection(INTEGRATION, GENERATION, ACCOUNT, long_deadline, "rate_limited") == (LATEST, "rate_limited")
+    # A corrupt value never outranks a real instant.
+    assert state.hold_connection(INTEGRATION, GENERATION, ACCOUNT, "not-a-time", "rate_limited") == (LATEST, "rate_limited")
+    state.close()
+
+
+@pytest.mark.parametrize("remote_offset, expect_remote", [(timedelta(days=30), True), (timedelta(minutes=1), False)])
+@pytest.mark.asyncio
+async def test_an_adopted_hold_extends_but_never_shortens_the_local_one(
+    tmp_path, monkeypatch, clock, remote_offset, expect_remote,
+):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail=None)
+    local = (clock.at + timedelta(days=1)).isoformat()
+    remote = (clock.at + remote_offset).isoformat()
+    w.progress = {"account_hold": {
+        "generation": GENERATION, "credential": ACCOUNT, "not_before": remote, "category": "rate_limited",
+    }}
+    state = StateStore(str(tmp_path / "adopt.sqlite"))
+    state.hold_connection(INTEGRATION, GENERATION, ACCOUNT, local, "rate_limited")
+
+    await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert w.calls == []  # held either way
+    assert _hold(state)[0] == (remote if expect_remote else local)
+    state.close()

diff --git a/ingestion/tests/test_retry_after_parsing.py b/ingestion/tests/test_retry_after_parsing.py
new file mode 100644
index 00000000..68f30641
--- /dev/null
+++ b/ingestion/tests/test_retry_after_parsing.py
@@ -0,0 +1,196 @@
+"""Provider Retry-After: valid delays are honoured exactly; defective input is contained (AIO-1167 R48 D2).
+
+Spec (accepted-spec AC-04:230; Astra R47 adjudication D2). Through the ONE provider-call owner
+(``GoogleDriveSource._provider_call``) and its parser:
+
+  * a valid delay-seconds or HTTP-date is the provider's deadline EXACTLY — ordinary or long
+    (``99999999`` seconds is ~3.2 years and is not shortened); a short one inside the budget is
+    slept, a long one defers with ``not_before`` at the named instant;
+  * malformed input — text, a sign, an exponent, NaN/infinity spellings, an impossible date — never
+    crashes and never yields a non-ISO timestamp: it is ignored for the existing bounded fallback
+    and reported ``retry_after_malformed``;
+  * a syntactically valid value no timestamp can hold (more seconds than ``timedelta`` takes, a
+    deadline past year 9999) never crashes and is held at the last representable instant —
+    fail closed, ``retry_after_unrepresentable`` — never read as permission to retry early.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from email.utils import format_datetime
+
+import pytest
+
+from aios_ingest.sources.gdrive import (
+    LATEST_INSTANT,
+    GoogleDriveSource,
+    ProviderDeferred,
+    parse_retry_after,
+)
+
+NOW = datetime(2026, 10, 31, 12, 0, tzinfo=timezone.utc)
+MALFORMED = [
+    "soon", "", "  ", "-5", "+5", "1e3", "12abc", "0x10", "1_000", "1 000",
+    "nan", "NaN", "-nan", "inf", "Infinity", "-inf", "1e999",
+    "Wed, 31 Feb 2026 10:00:00 GMT", "Sat, 31 Oct 2026 25:00:00 GMT", "Mon, 99 Foo 2026",
+]
+UNREPRESENTABLE = [
+    "9" * 30,                                   # more seconds than timedelta can hold
+    "300000000000",                             # ~9,500 years: past datetime's year 9999
+    "9" * 400 + ".5",                           # a decimal that is infinite as a float
+    "Fri, 31 Dec 99999 23:59:59 GMT",           # a five-digit year
+    "Fri, 31 Dec 9999 23:59:59 -2359",          # 9999-12-31 local, past the last UTC instant
+]
+
+
+@pytest.mark.parametrize("value, expected", [
+    ("120", NOW + timedelta(seconds=120)),
+    (" 7 ", NOW + timedelta(seconds=7)),
+    ("0", NOW),
+    ("1.5", NOW + timedelta(seconds=1.5)),
+    ("99999999", NOW + timedelta(seconds=99999999)),
+    (format_datetime(NOW + timedelta(seconds=300), usegmt=True), NOW + timedelta(seconds=300)),
+    ("Sat, 31 Oct 2026 12:00:00 +0530", datetime(2026, 10, 31, 6, 30, tzinfo=timezone.utc)),
+    ("Fri, 31 Dec 9999 23:59:59 GMT", datetime(9999, 12, 31, 23, 59, 59, tzinfo=timezone.utc)),
+])
+def test_valid_delays_and_dates_are_the_named_deadline_exactly(value, expected):
+    retry = parse_retry_after(value, NOW)
+    assert retry.kind == "valid" and retry.deadline == expected
+
+
+def test_a_long_valid_delay_is_not_shortened():
+    retry = parse_retry_after("99999999", NOW)
+    assert retry.deadline is not None and retry.deadline.year == 2029
+    assert (retry.deadline - NOW).total_seconds() == 99999999
+
+
+@pytest.mark.parametrize("value", MALFORMED)
+def test_malformed_input_is_classified_malformed(value):
+    assert parse_retry_after(value, NOW).kind == "malformed"
+
+
+@pytest.mark.parametrize("value", UNREPRESENTABLE)
+def test_unrepresentable_valid_input_is_classified_unrepresentable(value):
+    assert parse_retry_after(value, NOW).kind == "unrepresentable"
+
+
+def _source(attempts: int = 1, deadline: float = 1) -> GoogleDriveSource:
+    return GoogleDriveSource(
+        file_ids=["doc"], api_mode="docs", drive_service=object(), docs_service=object(),
+        request_deadline_seconds=deadline, provider_retry_attempts=attempts,
+    )
+
+
+def _answer(status: int, retry_after: str | None):
+    class Response:
+        def __init__(self):
+            self.status = status
+            self.headers = {"Retry-After": retry_after} if retry_after is not None else {}
+
+    class GoogleHttpError(Exception):
+        resp = Response()
+
+    return GoogleHttpError(f"HTTP {status}")
+
+
+def _defer(status: int, retry_after: str | None, monkeypatch) -> ProviderDeferred:
+    monkeypatch.setattr("aios_ingest.sources.gdrive.time.sleep", lambda _d: pytest.fail("must defer, not sleep"))
+    calls = []
+
+    def request():
+        calls.append(1)
+        raise _answer(status, retry_after)
+
+    with pytest.raises(ProviderDeferred) as raised:
+        _source()._provider_call(request)
+    assert len(calls) == 1
+    return raised.value
+
+
+@pytest.mark.parametrize("status, category", [(429, "rate_limited"), (503, "provider_unavailable")])
+@pytest.mark.parametrize("value, seconds", [("120", 120), ("99999999", 99999999)])
+def test_a_valid_delay_beyond_the_budget_defers_to_exactly_the_named_instant(monkeypatch, status, category, value, seconds):
+    before = datetime.now(timezone.utc)
+    deferred = _defer(status, value, monkeypatch)
+    after = datetime.now(timezone.utc)
+    named = datetime.fromisoformat(deferred.not_before)
+    assert before + timedelta(seconds=seconds) <= named <= after + timedelta(seconds=seconds)
+    assert deferred.category == category and deferred.diagnostic is None
+
+
+def test_a_valid_http_date_defers_to_that_instant(monkeypatch):
+    target = (datetime.now(timezone.utc) + timedelta(hours=2)).replace(microsecond=0)
+    deferred = _defer(429, format_datetime(target, usegmt=True), monkeypatch)
+    assert datetime.fromisoformat(deferred.not_before) == target
+
+
+def test_a_short_valid_delay_inside_the_budget_is_slept_exactly(monkeypatch):
+    slept: list[float] = []
+    monkeypatch.setattr("aios_ingest.sources.gdrive.time.sleep", slept.append)
+    answers = [_answer(429, "2"), {"ok": True}]
+
+    def request():
+        answer = answers.pop(0)
+        if isinstance(answer, Exception):
+            raise answer
+        return answer
+
+    assert _source(attempts=3, deadline=30)._provider_call(request) == {"ok": True}
+    assert len(slept) == 1 and 1.9 <= slept[0] <= 2.0
+
+
+@pytest.mark.parametrize("value", MALFORMED)
+def test_malformed_input_never_crashes_and_uses_the_bounded_fallback(monkeypatch, value):
+    before = datetime.now(timezone.utc)
+    deferred = _defer(429, value, monkeypatch)
+    named = datetime.fromisoformat(deferred.not_before)  # a real ISO instant
+    assert before <= named <= datetime.now(timezone.utc) + timedelta(seconds=4.2)
+    assert deferred.diagnostic == "retry_after_malformed"
+    assert deferred.category == "rate_limited"
+    assert "malformed" in str(deferred)
+
+
+@pytest.mark.parametrize("value", MALFORMED[:6])
+def test_malformed_input_inside_the_budget_backs_off_instead_of_busy_looping(monkeypatch, value):
+    slept: list[float] = []
+    monkeypatch.setattr("aios_ingest.sources.gdrive.time.sleep", slept.append)
+    monkeypatch.setattr("aios_ingest.sources.gdrive.random.uniform", lambda *_a: 0)
+    answers = [_answer(503, value), {"ok": True}]
+
+    def request():
+        answer = answers.pop(0)
+        if isinstance(answer, Exception):
+            raise answer
+        return answer
+
+    assert _source(attempts=3, deadline=30)._provider_call(request) == {"ok": True}
+    assert slept == [0.25]
+
+
+@pytest.mark.parametrize("status, category", [(429, "rate_limited"), (503, "provider_unavailable")])
+@pytest.mark.parametrize("value", UNREPRESENTABLE)
+def test_unrepresentable_input_fails_closed_at_the_last_instant(monkeypatch, status, category, value):
+    deferred = _defer(status, value, monkeypatch)
+    assert deferred.not_before == LATEST_INSTANT.isoformat()
+    assert datetime.fromisoformat(deferred.not_before) == LATEST_INSTANT
+    assert deferred.diagnostic == "retry_after_unrepresentable" and deferred.category == category
+
+
+def test_unrepresentable_input_is_not_retried_even_with_attempts_and_budget_left(monkeypatch):
+    monkeypatch.setattr("aios_ingest.sources.gdrive.time.sleep", lambda _d: pytest.fail("no early retry"))
+    calls = []
+
+    def request():
+        calls.append(1)
+        raise _answer(429, "9" * 30)
+
+    with pytest.raises(ProviderDeferred) as raised:
+        _source(attempts=5, deadline=30)._provider_call(request)
+    assert len(calls) == 1 and raised.value.not_before == LATEST_INSTANT.isoformat()
+
+
+def test_retry_after_seconds_reports_only_valid_deadlines():
+    assert GoogleDriveSource._retry_after(_answer(429, "7")) == pytest.approx(7, abs=0.5)
+    assert GoogleDriveSource._retry_after(_answer(429, "inf")) is None
+    assert GoogleDriveSource._retry_after(_answer(429, "9" * 30)) is None
+    assert GoogleDriveSource._retry_after(_answer(429, None)) is None

