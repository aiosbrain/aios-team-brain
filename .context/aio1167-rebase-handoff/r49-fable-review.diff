index 00000000..8fd78f50
--- /dev/null
+++ b/ingestion/tests/test_account_hold_before_streams.py
@@ -0,0 +1,334 @@
+"""The account Retry-After hold read BEFORE any stream exists (AIO-1167 R47 F5).
+
+Spec (AC-04:230 bounded recovery, AC-07 truthful diagnostics; adjudication F5). A provider rate
+limit read while binding a selected root (its metadata) or capturing a stream's start token is the
+ACCOUNT's wait, exactly like one read during a drain — even though no stream exists yet to carry it.
+Through the real coordinator:
+
+  * the hold is persisted locally for this connection generation and verified account, and
+    published onto the brain's acknowledged progress (nothing else in that document changes);
+  * an immediate retry, a restart, and a fresh state file restoring the brain's progress all make
+    NO provider call before the not-before;
+  * the run reports a held (partial) run with the provider category — no document failure, no
+    deletion evidence; after the deadline the work resumes;
+  * a failed publication keeps the local hold and says so, never claiming remote durability;
+  * a local budget stop is not a provider wait and opens no hold (control);
+  * a hold recorded for another generation or account does not hold this one (scope);
+  * a drain-phase hold also holds the next run's root and start-token reads.
+"""
+
+from __future__ import annotations
+
+import copy
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+import pytest
+
+from aios_ingest.brain_client import BrainError, GdriveExecution, IngestResult
+from aios_ingest.config import BrainSettings, Connection
+from aios_ingest.gdrive_sync import run_gdrive_stream
+from aios_ingest.normalize import RawDoc
+from aios_ingest.sources.gdrive import GoogleDriveSource as RealDriveSource
+from aios_ingest.sources.gdrive import ProviderDeferred
+from aios_ingest.state import StateStore
+
+INTEGRATION = "00000000-0000-0000-0000-0000000000f5"
+GENERATION = 4
+ACCOUNT = "account"
+DOC_MIME = "application/vnd.google-apps.document"
+T0 = datetime(2026, 10, 31, 12, 0, tzinfo=timezone.utc)
+HOLD_UNTIL = (T0 + timedelta(hours=1)).isoformat()
+SETTINGS = BrainSettings("http://brain", "key", "team")
+CONNECTION = Connection("docs", "gdrive", options={"integration_id": INTEGRATION}, project="docs")
+
+FILE_ROOT = {"fileIds": ["doc-drive-a"], "sharedDriveIds": []}
+DRIVE_ROOTS = {"fileIds": [], "sharedDriveIds": ["drive-a", "drive-b"]}
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = SimpleNamespace(at=T0)
+    monkeypatch.setattr("aios_ingest.gdrive_sync._now", lambda: now.at.isoformat())
+    return now
+
+
+def provider_deferral(status: int, retry_after: str | None) -> ProviderDeferred:
+    """The ProviderDeferred the REAL provider-call owner raises for one HTTP answer — so the
+    Retry-After is parsed and represented exactly as in production (AIO-1167 R48 D2)."""
+
+    class Response:
+        def __init__(self):
+            self.status = status
+            self.headers = {"Retry-After": retry_after} if retry_after is not None else {}
+
+    class GoogleHttpError(Exception):
+        resp = Response()
+
+    def request():
+        raise GoogleHttpError(f"HTTP {status}")
+
+    source = RealDriveSource(
+        file_ids=["any"], api_mode="docs", drive_service=object(), docs_service=object(),
+        request_deadline_seconds=1, provider_retry_attempts=1,
+    )
+    try:
+        source._provider_call(request)
+    except ProviderDeferred as exc:
+        return exc
+    raise AssertionError("the provider call did not defer")
+
+
+def world(
+    monkeypatch, *, selection: dict, fail: str | None, category: str = "rate_limited",
+    retry_after: str | None = None, status: int = 429,
+):
+    """The real coordinator; Google and the brain are fakes. ``fail`` names the ONE provider phase
+    that answers ``category`` until it is cleared; ``checkpoint_error`` makes publication fail.
+    With ``retry_after`` set, the deferral is the real provider owner's answer to HTTP ``status``
+    carrying that Retry-After header (R48 D2)."""
+    w = SimpleNamespace(fail=fail, calls=[], pushes=[], progress={}, revision=0, checkpoint_error=None)
+
+    def deferred() -> ProviderDeferred:
+        if retry_after is not None:
+            return provider_deferral(status, retry_after)
+        until = HOLD_UNTIL if category == "rate_limited" else None
+        return ProviderDeferred("429 Too Many Requests", not_before=until, category=category)
+
+    class Request:
+        def __init__(self, kind, value):
+            self.kind, self.value = kind, value
+
+        def execute(self):
+            return self.value
+
+    class Changes:
+        def getStartPageToken(self, **kwargs):
+            return Request("start", {"startPageToken": f"start:{kwargs.get('driveId')}"})
+
+        def list(self, **kwargs):
+            return Request("changes", {"changes": [], "newStartPageToken": f"terminal:{kwargs.get('driveId')}"})
+
+    class Files:
+        def list(self, **kwargs):
+            drive = kwargs.get("driveId")
+            return Request("list", {"files": [{
+                "id": f"doc-{drive}", "name": f"Doc {drive}", "mimeType": DOC_MIME, "driveId": drive,
+                "modifiedTime": "2026-10-30T00:00:00Z",
+            }]})
+
+    class Drive:
+        def changes(self): return Changes()
+        def files(self): return Files()
+
+    class Source:
+        def __init__(self, **kwargs): pass
+        def set_run_deadline(self, deadline): pass
+        def _services(self): return Drive(), object()
+
+        def _execute(self, request):
+            w.calls.append(request.kind)
+            if w.fail == request.kind:
+                raise deferred()
+            return request.execute()
+
+        def _metadata(self, file_id):
+            w.calls.append("metadata")
+            if w.fail == "metadata":
+                raise deferred()
+            drive = file_id.removeprefix("doc-")
+            return {"id": file_id, "name": f"Doc {drive}", "mimeType": DOC_MIME, "driveId": drive,
+                    "modifiedTime": "2026-10-30T00:00:00Z", "parents": []}
+
+        def _raw_doc(self, meta):
+            w.calls.append("body")
+            if w.fail == "body":
+                raise deferred()
+            return RawDoc(source="gdrive", external_id=meta["id"], title=meta["name"], body="body text")
+
+    class Client:
+        def __init__(self, *args, **kwargs): pass
+        async def __aenter__(self): return self
+        async def __aexit__(self, *args): pass
+
+        async def acquire_gdrive_execution(self, requested, owner):
+            return GdriveExecution(requested, GENERATION, 1, owner, "later", "scope", {
+                "authMode": "oauth", "authenticatedAccountId": ACCOUNT, "folderIds": [],
+                "selectionState": "selected", **selection,
+            }, progress=copy.deepcopy(w.progress), progress_revision=w.revision)  # a wire copy
+
+        async def broker_gdrive_access_token(self, execution):
+            return {"access_token": "memory", "account": {"subject": ACCOUNT}}
+
+        def gdrive_token_provider(self, execution, grant):
+            return SimpleNamespace(close=lambda: None)
+
+        def gdrive_provider_gate(self, execution):
+            class Gate:
+                def __call__(self): pass
+                def close(self): pass
+            return Gate()
+
+        async def checkpoint_gdrive_execution(self, execution, payload):
+            if w.checkpoint_error is not None:
+                raise w.checkpoint_error
+            w.revision += 1
+            w.progress = copy.deepcopy(payload)
+            return {"progress_revision": w.revision, "progress": copy.deepcopy(payload)}
+
+        async def push(self, item, *, execution=None):
+            w.pushes.append(item.path)
+            return IngestResult("created", f"item-{len(w.pushes)}", item.path)
+
+        async def reconcile_gdrive(self, execution, **kwargs):
+            return {"items": 0}
+
+        async def release_gdrive_execution(self, execution): pass
+
+    monkeypatch.setattr("aios_ingest.gdrive_sync.BrainClient", Client)
+    monkeypatch.setattr("aios_ingest.gdrive_sync.GoogleDriveSource", Source)
+    return w
+
+
+def _owed_count(state: StateStore) -> int:
+    return state._db.execute(
+        "SELECT count(*) FROM pending_work WHERE acknowledged_at IS NULL AND superseded_at IS NULL",
+    ).fetchone()[0]
+
+
+def _assert_held_run(summary, w, *, phase: str) -> None:
+    assert summary.failure_categories.get("rate_limited") == 1
+    assert summary.failed == 0 and summary.skipped == 1
+    assert summary.authoritative_complete is False
+    assert w.calls.count(phase) == 1 and w.calls[-1] == phase  # nothing read after the limit
+    assert w.pushes == []
+
+
+@pytest.mark.parametrize("selection, phase", [(FILE_ROOT, "metadata"), (DRIVE_ROOTS, "start")])
+@pytest.mark.asyncio
+async def test_an_early_rate_limit_holds_the_account_across_retry_restart_and_restore(
+    tmp_path, monkeypatch, clock, selection, phase,
+):
+    w = world(monkeypatch, selection=selection, fail=phase)
+    state = StateStore(str(tmp_path / "first.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    _assert_held_run(summary, w, phase=phase)
+    # Before ANY stream exists the hold is durable: locally, and on the brain.
+    assert state.list_progress(INTEGRATION, GENERATION) == []
+    assert state.connection_hold(INTEGRATION, GENERATION, ACCOUNT) == (HOLD_UNTIL, "rate_limited")
+    assert w.progress["account_hold"] == {
+        "generation": GENERATION, "credential": ACCOUNT, "not_before": HOLD_UNTIL, "category": "rate_limited",
+    }
+    assert _owed_count(state) == 0  # no document failure, no deletion evidence
+
+    before = list(w.calls)
+    clock.at = T0 + timedelta(minutes=10)
+    # An immediate manual/scheduled retry on the same state.
+    retry = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    assert w.calls == before
+    assert retry.failure_categories == {"rate_limited": 1} and retry.failed == 0
+    # A restart: the same state file reopened.
+    state.close()
+    state = StateStore(str(tmp_path / "first.sqlite"))
+    await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    assert w.calls == before
+    # Another state file, restoring only what the brain holds.
+    fresh = StateStore(str(tmp_path / "restored.sqlite"))
+    restored = await run_gdrive_stream(SETTINGS, CONNECTION, fresh)
+    assert w.calls == before
+    assert restored.failure_categories == {"rate_limited": 1}
+    assert fresh.connection_hold(INTEGRATION, GENERATION, ACCOUNT) == (HOLD_UNTIL, "rate_limited")
+
+    # After the deadline the account is read again and the work completes.
+    clock.at = T0 + timedelta(hours=2)
+    w.fail = None
+    resumed = await run_gdrive_stream(SETTINGS, CONNECTION, fresh)
+    assert "rate_limited" not in resumed.failure_categories
+    assert w.calls.count(phase) >= 2
+    assert w.pushes
+    # The passed hold is no longer published.
+    assert "account_hold" not in w.progress
+    state.close()
+    fresh.close()
+
+
+@pytest.mark.asyncio
+async def test_a_failed_publication_keeps_the_local_hold_and_says_so(tmp_path, monkeypatch, clock):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail="start")
+    w.checkpoint_error = BrainError(503, "server_error", "brain unavailable")
+    state = StateStore(str(tmp_path / "unpublished.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories == {"rate_limited": 1, "account_hold_unpublished": 1}
+    assert summary.failed == 0
+    assert state.connection_hold(INTEGRATION, GENERATION, ACCOUNT) == (HOLD_UNTIL, "rate_limited")
+    assert "account_hold" not in w.progress  # never claimed remote-durable
+
+    # This sidecar still honours its local hold.
+    before = list(w.calls)
+    clock.at = T0 + timedelta(minutes=10)
+    w.checkpoint_error = None
+    await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    assert w.calls == before
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_local_budget_stop_opens_no_hold(tmp_path, monkeypatch, clock):
+    """Control: the run's own deadline is not Google's wait."""
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail="start", category="dispatch_deadline")
+    state = StateStore(str(tmp_path / "budget.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories.get("dispatch_deadline") == 1
+    assert state.connection_hold(INTEGRATION, GENERATION, ACCOUNT) is None
+    assert "account_hold" not in w.progress
+    w.fail = None
+    await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    assert w.calls.count("start") >= 2  # the next run reads at once
+    state.close()
+
+
+@pytest.mark.parametrize("hold", [
+    {"generation": GENERATION - 1, "credential": ACCOUNT, "not_before": HOLD_UNTIL, "category": "rate_limited"},
+    {"generation": GENERATION, "credential": "another-account", "not_before": HOLD_UNTIL, "category": "rate_limited"},
+])
+@pytest.mark.asyncio
+async def test_a_hold_for_another_generation_or_account_does_not_hold_this_one(
+    tmp_path, monkeypatch, clock, hold,
+):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail=None)
+    w.progress = {"account_hold": hold}
+    state = StateStore(str(tmp_path / "scoped.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert "rate_limited" not in summary.failure_categories
+    assert w.calls.count("start") == 2
+    assert state.connection_hold(INTEGRATION, GENERATION, ACCOUNT) is None
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_drain_phase_hold_also_holds_the_next_runs_root_and_start_reads(tmp_path, monkeypatch, clock):
+    w = world(monkeypatch, selection=DRIVE_ROOTS, fail="list")
+    state = StateStore(str(tmp_path / "drain.sqlite"))
+
+    summary = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+
+    assert summary.failure_categories.get("rate_limited") == 1
+    assert state.connection_hold(INTEGRATION, GENERATION, ACCOUNT) == (HOLD_UNTIL, "rate_limited")
+    assert w.progress["account_hold"]["not_before"] == HOLD_UNTIL
+    # A fresh state file restoring the brain's progress makes no provider call — not even a
+    # start-token capture for a stream its own state lacks.
+    before = list(w.calls)
+    clock.at = T0 + timedelta(minutes=10)
+    fresh = StateStore(str(tmp_path / "drain-restored.sqlite"))
+    await run_gdrive_stream(SETTINGS, CONNECTION, fresh)
+    assert w.calls == before
+    state.close()
+    fresh.close()

diff --git a/ingestion/tests/test_bound_root_loss.py b/ingestion/tests/test_bound_root_loss.py
new file mode 100644
index 00000000..072a269d
--- /dev/null
+++ b/ingestion/tests/test_bound_root_loss.py
@@ -0,0 +1,279 @@
+"""A previously bound selected root's verified loss has a durable outcome (AIO-1167 R48 D1).
+
+Spec (accepted-spec AC-03/05/07; Astra R47 adjudication D1). Through the real coordinator over the
+``_DriveWorld`` double (Google and the brain as the coordinator's own calls see them):
+
+  * a bound folder root that is hard-deleted — its OWN metadata answers 404 — is recorded as
+    unavailable (bound, with an actionable detail that travels in the fenced root evidence). Its
+    traversal is finished without listing it, the rescan publishes, the cursor advances, and no
+    generic ``provider_read`` is reported — even when Google answers the folder's listing 404;
+  * a bound file root that disappears before a 410 rescan finishes its page empty the same way;
+  * only that root's support is retired: a directly selected document under it, another root's
+    documents and another connection's claim all survive;
+  * completion is restart-safe, and a fresh state file restoring the brain re-derives it;
+  * another root that cannot be verified keeps the run partial and withholds scope-wide absence;
+    an auth / permission / server error on the root, a listing 404 of a folder that exists, and a
+    never-bound root are never treated as loss;
+  * a restored root is enumerated again, under the same provider identity, once it can be read.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.sources.gdrive import ProviderCursorInvalid
+from aios_ingest.state import StateStore
+from test_gdrive_upgrade import _ClaimLedger, _DriveWorld, _ProviderHttpError
+
+GEN = 9
+DETAIL = "selected root unavailable"
+
+
+def _binding(state, world, kind, root_id):
+    return state.root_obligations(world.integration_id, GEN).get((kind, root_id))
+
+
+def _remote_root(world, kind, root_id):
+    return next(
+        item for item in world.progress["roots"]["items"]
+        if item["kind"] == kind and item["id"] == root_id
+    )
+
+
+def _folder_world(monkeypatch, *, file_ids=("doc-1",)):
+    """``folder-r`` (doc-1, and folder-n holding doc-2) and ``folder-k`` (doc-k) in one Shared Drive;
+    doc-1 is also selected directly."""
+    world = _DriveWorld(file_ids=list(file_ids), folder_ids=["folder-r", "folder-k"]).install(monkeypatch)
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("folder-n", drive="shared-a", parent="folder-r", folder=True)
+    world.put("folder-k", drive="shared-a", folder=True)
+    world.put("doc-1", drive="shared-a", parent="folder-r")
+    world.put("doc-2", drive="shared-a", parent="folder-n")
+    world.put("doc-k", drive="shared-a", parent="folder-k")
+    world.missing_folder_listing_404 = True
+    return world
+
+
+def _delete_folder_r(world):
+    """folder-r is hard-deleted for this account; doc-1 stays shared directly with it."""
+    for gone in ("folder-r", "folder-n", "doc-2"):
+        world.files.pop(gone)
+    world.logs.setdefault("shared-a", []).append({"fileId": "folder-r", "removed": True})
+
+
+@pytest.mark.asyncio
+async def test_a_hard_deleted_bound_folder_root_completes_its_rescan_and_retires_only_its_support(
+    tmp_path, monkeypatch,
+):
+    world = _folder_world(monkeypatch)
+    world.ledger = _ClaimLedger()
+    world.ledger.push("another-connection", "doc-2")  # another connection also claims doc-2
+    path = str(tmp_path / "folder-loss.sqlite")
+    state = StateStore(path)
+    namespace = world.namespace("shared-a")
+    assert (await world.run(state)).authoritative_complete is True
+    assert world.reconciled == [["doc-1", "doc-2", "doc-k"]]
+
+    _delete_folder_r(world)
+    world.calls.clear()
+    world.pushed.clear()
+    # The tombstone page: doc-2 (under folder-r only) is a positive removal, and a rescan is seeded.
+    seeded = await world.run(state)
+    assert seeded.authoritative_complete is False
+    assert state.next_uncommitted_page(namespace, GEN).rescan_snapshot_id is not None
+    # The rescan, on the next run.
+    summary = await world.run(state)
+
+    # The deleted root was read once, positively not found, and never listed.
+    assert ("metadata", "folder-r") in world.calls
+    assert not any(call[0] == "list" and call[2] in ("folder-r", "folder-n") for call in world.calls)
+    assert "provider_read" not in summary.failure_categories
+    assert summary.failure_categories.get("selection_root_unavailable") == 1
+    # The rescan published and the cursor passed the tombstone page.
+    progress = state.get_progress(namespace)
+    assert progress.building_snapshot is None and progress.listing_complete is True
+    assert state.next_uncommitted_page(namespace, GEN) is None
+    # Only folder-r's support is retired: the direct selection and the other root stand.
+    assert state.membership_ids(namespace, GEN) == ["doc-1", "doc-k"]
+    assert summary.authoritative_complete is True
+    assert world.reconciled[-1] == ["doc-1", "doc-k"]
+    assert "doc-1" not in world.removed and "doc-k" not in world.removed
+    # Another connection's claim on doc-2 survives this connection's reconciliation.
+    assert ("another-connection" in world.ledger.claims["doc-2"]) and "doc-2" not in world.ledger.deleted
+    # The outcome is durable root evidence, locally and on the brain, with an actionable detail.
+    binding = _binding(state, world, "folder", "folder-r")
+    assert binding.status == "bound" and DETAIL in (binding.detail or "")
+    assert DETAIL in (_remote_root(world, "folder", "folder-r")["detail"] or "")
+    state.close()
+
+    assert "doc-2" not in world.pushed  # the lost root's document is never re-ingested
+
+    # Restart: nothing is re-listed, nothing is re-pushed, and it stays complete.
+    state = StateStore(path)
+    world.calls.clear()
+    world.pushed.clear()
+    again = await world.run(state)
+    assert not any(call[0] == "list" and call[2] == "folder-r" for call in world.calls)
+    assert "provider_read" not in again.failure_categories
+    assert world.pushed == []
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_fresh_state_file_re_derives_the_lost_roots_outcome_from_the_brain(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "first.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    _delete_folder_r(world)
+    await world.run(state)  # tombstone page; rescan seeded
+    assert (await world.run(state)).authoritative_complete is True
+    state.close()
+
+    fresh = StateStore(str(tmp_path / "fresh.sqlite"))
+    world.calls.clear()
+    restored = await world.run(fresh)
+    assert not any(call[0] == "list" and call[2] in ("folder-r", "folder-n") for call in world.calls)
+    assert "provider_read" not in restored.failure_categories
+    assert restored.failed == 0
+    assert "doc-2" not in world.reconciled[-1]
+    fresh.close()
+
+
+@pytest.mark.asyncio
+async def test_a_bound_file_root_lost_before_a_410_rescan_finishes_its_page_empty(tmp_path, monkeypatch):
+    world = _DriveWorld(file_ids=["file-x", "file-y"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    path = str(tmp_path / "file-loss.sqlite")
+    state = StateStore(path)
+    namespace = world.namespace("shared-a")
+    assert (await world.run(state)).authoritative_complete is True
+    assert world.reconciled == [["file-x", "file-y"]]
+
+    world.files.pop("file-x")
+    world.cursor_errors["shared-a"] = ProviderCursorInvalid("expired")
+    assert (await world.run(state)).failure_categories.get("invalid_cursor") == 1
+    world.cursor_errors.clear()
+    world.pushed.clear()
+    summary = await world.run(state)
+
+    assert "provider_read" not in summary.failure_categories
+    assert summary.failure_categories.get("selection_root_unavailable") == 1
+    assert state.next_uncommitted_page(namespace, GEN) is None
+    assert state.membership_ids(namespace, GEN) == ["file-y"]
+    assert summary.authoritative_complete is True and world.reconciled[-1] == ["file-y"]
+    assert "file-x" not in world.pushed
+    assert DETAIL in (_binding(state, world, "file", "file-x").detail or "")
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_another_unverifiable_root_keeps_the_run_partial_and_withholds_absence(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "partial.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    _delete_folder_r(world)
+    world.unreadable["folder-k"] = _ProviderHttpError(500)  # the other root cannot be read now
+    await world.run(state)  # tombstone page; rescan seeded
+    for _ in range(2):  # the rescan meets the unverifiable root, run after run
+        summary = await world.run(state)
+        assert summary.authoritative_complete is False
+        assert world.reconciled == reconciled  # no scope-wide absence
+    # The other root's documents keep their claims; only the positive tombstone removal flowed.
+    assert "doc-k" not in world.removed and "doc-1" not in world.removed
+    state.close()
+
+
+@pytest.mark.parametrize("status", [401, 403, 500])
+@pytest.mark.asyncio
+async def test_an_auth_permission_or_server_error_on_the_root_is_never_loss(tmp_path, monkeypatch, status):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / f"err-{status}.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    # The change log reports the folder, but its metadata answers an error that proves nothing.
+    world.logs.setdefault("shared-a", []).append({"fileId": "folder-r", "file": dict(world.files["folder-r"])})
+    world.unreadable["folder-r"] = _ProviderHttpError(status)
+    world.calls.clear()
+    for _ in range(3):  # the change page, then the rescan that reads the root, run after run
+        summary = await world.run(state)
+        assert "selection_root_unavailable" not in summary.failure_categories
+        assert summary.authoritative_complete is False
+    assert ("metadata", "folder-r") in world.calls  # the root really was read
+    binding = _binding(state, world, "folder", "folder-r")
+    assert DETAIL not in (binding.detail or "")
+    assert world.reconciled == reconciled and world.removed == []
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_listing_404_of_a_folder_that_exists_is_not_absence(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "listing-404.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    def listing_404():
+        raise _ProviderHttpError(404)
+
+    world.logs.setdefault("shared-a", []).append({"fileId": "folder-n", "file": dict(world.files["folder-n"])})
+    world.hooks[("list", "shared-a", "folder-r")] = listing_404
+    world.calls.clear()
+    outcomes = [await world.run(state), await world.run(state)]
+
+    assert ("list", "shared-a", "folder-r") in world.calls  # the rescan listed it, and was refused
+    assert all("selection_root_unavailable" not in o.failure_categories for o in outcomes)
+    assert outcomes[1].authoritative_complete is False
+    assert world.reconciled == reconciled and world.removed == []
+    assert DETAIL not in (_binding(state, world, "folder", "folder-r").detail or "")
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_never_bound_root_404_stays_unresolved_not_lost(tmp_path, monkeypatch):
+    world = _DriveWorld(folder_ids=["folder-ghost", "folder-k"]).install(monkeypatch)
+    world.put("folder-k", drive="shared-a", folder=True)
+    world.put("doc-k", drive="shared-a", parent="folder-k")
