@@ -0,0 +1,336 @@
+"""Root evidence on the change-page path, and verified file-root restoration (AIO-1167 R49 F2/F3).
+
+Spec (Astra R48 adjudication F2/F3/F6; AC-05/07). Through the real coordinator over ``_DriveWorld``,
+with every provider deferral produced by the REAL provider-call owner:
+
+F2 — when a change page reads a bound root (``absence_withheld``):
+  * only a root read present where it is bound is settled; a duplicate tombstone for a root already
+    recorded unavailable keeps that detail, locally and in the published evidence;
+  * a malformed or unrepresentable Retry-After on that read keeps its diagnostic;
+  * a quota answer (429, or 403 naming a rate-limit reason) is the ACCOUNT's: no further call is made
+    for the account — not even a sibling stream's — the page stays unresolved and nothing is
+    removed; a non-quota answer stays this stream's, and the sibling stream still runs.
+
+F3 — a restored selected file root clears its stale "unavailable" detail only when fresh metadata in
+the bound drive and ACCEPTED ingestion of the same stable id prove it; a change-log hint, a changed
+drive, failed access, superseded work or failed extraction never does.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.sources.gdrive import GoogleDriveSource, ProviderCursorInvalid, ProviderDeferred
+from aios_ingest.state import StateStore
+from test_bound_root_loss import DETAIL, _binding, _delete_folder_r, _folder_world, _remote_root
+from test_gdrive_upgrade import _DriveWorld, _ProviderHttpError
+
+GEN = 9
+
+
+def real_deferral(status: int, retry_after: str | None = None, reason: str | None = None) -> ProviderDeferred:
+    """The REAL provider-call owner's ProviderDeferred for one HTTP answer."""
+
+    class Response:
+        def __init__(self):
+            self.status = status
+            self.headers = {"Retry-After": retry_after} if retry_after is not None else {}
+
+    class GoogleHttpError(Exception):
+        resp = Response()
+        error_details = [{"reason": reason}] if reason else []
+
+    def request():
+        raise GoogleHttpError(f"HTTP {status}")
+
+    source = GoogleDriveSource(
+        file_ids=["any"], api_mode="docs", drive_service=object(), docs_service=object(),
+        request_deadline_seconds=1, provider_retry_attempts=1,
+    )
+    with pytest.raises(ProviderDeferred) as raised:
+        source._provider_call(request)
+    return raised.value
+
+
+async def _lose_folder_r(world, state):
+    """Baseline, then folder-r is hard-deleted and recorded unavailable (D1)."""
+    assert (await world.run(state)).authoritative_complete is True
+    _delete_folder_r(world)
+    await world.run(state)
+    assert (await world.run(state)).authoritative_complete is True
+    assert DETAIL in (_binding(state, world, "folder", "folder-r").detail or "")
+
+
+@pytest.mark.asyncio
+async def test_a_duplicate_tombstone_keeps_the_unavailable_detail(tmp_path, monkeypatch):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "dup.sqlite"))
+    await _lose_folder_r(world, state)
+    removed_before = list(world.removed)
+
+    world.logs["shared-a"].append({"fileId": "folder-r", "removed": True})
+    world.calls.clear()
+    await world.run(state)
+
+    assert ("metadata", "folder-r") in world.calls  # the change page really read the root
+    assert DETAIL in (_binding(state, world, "folder", "folder-r").detail or "")
+    assert DETAIL in (_remote_root(world, "folder", "folder-r")["detail"] or "")
+    assert "doc-1" not in world.removed and "doc-k" not in world.removed
+    assert world.removed[: len(removed_before)] == removed_before
+    state.close()
+
+
+@pytest.mark.parametrize("header, diagnostic", [
+    ("soon", "retry_after_malformed"), ("9" * 30, "retry_after_unrepresentable"),
+])
+@pytest.mark.asyncio
+async def test_a_root_read_deferral_on_the_change_page_keeps_its_retry_after_diagnostic(
+    tmp_path, monkeypatch, header, diagnostic,
+):
+    world = _folder_world(monkeypatch)
+    state = StateStore(str(tmp_path / "diag.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+
+    world.files.pop("doc-2")
+    world.logs["shared-a"].append({"fileId": "doc-2", "removed": True})
+    world.unreadable["folder-r"] = real_deferral(503, header)
+    summary = await world.run(state)
+
+    assert summary.failure_categories.get(diagnostic) == 1
+    assert summary.failure_categories.get("provider_unavailable") == 1
+    assert world.removed == [] and world.reconciled == reconciled
+    state.close()
+
+
+def _two_stream_world(monkeypatch):
+    world = _DriveWorld(folder_ids=["folder-r", "folder-s"]).install(monkeypatch)
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("doc-2", drive="shared-a", parent="folder-r")
+    world.put("folder-s", drive="shared-b", folder=True)
+    world.put("doc-s", drive="shared-b", parent="folder-s")
+    return world
+
+
+def _shared_a_first(state, world):
+    state._db.execute(
+        "UPDATE connection_stream_schedule SET next_drive_id='shared-a' WHERE connection_id=? AND generation=?",
+        (world.integration_id, GEN),
+    )
+    state._db.commit()
+
+
+@pytest.mark.parametrize("deferral", [
+    lambda: real_deferral(429, "120"),
+    lambda: real_deferral(403, "120", reason="userRateLimitExceeded"),
+], ids=["429", "403-rate-limit"])
+@pytest.mark.asyncio
+async def test_a_quota_answer_on_the_root_read_holds_the_account_and_stops_the_sibling_stream(
+    tmp_path, monkeypatch, deferral,
+):
+    world = _two_stream_world(monkeypatch)
+    state = StateStore(str(tmp_path / "quota.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    cursor = state.get_progress(world.namespace("shared-a")).page_token
+
+    world.files.pop("doc-2")
+    world.logs["shared-a"].append({"fileId": "doc-2", "removed": True})
+    world.unreadable["folder-r"] = deferral()
+    _shared_a_first(state, world)
+    world.calls.clear()
+    summary = await world.run(state)
+
+    assert summary.failure_categories.get("rate_limited") == 1
+    root_read = world.calls.index(("metadata", "folder-r"))
+    assert world.calls[root_read + 1:] == []  # no further account call, the sibling included
+    assert not any(call[:2] == ("changes", "shared-b") for call in world.calls)
+    assert state.connection_hold(world.integration_id, GEN, "account") is not None
+    assert world.removed == []
+    assert state.get_progress(world.namespace("shared-a")).page_token == cursor  # page unresolved
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_non_quota_answer_on_the_root_read_stays_this_streams(tmp_path, monkeypatch):
+    world = _two_stream_world(monkeypatch)
+    state = StateStore(str(tmp_path / "nonquota.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+
+    world.files.pop("doc-2")
+    world.logs["shared-a"].append({"fileId": "doc-2", "removed": True})
+    world.unreadable["folder-r"] = real_deferral(503)
+    _shared_a_first(state, world)
+    world.calls.clear()
+    summary = await world.run(state)
+
+    assert "rate_limited" not in summary.failure_categories
+    assert summary.failure_categories.get("provider_unavailable") == 1
+    root_read = world.calls.index(("metadata", "folder-r"))
+    assert any(call[:2] == ("changes", "shared-b") for call in world.calls[root_read + 1:])
+    assert state.connection_hold(world.integration_id, GEN, "account") is None
+    assert world.removed == []
+    state.close()
+
+
+async def _lose_file_x(world, state):
+    """Baseline, then file-x is lost and recorded unavailable through a 410 rescan (D1)."""
+    assert (await world.run(state)).authoritative_complete is True
+    world.files.pop("file-x")
+    world.cursor_errors["shared-a"] = ProviderCursorInvalid("expired")
+    await world.run(state)
+    world.cursor_errors.clear()
+    assert (await world.run(state)).authoritative_complete is True
+    assert DETAIL in (_binding(state, world, "file", "file-x").detail or "")
+
+
+def _file_world(monkeypatch):
+    world = _DriveWorld(file_ids=["file-x", "file-y"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    return world
+
+
+@pytest.mark.asyncio
+async def test_a_restored_file_root_clears_its_detail_after_accepted_ingestion(tmp_path, monkeypatch):
+    world = _file_world(monkeypatch)
+    state = StateStore(str(tmp_path / "restore.sqlite"))
+    await _lose_file_x(world, state)
+
+    world.put("file-x", drive="shared-a")
+    world.logs["shared-a"].append({"fileId": "file-x", "file": dict(world.files["file-x"])})
+    world.pushed.clear()
+    restored = await world.run(state)
+
+    assert "file-x" in world.pushed  # the same stable id, re-ingested
+    binding = _binding(state, world, "file", "file-x")
+    assert binding.status == "bound" and not binding.detail
+    assert not _remote_root(world, "file", "file-x")["detail"]  # published under the fence
+    assert "file-x" in state.membership_ids(world.namespace("shared-a"), GEN)
+    assert "provider_read" not in restored.failure_categories
+    state.close()
+
+
+@pytest.mark.parametrize("case", ["stale_hint", "changed_drive", "failed_access", "failed_extraction"])
+@pytest.mark.asyncio
+async def test_a_hint_without_verified_accepted_ingestion_never_clears_the_detail(tmp_path, monkeypatch, case):
+    world = _file_world(monkeypatch)
+    state = StateStore(str(tmp_path / f"neg-{case}.sqlite"))
+    await _lose_file_x(world, state)
+
+    hint = {"id": "file-x", "name": "file-x", "mimeType": "application/vnd.google-apps.document",
+            "modifiedTime": "2026-09-22T00:00:00Z", "parents": ["shared-a"], "driveId": "shared-a"}
+    if case == "changed_drive":
+        world.put("file-x", drive="shared-b")
+        hint = dict(world.files["file-x"])
+    elif case != "stale_hint":
+        world.put("file-x", drive="shared-a")
+        hint = dict(world.files["file-x"])
+    if case == "failed_access":
+        world.unreadable["file-x"] = _ProviderHttpError(403)
+    if case == "failed_extraction":
+        world.malformed.add("file-x")
+    world.logs["shared-a"].append({"fileId": "file-x", "file": hint})
+    world.pushed.clear()
+    outcome = await world.run(state)
+
+    binding = _binding(state, world, "file", "file-x")
+    remote = _remote_root(world, "file", "file-x")
+    assert "file-x" not in world.pushed
+    if case == "changed_drive":
+        # The existing relocation owner records where it is now; it is never "restored here".
+        assert binding.status == "relocating" and binding.pending_drive_id == "shared-b"
+        assert remote["status"] == "relocating"
+    else:
+        assert DETAIL in (binding.detail or "") and DETAIL in (remote["detail"] or "")
+        assert outcome.authoritative_complete is False
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_superseded_restoration_work_never_clears_the_detail(tmp_path, monkeypatch):
+    # No backoff: were the stale upsert NOT superseded, the next run would read and push it.
+    monkeypatch.setattr("aios_ingest.gdrive_sync._backoff_seconds", lambda *_a, **_k: 0)
+    world = _file_world(monkeypatch)
+    state = StateStore(str(tmp_path / "superseded.sqlite"))
+    await _lose_file_x(world, state)
+
+    # The restoration hint is owed, but its read is deferred this run…
+    world.put("file-x", drive="shared-a")
+    world.logs["shared-a"].append({"fileId": "file-x", "file": dict(world.files["file-x"])})
+    world.unreadable["file-x"] = real_deferral(503)
+    await world.run(state)
+    assert DETAIL in (_binding(state, world, "file", "file-x").detail or "")
+    # …and before it is retried, a newer observation removes the file again.
+    world.unreadable.pop("file-x")
+    world.files.pop("file-x")
+    world.logs["shared-a"].append({"fileId": "file-x", "removed": True})
+    world.pushed.clear()
+    for _ in range(2):
+        await world.run(state)
+
+    upserts = state._db.execute(
+        "SELECT superseded_at FROM pending_work WHERE item_key='file-x' AND action='upsert'",
+    ).fetchall()
+    assert upserts and all(row["superseded_at"] is not None for row in upserts)
+    assert "file-x" not in world.pushed
+    assert DETAIL in (_binding(state, world, "file", "file-x").detail or "")
+    assert DETAIL in (_remote_root(world, "file", "file-x")["detail"] or "")
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_refused_push_of_the_restored_root_never_clears_the_detail(tmp_path, monkeypatch):
+    """Fresh metadata and extraction succeed, but the brain refuses the content: not restored."""
+    from aios_ingest.brain_client import BrainError
+    import aios_ingest.gdrive_sync as sync
+
+    world = _file_world(monkeypatch)
+    state = StateStore(str(tmp_path / "refused.sqlite"))
+    await _lose_file_x(world, state)
+    accepted_push = sync.BrainClient.push
+
+    async def refuse_file_x(self, payload, *, execution):
+        if payload.frontmatter["source_id"] == "file-x":
+            raise BrainError(500, "server_error", "content not accepted")
+        return await accepted_push(self, payload, execution=execution)
+
+    monkeypatch.setattr(sync.BrainClient, "push", refuse_file_x)
+    world.put("file-x", drive="shared-a")
+    world.logs["shared-a"].append({"fileId": "file-x", "file": dict(world.files["file-x"])})
+    world.calls.clear()
+    outcome = await world.run(state)
+
+    assert ("doc", "file-x") in world.calls  # metadata and extraction succeeded
+    assert DETAIL in (_binding(state, world, "file", "file-x").detail or "")
+    assert DETAIL in (_remote_root(world, "file", "file-x")["detail"] or "")
+    assert outcome.authoritative_complete is False
+    state.close()
+
+
+def test_restoration_requires_fresh_metadata_in_the_bound_drive_of_this_stream(tmp_path):
+    """The restoration predicate on its own: same stable id, bound, unavailable, this drive, a live Doc."""
+    from types import SimpleNamespace
+
+    from aios_ingest.gdrive_sync import _restorable_file_root
+    from aios_ingest.state import PendingWork, StreamKey
+
+    state = StateStore(str(tmp_path / "predicate.sqlite"))
+    key = StreamKey("team", "conn", "account", "shared-a")
+    state.begin_generation(key, GEN, start_token="t")
+    state.bind_root("conn", GEN, "file", "file-x", "shared-a")
+    assert state.record_root_unavailable("conn", GEN, "file", "file-x", detail=DETAIL + ": gone")
+    execution = SimpleNamespace(integration_id="conn")
+    work = PendingWork(key.namespace(GEN), GEN, "file-x", "upsert", 1, {}, 0, None, None, None, None)
+    live = {"id": "file-x", "driveId": "shared-a", "mimeType": "application/vnd.google-apps.document"}
+
+    def verdict(**meta):
+        return _restorable_file_root(state, execution, key.namespace(GEN), GEN, work, {**live, **meta})
+
+    assert verdict() == "file-x"
+    assert verdict(driveId="shared-b") is None          # another drive
+    assert verdict(trashed=True) is None                # trashed
+    assert verdict(mimeType="application/pdf") is None  # unsupported content
+    assert verdict(id="file-other") is None             # not the same stable id
+    state.settle_root("conn", GEN, "file", "file-x")
+    assert verdict() is None                            # nothing left to restore
+    state.close()

diff --git a/test/datamechanics/gdrive-admin-grant-policy.datamechanics.test.ts b/test/datamechanics/gdrive-admin-grant-policy.datamechanics.test.ts
new file mode 100644
index 00000000..06e19c06
--- /dev/null
+++ b/test/datamechanics/gdrive-admin-grant-policy.datamechanics.test.ts
@@ -0,0 +1,182 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { setIntegrationSecret, setIntegrationStatus, upsertIntegration } from "@/lib/integrations/manage";
+import { approvedAudienceProject, db, seedTeam, type Seed } from "./helpers";
+
+/**
+ * AIO-1167 R47 F6 — an Admin preview never reports healthy what execution will refuse
+ * (accepted-spec AC-01/156).
+ *
+ * The Admin connection test, Picker verification and manual-root verification refresh with the
+ * stored credential. Each refresh is held to the SAME grant policy as the connector broker, before
+ * any Drive read:
+ *   · a grant broader than the stored ceiling is refused with sanitized reconnect guidance — the
+ *     Drive read never happens and the saved selection is unchanged;
+ *   · a grant inside the ceiling proceeds;
+ *   · when Google omits `scope`, the grant recorded with the credential is judged (the broker's
+ *     fallback) — so a recorded grant outside its own recorded mode refuses here too;
+ *   · an invalid recorded mode, or a legacy credential with no recorded grant, has no ceiling and
+ *     refuses before even the token exchange;
+ *   · a pause during the refresh still refuses (the Admin snapshot is rechecked after the network call).
+ */
+
+const h = vi.hoisted(() => ({ admin: { teamId: "", memberId: "" } }));
+vi.mock("@/lib/auth/guard", () => ({
+  requireTeamAdmin: async () => h.admin.teamId ? { ...h.admin } : null,
+}));
+vi.mock("next/cache", () => ({ revalidatePath: vi.fn() }));
+
+const { testGoogleDriveConnection, saveGoogleDrivePickerSelection, saveIntegration } =
+  await import("@/app/t/[team]/admin/integrations/actions");
+
+const GOOGLE = "https://www.googleapis.com/auth/";
+const FILE = `${GOOGLE}drive.file`;
+const READONLY = `${GOOGLE}drive.readonly`;
+const FULL = `${GOOGLE}drive`;
+const DOC_MIME = "application/vnd.google-apps.document";
+
+interface Credential { grant_mode?: unknown; scopes?: unknown }
+
+async function connection(seed: Seed, name: string, credential: Credential, fileIds = ["kept"]) {
+  await db().from("members").update({ role: "admin" }).eq("id", seed.memberId).eq("team_id", seed.teamId);
+  const audience = await approvedAudienceProject(seed);
+  const auth = { teamId: seed.teamId, memberId: seed.memberId };
+  const row = await upsertIntegration(db(), auth, {
+    type: "gdrive", name, status: "enabled",
+    config: {
+      fileIds, folderIds: [], sharedDriveIds: [], recursive: false, selectionState: "selected",
+      access: "team", authMode: "oauth", authenticatedAccount: "docs@example.com",
+      authenticatedAccountId: "subject:account", scopeSet: [FILE], audienceProjectIds: [audience],
+    },
+  });
+  await setIntegrationSecret(db(), auth, row.id, JSON.stringify({
+    client_id: "client", client_secret: "secret", refresh_token: "refresh",
+    account_subject: "subject:account", ...credential,
+  }));
+  h.admin = { teamId: seed.teamId, memberId: seed.memberId };
+  return { id: row.id, audience };
+}
+
+/** Provider double: the token exchange answers `token`; every Drive read answers a live Google Doc. */
+function provider(token: Record<string, unknown>, onToken?: () => Promise<void>) {
+  const driveReads: string[] = [];
+  const spy = vi.spyOn(globalThis, "fetch").mockImplementation(async (input) => {
+    const url = String(input);
+    if (url.startsWith("https://oauth2.googleapis.com/token")) {
+      await onToken?.();
+      return Response.json({ access_token: "short-lived-secret-token", ...token });
+    }
+    driveReads.push(url);
+    const id = decodeURIComponent(url.split("/files/")[1]!.split("?")[0]!);
+    return Response.json({ id, mimeType: DOC_MIME, trashed: false });
+  });
+  return { spy, driveReads };
+}
+
+async function fileIds(seed: Seed, name: string): Promise<string[]> {
+  const { data } = await db().from("integrations").select("config").eq("team_id", seed.teamId).eq("name", name).single();
+  return (data as { config: { fileIds: string[] } }).config.fileIds;
+}
+
+const FILES_MODE: Credential = { grant_mode: "files", scopes: ["openid", FILE] };
+
+/** The three Admin paths, each run against one connection; returns the action's result. */
+const PATHS = {
+  "connection test": (seed: Seed, name: string) => testGoogleDriveConnection(seed.teamSlug, name),
+  "Picker verification": (seed: Seed, name: string) => saveGoogleDrivePickerSelection(seed.teamSlug, name, ["picked"]),
+  "manual root verification": (seed: Seed, name: string, audience: string) => saveIntegration(seed.teamSlug, {
+    type: "gdrive", name, selection: `fileIds=kept|added, audienceProjectIds=${audience}, authMode=oauth`, secret: "",
+  }),
+} as const;
+
+beforeEach(() => { h.admin = { teamId: "", memberId: "" }; });
+afterEach(() => vi.restoreAllMocks());
+
+describe("R47 F6 — Admin refreshes are held to the broker's grant policy", () => {
+  for (const [label, run] of Object.entries(PATHS)) {
+    it(`${label}: a grant broader than the stored ceiling refuses before any Drive read`, async () => {
+      const seed = await seedTeam();
+      const name = `broad-${label.split(" ")[0]}`;
+      const conn = await connection(seed, name, FILES_MODE);
+      const { spy, driveReads } = provider({ scope: `openid ${FULL}` });
+
+      const result = await run(seed, name, conn.audience);
+
+      expect(result.ok).toBe(false);
+      expect(result.error).toMatch(/reconnect/i);
+      expect(JSON.stringify(result)).not.toContain("short-lived-secret-token");
+      expect(spy).toHaveBeenCalledTimes(1);
+      expect(driveReads).toEqual([]);
+      expect(await fileIds(seed, name)).toEqual(["kept"]);
+    });
+
+    it(`${label}: a grant inside the ceiling proceeds to the Drive read`, async () => {
+      const seed = await seedTeam();
+      const name = `ok-${label.split(" ")[0]}`;
+      const conn = await connection(seed, name, FILES_MODE);
+      const { driveReads } = provider({ scope: `openid ${FILE}` });
+
+      const result = await run(seed, name, conn.audience);
+
+      expect(result).toMatchObject({ ok: true });
+      expect(driveReads.length).toBeGreaterThan(0);
+    });
+  }
+
+  it("an omitted scope judges the recorded grant — accepted inside its mode, refused outside it", async () => {
+    const seed = await seedTeam();
+    await connection(seed, "omitted-ok", FILES_MODE);
+    const ok = provider({});
+    expect(await testGoogleDriveConnection(seed.teamSlug, "omitted-ok")).toMatchObject({ ok: true });
+    expect(ok.driveReads.length).toBe(1);
+    vi.restoreAllMocks();
+
+    // Recorded mode `files` but a recorded grant of drive.readonly: the broker refuses this refresh,
+    // so the preview must as well.
+    await connection(seed, "omitted-broad", { grant_mode: "files", scopes: ["openid", READONLY] });
+    const broad = provider({});
+    const result = await testGoogleDriveConnection(seed.teamSlug, "omitted-broad");
+    expect(result).toMatchObject({ ok: false, error: expect.stringMatching(/reconnect/i) });
+    expect(broad.driveReads).toEqual([]);
+  });
+
+  it("a legacy credential's ceiling is the narrowest mode its recorded grant fits", async () => {
+    const seed = await seedTeam();
+    // No recorded mode; recorded grant drive.readonly → ceiling `folders`, which permits readonly.
+    await connection(seed, "legacy-folders", { scopes: ["openid", READONLY] });
+    const ok = provider({ scope: `openid ${READONLY}` });
+    expect(await testGoogleDriveConnection(seed.teamSlug, "legacy-folders")).toMatchObject({ ok: true });
+    expect(ok.driveReads.length).toBe(1);
+  });
+
+  for (const [label, credential] of [
+    ["an invalid recorded mode", { grant_mode: "everything", scopes: ["openid", FILE] }],
+    ["no recorded mode and no recorded grant", {}],
+    ["no recorded mode and a recorded grant outside every mode", { scopes: ["openid", FULL] }],
+  ] as const) {
+    it(`${label} has no ceiling: refused before the token exchange`, async () => {
+      const seed = await seedTeam();
+      await connection(seed, "no-ceiling", credential);
+      const { spy } = provider({ scope: `openid ${FILE}` });
+      const test = await testGoogleDriveConnection(seed.teamSlug, "no-ceiling");
+      const picker = await saveGoogleDrivePickerSelection(seed.teamSlug, "no-ceiling", ["picked"]);
+      for (const result of [test, picker]) {
+        expect(result).toMatchObject({ ok: false, error: expect.stringMatching(/reconnect/i) });
+      }
+      expect(spy).not.toHaveBeenCalled();
+      expect(await fileIds(seed, "no-ceiling")).toEqual(["kept"]);
+    });
+  }
+
+  it("a pause during the refresh refuses even a grant inside the ceiling", async () => {
+    const seed = await seedTeam();
+    const conn = await connection(seed, "paused-mid-refresh", FILES_MODE);
+    const { driveReads } = provider({ scope: `openid ${FILE}` }, async () => {
+      await setIntegrationStatus(db(), { teamId: seed.teamId, memberId: seed.memberId }, conn.id, "disabled");
+    });
+    const result = await saveGoogleDrivePickerSelection(seed.teamSlug, "paused-mid-refresh", ["picked"]);
+    expect(result.ok).toBe(false);
+    expect(driveReads).toEqual([]);
+    expect(await fileIds(seed, "paused-mid-refresh")).toEqual(["kept"]);
+  });
+});

diff --git a/test/datamechanics/gdrive-complete-snapshot-overlap.datamechanics.test.ts b/test/datamechanics/gdrive-complete-snapshot-overlap.datamechanics.test.ts
new file mode 100644
index 00000000..13d5ee96
--- /dev/null
+++ b/test/datamechanics/gdrive-complete-snapshot-overlap.datamechanics.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+
+import { getPool } from "@/lib/db/pg/pool";
+import { reconcileGdriveItems } from "@/lib/ingest/source-reconcile";
+import { upsertIntegration } from "@/lib/integrations/manage";
+import { recordGdriveItemClaim } from "@/lib/projects/context/gdrive-claims";
+import { approvedAudienceProject, db, driveFixture, seedTeam, type Seed } from "./helpers";
+
+/**
+ * AIO-1167 R49 F6 — the D1 complete-snapshot payload against the REAL claim owner (real Postgres).
+ *
+ * When a bound root is verified lost (D1), the sidecar's next all-stream reconciliation is a
+ * COMPLETE snapshot of connection A that simply omits the lost root's documents. The sidecar tests
+ * prove that payload's shape with a claim double; this proves what the brain does with it:
+ *   · a document A omits but connection B also claims is NOT removed — only A's claim retires, B's
+ *     stays active;
+ *   · a document only A claimed, and A omits, is removed;
+ *   · a document A's snapshot still holds keeps A's claim and its content.
+ */
+
+async function connection(seed: Seed, name: string, projectId: string): Promise<string> {
+  return (await upsertIntegration(db(), { teamId: seed.teamId, memberId: seed.memberId }, {
+    type: "gdrive", name, status: "enabled",
+    config: {
+      fileIds: [], folderIds: ["root"], sharedDriveIds: [], recursive: true,
+      selectionState: "selected", authMode: "service_account", audienceProjectIds: [projectId],
+    },
+  })).id;
+}
+
+async function claimed(seed: Seed, providerId: string, connections: string[], projectId: string): Promise<string> {
+  const item = await driveFixture(seed, {
+    project: "drive-storage", path: `gdrive/${providerId}.md`, body: `body of ${providerId}`,
+    frontmatter: { source: "gdrive", source_id: providerId },
+  }, { unclaimed: true });
+  for (const integrationId of connections) {
+    await recordGdriveItemClaim(db(), {
+      teamId: seed.teamId, integrationId, providerId, itemId: item.id, generation: 1, audienceProjectIds: [projectId],
+    });
+  }
+  return item.id;
+}
+
+async function activeClaims(integrationId: string): Promise<string[]> {
+  const { rows } = await getPool().query<{ provider_id: string }>(
+    "select provider_id from gdrive_item_claims where integration_id=$1 and active order by provider_id", [integrationId]);
+  return rows.map((row) => row.provider_id);
+}
+
+async function exists(itemId: string): Promise<boolean> {
+  return (await db().from("items").select("id").eq("id", itemId).maybeSingle()).data !== null;
+}
+
+describe("D1 complete snapshot with an overlapping connection (R49 F6, real Postgres)", () => {
+  it("retires only connection A's claims; B's claim keeps the shared document", async () => {
+    const seed = await seedTeam();
+    const project = await approvedAudienceProject(seed);
+    const a = await connection(seed, "drive-a", project);
+    const b = await connection(seed, "drive-b", project);
+    const shared = await claimed(seed, "doc-shared", [a, b], project);   // under A's lost root, and claimed by B
+    const onlyA = await claimed(seed, "doc-only-a", [a], project);        // under A's lost root only
+    const kept = await claimed(seed, "doc-kept", [a], project);           // under A's surviving root
+
+    // The D1 payload: A's complete snapshot without the lost root's documents.
+    await reconcileGdriveItems(db(), seed.teamId, {
+      connectionId: a,
+      snapshot: { complete: true, providerIds: ["doc-kept"] },
+      reason: "complete multi-stream gdrive scope generation 1",
+    });
+
+    expect(await activeClaims(a)).toEqual(["doc-kept"]);
+    expect(await activeClaims(b)).toEqual(["doc-shared"]);
+    expect(await exists(shared)).toBe(true);
+    expect(await exists(onlyA)).toBe(false);
+    expect(await exists(kept)).toBe(true);
+  });
+});

diff --git a/test/datamechanics/gdrive-identity-tombstone-email.datamechanics.test.ts b/test/datamechanics/gdrive-identity-tombstone-email.datamechanics.test.ts
