--- /dev/null
+++ b/ingestion/tests/test_exhaustion_is_not_completion.py
@@ -0,0 +1,62 @@
+"""Exhaustion is not completion evidence (AIO-1167 R47 — F4 preserved).
+
+Spec (accepted-spec 166/232/314; adjudication F4). A document whose automatic retries ran out is
+still OWED: its content outcome was never delivered. Through the real coordinator:
+
+  * the run stays partial, with an accurate ``retry_exhausted`` backlog diagnostic;
+  * no complete-snapshot reconciliation is submitted — absence is never inferred around it, so
+    nothing the brain holds is purged — however many runs pass;
+  * once the document is readable again and an Admin re-arms it (Run now / Retry), the connection
+    converges: the document is delivered and the complete snapshot is reconciled.
+
+This pins the conservative gate F4 requires to stay; it is not a change of behaviour.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.gdrive_sync import _MAX_AUTOMATIC_ATTEMPTS, run_gdrive_stream
+from aios_ingest.state import StateStore
+from test_checkpoint_acknowledgment import CONNECTION, DOCS, SETTINGS, world
+
+
+def _complete_snapshots(w) -> list[dict]:
+    return [call for call in w.reconciles if "complete_snapshot_ids" in call]
+
+
+@pytest.mark.asyncio
+async def test_an_exhausted_document_keeps_the_run_partial_and_never_reconciles_absence(tmp_path, monkeypatch):
+    w = world(monkeypatch)
+    w.unreadable = {"b1"}
+    monkeypatch.setattr("aios_ingest.gdrive_sync._backoff_seconds", lambda *_args, **_kwargs: 0)
+    path = str(tmp_path / "exhaust.sqlite")
+
+    last = None
+    for _ in range(_MAX_AUTOMATIC_ATTEMPTS + 2):
+        state = StateStore(path)
+        last = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+        state.close()
+
+    assert last.failure_categories.get("retry_exhausted") == 1
+    assert last.authoritative_complete is False
+    assert last.backlog is not None and last.backlog >= 1
+    assert _complete_snapshots(w) == []  # no absence was ever submitted around the owed document
+    state = StateStore(path)
+    owed = state._db.execute(
+        "SELECT item_key, exhausted_at FROM pending_work WHERE acknowledged_at IS NULL AND superseded_at IS NULL",
+    ).fetchall()
+    assert [(row[0], row[1] is not None) for row in owed] == [("b1", True)]
+    state.close()
+
+    # Repaired, and re-armed by an explicit Admin run: the connection converges.
+    w.unreadable = set()
+    state = StateStore(path)
+    monkeypatch.setitem(CONNECTION.options, "rearm_exhausted", True)
+    repaired = await run_gdrive_stream(SETTINGS, CONNECTION, state)
+    monkeypatch.delitem(CONNECTION.options, "rearm_exhausted")
+    assert "retry_exhausted" not in repaired.failure_categories
+    assert repaired.authoritative_complete is True
+    [snapshot] = _complete_snapshots(w)
+    assert sorted(snapshot["complete_snapshot_ids"]) == sorted(doc for docs in DOCS.values() for doc in docs)
+    state.close()
diff --git a/ingestion/tests/test_pre_stream_scope.py b/ingestion/tests/test_pre_stream_scope.py
new file mode 100644
index 00000000..df1732b3
--- /dev/null
+++ b/ingestion/tests/test_pre_stream_scope.py
@@ -0,0 +1,192 @@
+"""Pre-stream provider answers are scoped to the operation they were read for (AIO-1167 R50 F3).
+
+Spec (Astra R49 adjudication, finding 3). Timing before a stream exists does not make an answer the
+account's. Every deferral below is the REAL provider-call owner's answer (``provider_deferral`` /
+``real_deferral``), driven through the real coordinator over ``_DriveWorld``:
+
+  * a quota answer — 429, or a 403 naming a rate-limit reason — on a root read is the account's hold:
+    no further account call (R47 F5, kept);
+  * a root metadata 503 with a long Retry-After is THAT root's: no account hold, its named minimum is
+    kept, it stays an unresolved obligation, a readable sibling root's stream still runs, and the
+    root is not read again before its minimum — no early retry, no inferred absence;
+  * a start-token 503 or timeout is THAT stream's: it cannot enumerate without its token, while an
+    independent stream runs; a named minimum is kept for the token only;
+  * a relocation re-read answered 503 defers that root alone;
+  * a service-account identity 503 defers the connection's prerequisite without an account hold.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from aios_ingest.config import Connection
+from aios_ingest.scheduler import _poll_job
+from aios_ingest.sources.gdrive import ProviderDeferred
+from aios_ingest.state import StateStore
+from test_gdrive_poll_reporting import (  # noqa: F401 (brain is a fixture)
+    INTEGRATION, SETTINGS, Brain, acquired_execution, brain, drive_identity, row,
+)
+from test_gdrive_upgrade import _DriveWorld, _ProviderHttpError
+from test_root_evidence_r49 import real_deferral
+
+GEN = 9
+LONG = "99999999"
+
+
+def _hold(state, world):
+    return state.connection_hold(world.integration_id, GEN, "account")
+
+
+def _restrictions(state, world):
+    return set(state.document_restrictions(world.integration_id, GEN, "account"))
+
+
+def _file_world(monkeypatch):
+    world = _DriveWorld(file_ids=["file-x", "file-y"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    return world
+
+
+@pytest.mark.parametrize("deferral", [
+    lambda: real_deferral(429, LONG),
+    lambda: real_deferral(403, LONG, reason="userRateLimitExceeded"),
+], ids=["429", "403-rate-limit"])
+@pytest.mark.asyncio
+async def test_a_quota_answer_on_initial_root_binding_is_the_accounts_hold(tmp_path, monkeypatch, deferral):
+    world = _file_world(monkeypatch)
+    world.unreadable["file-x"] = deferral()
+    state = StateStore(str(tmp_path / "quota.sqlite"))
+
+    summary = await world.run(state)
+
+    assert summary.failure_categories.get("rate_limited") == 1
+    assert _hold(state, world) is not None
+    assert ("metadata", "file-y") not in world.calls  # no further account call after the quota answer
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_root_503_with_a_long_retry_after_defers_that_root_alone(tmp_path, monkeypatch):
+    world = _file_world(monkeypatch)
+    world.unreadable["file-x"] = real_deferral(503, LONG)
+    state = StateStore(str(tmp_path / "root-503.sqlite"))
+
+    summary = await world.run(state)
+
+    assert _hold(state, world) is None  # never an account hold
+    assert "rate_limited" not in summary.failure_categories
+    assert summary.failure_categories.get("provider_unavailable") == 1
+    assert "file-x" in _restrictions(state, world)  # the root's own named minimum
+    binding = state.root_obligations(world.integration_id, GEN)[("file", "file-x")]
+    assert binding.status == "unresolved" and "deferred" in (binding.detail or "")
+    assert "file-y" in world.pushed  # the readable sibling root's stream ran
+    assert summary.authoritative_complete is False and world.reconciled == []  # no inferred absence
+    assert any(item["id"] == "file-x" for item in world.progress["document_restrictions"]["items"])
+
+    # No early retry of the deferred root, on this state or a fresh one rebuilt from the brain.
+    world.unreadable.pop("file-x")
+    for rebuilt in (state, StateStore(str(tmp_path / "root-503-fresh.sqlite"))):
+        world.calls.clear()
+        again = await world.run(rebuilt)
+        assert ("metadata", "file-x") not in world.calls
+        assert again.authoritative_complete is False and world.reconciled == []
+    state.close()
+
+
+def _two_stream_world(monkeypatch):
+    world = _DriveWorld(folder_ids=["folder-r", "folder-s"]).install(monkeypatch)
+    world.put("folder-r", drive="shared-a", folder=True)
+    world.put("doc-r", drive="shared-a", parent="folder-r")
+    world.put("folder-s", drive="shared-b", folder=True)
+    world.put("doc-s", drive="shared-b", parent="folder-s")
+    return world
+
+
+@pytest.mark.parametrize("answer", ["503-long", "timeout"])
+@pytest.mark.asyncio
+async def test_a_start_token_deferral_isolates_that_stream(tmp_path, monkeypatch, answer):
+    world = _two_stream_world(monkeypatch)
+    world.token_errors["shared-a"] = (
+        real_deferral(503, LONG) if answer == "503-long"
+        else ProviderDeferred("start token timed out", not_before=None, category="provider_timeout")
+    )
+    state = StateStore(str(tmp_path / f"start-{answer}.sqlite"))
+
+    summary = await world.run(state)
+
+    assert _hold(state, world) is None
+    assert "rate_limited" not in summary.failure_categories
+    assert ("start", "shared-b") in world.calls and "doc-s" in world.pushed  # the independent stream ran
+    assert not any(call[:2] == ("list", "shared-a") for call in world.calls)  # no token, no enumeration
+    assert "doc-r" not in world.pushed
+    assert summary.authoritative_complete is False and world.reconciled == []
+    restricted = "start-token:shared-a" in _restrictions(state, world)
+    assert restricted is (answer == "503-long")  # a named minimum only; a timeout stays attempt-local
+
+    world.token_errors.clear()
+    world.calls.clear()
+    await world.run(state)
+    if answer == "503-long":
+        assert ("start", "shared-a") not in world.calls  # not asked for before its minimum
+    else:
+        assert ("start", "shared-a") in world.calls  # a timeout is simply retried
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_relocation_reread_answered_503_defers_that_root_alone(tmp_path, monkeypatch):
+    world = _DriveWorld(file_ids=["file-x", "file-y"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    state = StateStore(str(tmp_path / "relocation.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+
+    # file-x moves to a Shared Drive whose change log cannot be opened: it is relocating, and once its
+    # destination's stream is recorded without a token, every run re-reads where it is now.
+    world.token_errors["shared-b"] = _ProviderHttpError(403)
+    world.move("file-x", source="shared-a", destination="shared-b")
+    await world.run(state)  # the change page reads file-x elsewhere: relocating
+    binding = state.root_obligations(world.integration_id, GEN)[("file", "file-x")]
+    assert binding.status == "relocating"
+    await world.run(state)  # the destination's stream is recorded, its start token unavailable
+
+    world.unreadable["file-x"] = real_deferral(503, LONG)
+    world.calls.clear()
+    summary = await world.run(state)
+
+    assert _hold(state, world) is None
+    assert "file-x" in _restrictions(state, world)
+    assert summary.failure_categories.get("provider_unavailable") == 1
+    assert any(call[:2] == ("changes", "shared-a") for call in world.calls)  # shared-a still ran
+    assert state.root_obligations(world.integration_id, GEN)[("file", "file-x")].status == "relocating"
+
+    world.calls.clear()
+    await world.run(state)
+    assert ("metadata", "file-x") not in world.calls  # not re-read before its minimum
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_a_service_account_identity_503_defers_the_prerequisite_without_an_account_hold(
+    tmp_path, brain, monkeypatch,
+):
+    state = StateStore(str(tmp_path / "identity.sqlite"))
+    b = brain(Brain(
+        rows=[row(auth_mode="service_account")],
+        acquire=acquired_execution("service_account", serviceAccountStatus="pending"),
+    ))
+    monkeypatch.setattr("aios_ingest.gdrive_sync.GoogleDriveSource", drive_identity(real_deferral(503, LONG)))
+    connection = Connection("local-docs", "gdrive", options={"service_account_key_path": "/local/key.json"})
+
+    await _poll_job(SETTINGS, connection, state)
+
+    [report] = b.reports()
+    assert report["integrationId"] == INTEGRATION
+    assert report["error"] == "provider_unavailable"
+    assert report["failed"] == 0 and report["skipped"] == 1
+    assert state._db.execute("SELECT count(*) FROM connection_holds").fetchone()[0] == 0
+    assert [r[0] for r in state._db.execute("SELECT provider_id FROM document_restrictions")] == [
+        "prerequisite:service-account-identity",
+    ]
+    state.close()
diff --git a/ingestion/tests/test_restricted_root_recovery.py b/ingestion/tests/test_restricted_root_recovery.py
new file mode 100644
index 00000000..bb7a42dd
--- /dev/null
+++ b/ingestion/tests/test_restricted_root_recovery.py
@@ -0,0 +1,260 @@
+"""A restricted selected root does not freeze recovery (AIO-1167 R50 F4), and its diagnostics are
+truthful (R50 F7).
+
+Spec (Astra R49 adjudication, findings 4 and 7). Through the real coordinator over ``_DriveWorld``:
+
+F4 — after a 410 controlled rescan, and separately after fresh-state recovery, a selected file root
+under a standing provider minimum is not read; it becomes a durable DEFERRED obligation. Its page
+commits carrying only the membership the published snapshot already proved (none on fresh state:
+nothing is invented), so the stream publishes and an independent document's LATER edit — same drive
+or another drive — still flows, while the run stays partial and no complete snapshot infers absence.
+Once the minimum passes, the next run lists the root again (restoration), and a removal that arrived
+while it was restricted is applied only through that verified path; stale upsert work never pushes
+removed content.
+
+F7 — a root verified unavailable is counted once per run however many phases observe it, and a newly
+learned restriction that no checkpoint got acknowledged is reported ``document_restriction_unpublished``.
+"""
+
+from __future__ import annotations
+
+from datetime import timedelta
+
+import pytest
+
+from aios_ingest.brain_client import BrainError
+from aios_ingest.engine import IngestSummary
+from aios_ingest.gdrive_sync import _merge_summary, _note_root_unavailable
+from aios_ingest.sources.gdrive import ProviderCursorInvalid
+from aios_ingest.state import StateStore
+from test_bound_root_loss import _delete_folder_r, _folder_world
+from test_document_restrictions import (  # noqa: F401 (clock is a fixture)
+    LONG, _restrict_after_seven_failures, clock,
+)
+from test_document_restrictions import _world as _restriction_world
+from test_gdrive_upgrade import _WORLD_INTEGRATION, _DriveWorld
+
+GEN = 9
+DEFERRED = "selected root deferred"
+
+
+def _world(monkeypatch):
+    world = _DriveWorld(file_ids=["file-x", "file-y"], folder_ids=["folder-z"]).install(monkeypatch)
+    world.put("file-x", drive="shared-a")
+    world.put("file-y", drive="shared-a")
+    world.put("folder-z", drive="shared-b", folder=True)
+    world.put("doc-z", drive="shared-b", parent="folder-z")
+    return world
+
+
+def _restrict(world, provider_id: str, not_before: str) -> None:
+    """A provider minimum the brain already acknowledged for this account (adopted on the next run)."""
+    world.progress["document_restrictions"] = {
+        "generation": GEN, "credential": "account",
+        "items": [{"id": provider_id, "not_before": not_before,
+                   "category": "provider_unavailable", "unrepresentable": False}],
+    }
+
+
+def _edit(world, provider_id: str, drive: str, when: str) -> None:
+    world.files[provider_id]["modifiedTime"] = when
+    world.logs.setdefault(drive, []).append({"fileId": provider_id, "file": dict(world.files[provider_id])})
+
+
+def _binding(state, kind, root_id):
+    return state.root_obligations(_WORLD_INTEGRATION, GEN).get((kind, root_id))
+
+
+async def _rescan_with_file_x_restricted(world, state, clock, minutes=60 * 24 * 30):
+    """Baseline, then file-x is restricted and a 410 forces a controlled rescan of shared-a."""
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+    _restrict(world, "file-x", (clock.at + timedelta(minutes=minutes)).isoformat())
+    world.cursor_errors["shared-a"] = ProviderCursorInvalid("expired")
+    await world.run(state)
+    world.cursor_errors.clear()
+    world.calls.clear()
+    await world.run(state)  # the rescan
+    return reconciled
+
+
+@pytest.mark.asyncio
+async def test_after_a_410_rescan_a_restricted_file_root_is_deferred_and_independent_edits_flow(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "rescan.sqlite"))
+    namespace = world.namespace("shared-a")
+    reconciled = await _rescan_with_file_x_restricted(world, state, clock)
+
+    assert ("metadata", "file-x") not in world.calls and ("metadata", "file-y") in world.calls
+    progress = state.get_progress(namespace)
+    assert progress.building_snapshot is None and progress.listing_complete is True  # published
+    binding = _binding(state, "file", "file-x")
+    assert binding.status == "uncertain" and (binding.detail or "").startswith(DEFERRED)
+    assert "file-x" in state.membership_ids(namespace, GEN)  # retained, not invented
+
+    # Edits AFTER the baseline page committed, same drive and another drive: both flow.
+    world.pushed.clear()
+    world.calls.clear()
+    _edit(world, "file-y", "shared-a", "2026-10-01T00:00:00Z")
+    _edit(world, "doc-z", "shared-b", "2026-10-01T00:00:00Z")
+    outcome = await world.run(state)
+    assert "file-y" in world.pushed and "doc-z" in world.pushed
+    assert ("metadata", "file-x") not in world.calls and "file-x" not in world.pushed
+    assert outcome.authoritative_complete is False
+    assert world.reconciled == reconciled and "file-x" not in world.removed  # no inferred absence
+    state.close()
+
+
+@pytest.mark.asyncio
+async def test_after_fresh_state_recovery_a_restricted_file_root_invents_no_membership(
+    tmp_path, monkeypatch, clock,
+):
+    world = _world(monkeypatch)
+    state = StateStore(str(tmp_path / "first.sqlite"))
+    assert (await world.run(state)).authoritative_complete is True
+    reconciled = list(world.reconciled)
+    state.close()
+    _restrict(world, "file-x", (clock.at + timedelta(days=30)).isoformat())
+
+    fresh = StateStore(str(tmp_path / "fresh.sqlite"))
+    namespace = world.namespace("shared-a")
+    world.calls.clear()
+    for _ in range(2):
+        await world.run(fresh)
+    assert ("metadata", "file-x") not in world.calls
+    assert "file-x" not in state_membership(fresh, namespace)  # fresh state: nothing invented
+    assert "file-y" in state_membership(fresh, namespace)
+    binding = _binding(fresh, "file", "file-x")
+    assert binding.status == "uncertain" and (binding.detail or "").startswith(DEFERRED)
+
+    world.pushed.clear()
+    _edit(world, "file-y", "shared-a", "2026-10-02T00:00:00Z")
