# Keep the build context small and secret-free.
# node_modules matters twice over: it's huge, AND in a git worktree it's a symlink to the
# primary checkout (see next.config.ts) which Docker cannot follow out of the context.
node_modules
.next
.git
.github

# Never bake secrets into an image layer. .env.example is documentation and stays.
.env
.env.*
!.env.example
.aios-demo-key

# Local/dev noise
.claude
.agents
.conductor
# Agent scratch/handoff trees. These hold whole worktree copies and review artefacts; baking one
# into a runner image would bloat it and could carry local material into a published layer.
.context
coverage
*.log
.DS_Store
ingestion/.venv
graphiti/.env
